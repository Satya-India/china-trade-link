---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SourcingListDrawer from '../components/SourcingListDrawer.astro';
import QuickSearchModal from '../components/QuickSearchModal.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import PayPalCheckoutModal from '../components/PayPalCheckoutModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: string;
  activePage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = "Sino Trade Link | Verified China Wholesale Markets Directory & Direct Factory Intelligence",
  description = "Access 27,706+ verified offline suppliers from Yiwu Futian Wholesale Market with 99.9% unmasked direct mobile numbers, exact booth coordinates, and on-demand inspection.",
  keywords = "Yiwu wholesale market directory, Yiwu Futian market stalls, China direct factory contacts, Yiwu booth numbers, Yiwu sourcing agent alternative, China wholesale suppliers WeChat phone numbers",
  canonicalUrl,
  ogType = "website",
  activePage = 'home',
  jsonLd
} = Astro.props;

const resolvedCanonical = canonicalUrl || new URL(Astro.url.pathname, 'https://sinotradelink.com').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="msvalidate.01" content="D323FDCD8670F30E79A66452C4D9A7FA" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="prefetch" href="/search-index.json" as="fetch" crossorigin="anonymous" />

    <!-- OpenGraph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="Sino Trade Link" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <slot name="head" />

    <!-- Fonts: Inter / System Font with Chinese Fallbacks -->
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 selection:bg-blue-600 selection:text-white">
    <Navbar activePage={activePage} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <SourcingListDrawer />
    <QuickSearchModal />
    <WhatsAppWidget />
    <PayPalCheckoutModal />
  </body>
</html>
