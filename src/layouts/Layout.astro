---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SourcingListDrawer from '../components/SourcingListDrawer.astro';
import QuickSearchModal from '../components/QuickSearchModal.astro';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';
import SampleAuditReportModal from '../components/SampleAuditReportModal.astro';
import { getLocaleConfig, SUPPORTED_LOCALES } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogType?: string;
  activePage?: string;
  locale?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = "Sino Trade Link | China-Wide Direct Factory Sourcing & 27,706+ Verified Market Suppliers",
  description = "Source directly from anywhere in China (Yiwu, Shenzhen, Guangzhou, Ningbo & beyond) — paste any Alibaba.com product link or browse 27,706+ verified stalls free for direct factory quotes.",
  keywords = "Alibaba dropshipping agent China, China-wide factory sourcing agent, Yiwu wholesale market directory, China direct factory quote, Shenzhen Guangzhou Ningbo sourcing",
  canonicalUrl,
  ogType = "website",
  activePage = 'home',
  locale,
  jsonLd
} = Astro.props;

const currentLocale = getLocaleConfig(locale);
const rawCleanPath = Astro.url.pathname.replace(/^\/(es|pt|fr|de|ar|ru|it)(\/|$)/, '/') || '/';
const cleanPath = rawCleanPath.length > 1 && rawCleanPath.endsWith('/') ? rawCleanPath.slice(0, -1) : rawCleanPath;

const supportsLocaleAlternates =
  cleanPath === '/' ||
  cleanPath === '/countries' ||
  cleanPath === '/directory' ||
  cleanPath === '/dropshipping' ||
  cleanPath === '/concierge' ||
  cleanPath.startsWith('/country/');

function buildAlternateUrl(locCode: string): string {
  if (locCode === 'en') {
    return `https://sinotradelink.com${cleanPath}`;
  }
  return cleanPath === '/'
    ? `https://sinotradelink.com/${locCode}`
    : `https://sinotradelink.com/${locCode}${cleanPath}`;
}

const resolvedCanonical = canonicalUrl || new URL(Astro.url.pathname, 'https://sinotradelink.com').toString();
---

<!doctype html>
<html lang={currentLocale.hreflang} dir={currentLocale.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="msvalidate.01" content="D323FDCD8670F30E79A66452C4D9A7FA" />
    <link rel="canonical" href={resolvedCanonical} />
    {supportsLocaleAlternates && SUPPORTED_LOCALES.map((loc) => (
      <link rel="alternate" hreflang={loc.hreflang} href={buildAlternateUrl(loc.code)} />
    ))}
    {supportsLocaleAlternates && (
      <link rel="alternate" hreflang="x-default" href={`https://sinotradelink.com${cleanPath}`} />
    )}
    <link rel="prefetch" href="/search-index.json" as="fetch" crossorigin="anonymous" />

    <!-- OpenGraph Metadata -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="Sino Trade Link" />
    <meta property="og:locale" content={currentLocale.hreflang.replace('-', '_')} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <slot name="head" />

    <!-- Fonts: Inter / System Font with Chinese Fallbacks -->
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 selection:bg-blue-600 selection:text-white">
    <Navbar activePage={activePage} locale={currentLocale.code} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <SourcingListDrawer />
    <QuickSearchModal />
    <WhatsAppWidget />
    <SampleAuditReportModal />
  </body>
</html>
