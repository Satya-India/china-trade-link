---
// WhatsApp Floating Concierge Widget
interface Props {
  phoneNumber?: string;
}

const {
  phoneNumber = "8618058988888" // Replaceable via config/prop
} = Astro.props;
---

<div id="whatsapp-widget-container" class="fixed bottom-6 right-6 z-40 font-sans">
  
  <!-- Popover Chat Card -->
  <div
    id="whatsapp-popover"
    class="hidden mb-3 w-[340px] max-w-[calc(100vw-2rem)] bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden transition-all duration-200 transform origin-bottom-right"
  >
    <!-- Header -->
    <div class="bg-[#075E54] text-white p-4 relative">
      <div class="flex items-center space-x-3">
        <div class="relative">
          <div class="w-10 h-10 rounded-full bg-emerald-800 flex items-center justify-center font-bold text-white text-sm shadow border border-emerald-600/50">
            STL
          </div>
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-400 border-2 border-[#075E54] rounded-full"></span>
        </div>
        <div>
          <h3 class="text-sm font-bold tracking-tight">Yiwu Sourcing Liaison</h3>
          <p class="text-[11px] text-emerald-100 flex items-center space-x-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Online · Fast Response</span>
          </p>
        </div>
      </div>
      <button
        id="close-wa-popover"
        class="absolute top-3.5 right-3.5 text-emerald-200 hover:text-white p-1 rounded-lg text-lg leading-none cursor-pointer"
        aria-label="Close chat"
      >
        &times;
      </button>
    </div>

    <!-- Chat Body -->
    <div class="p-4 bg-slate-50 space-y-3 text-xs">
      
      <!-- Received Message Bubble -->
      <div class="bg-white p-3 rounded-2xl rounded-tl-sm border border-slate-200 shadow-sm text-slate-800 leading-relaxed space-y-1.5">
        <p class="font-medium text-slate-900">
          Hello! 👋 Sourcing from China's wholesale markets?
        </p>
        <p class="text-slate-600 text-[11px]">
          Our on-site Yiwu liaison team verifies physical booths, coordinates FOB price lists, and conducts stall audits directly at Futian Market.
        </p>
      </div>

      <!-- Quick Topic Chips -->
      <div class="space-y-1.5">
        <span class="text-[10px] uppercase font-bold text-slate-600 tracking-wider">Select inquiry topic:</span>
        <div class="flex flex-wrap gap-1.5">
          <button
            type="button"
            class="wa-topic-chip px-2.5 py-1 bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 rounded-lg border border-slate-200 text-[11px] font-medium transition cursor-pointer"
            data-msg="Hi, I am looking to find verified direct factories in Yiwu for my product line."
          >
            🏭 Find Direct Factory
          </button>
          <button
            type="button"
            class="wa-topic-chip px-2.5 py-1 bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 rounded-lg border border-slate-200 text-[11px] font-medium transition cursor-pointer"
            data-msg="Hi, I need verification and wholesale FOB pricing for a specific booth at Futian Market."
          >
            🔍 Verify Stall & Price
          </button>
          <button
            type="button"
            class="wa-topic-chip px-2.5 py-1 bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 rounded-lg border border-slate-200 text-[11px] font-medium transition cursor-pointer"
            data-msg="Hi, I am planning a sourcing trip to Yiwu and need an on-site liaison/translator."
          >
            🗺️ Book On-Site Liaison
          </button>
        </div>
      </div>

      <!-- Pre-filled message box -->
      <div>
        <textarea
          id="wa-custom-msg"
          rows="2"
          placeholder="Type your message or inquiry..."
          class="w-full p-2.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 resize-none transition"
        >Hello SinoTradeLink, I am sourcing wholesale products from Yiwu Futian Market.</textarea>
      </div>

      <!-- Action Button -->
      <button
        id="send-wa-btn"
        class="w-full py-2.5 px-4 bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-bold rounded-xl text-xs flex items-center justify-center space-x-2 shadow-lg shadow-emerald-500/20 transition cursor-pointer"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.586 1.761.884 2.791.884 3.182 0 5.768-2.586 5.768-5.766 0-3.18-2.586-5.77-5.768-5.77zm3.393 8.163c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.008-.472-1.68-.696-2.757-2.42-2.841-2.531-.084-.112-.68-1.026-.68-1.956 0-.93.486-1.385.66-1.575.174-.189.38-.236.507-.236.126 0 .253.001.364.007.119.006.277-.045.434.33.162.388.555 1.353.604 1.452.049.1.082.216.016.347-.066.13-.1.21-.197.324-.099.113-.208.253-.297.34-.1.098-.204.205-.088.404.116.199.516.852 1.108 1.38.763.68 1.408.89 1.609.99.201.1.319.083.437-.052.119-.136.508-.59.644-.793.136-.203.273-.169.458-.101.186.068 1.182.557 1.385.658.203.102.338.152.388.237.05.085.05.49-.094.895z" />
          <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.528 3.659 1.446 5.174L2 22l4.981-1.306C8.423 21.545 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2C12 2zm0 18.062c-1.644 0-3.167-.487-4.444-1.325l-.318-.21-2.964.777.791-2.89-.229-.364C3.935 14.717 3.438 13.398 3.438 12c0-4.721 3.841-8.562 8.562-8.562 4.721 0 8.562 3.841 8.562 8.562 0 4.721-3.841 8.062-8.562 8.062z" />
        </svg>
        <span>Open WhatsApp Chat</span>
      </button>

      <p class="text-[10px] text-center text-slate-500">
        Direct link to official sourcing desk · Instant connection
      </p>

    </div>
  </div>

  <!-- Floating Launcher Button -->
  <div class="flex items-center space-x-2.5 justify-end">
    
    <!-- Collapsible Greeting Pill -->
    <button
      id="wa-greeting-pill"
      class="hidden sm:inline-flex items-center space-x-1.5 px-3 py-1.5 bg-white text-slate-800 text-xs font-semibold rounded-full shadow-lg border border-slate-200 hover:border-emerald-400 transition cursor-pointer"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Chat with Yiwu Ground Team</span>
    </button>

    <!-- Main WhatsApp Circle Button -->
    <button
      id="wa-trigger-btn"
      class="w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-white flex items-center justify-center shadow-xl shadow-emerald-600/30 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer relative"
      aria-label="Open WhatsApp live chat"
    >
      <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-red-500 border-2 border-white rounded-full"></span>
      
      <!-- WhatsApp SVG Icon -->
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
      </svg>
    </button>

  </div>

</div>

<script is:inline define:vars={{ phoneNumber }}>
  const triggerBtn = document.getElementById('wa-trigger-btn');
  const greetingPill = document.getElementById('wa-greeting-pill');
  const popover = document.getElementById('whatsapp-popover');
  const closeBtn = document.getElementById('close-wa-popover');
  const sendBtn = document.getElementById('send-wa-btn');
  const customMsg = document.getElementById('wa-custom-msg');
  const chips = document.querySelectorAll('.wa-topic-chip');

  // Detect context if on a supplier profile
  const path = window.location.pathname;
  if (path.includes('/supplier/')) {
    const boothEl = document.querySelector('[data-booth]');
    const supplierEl = document.querySelector('h1');
    const boothNo = boothEl ? boothEl.innerText.trim() : '';
    const supplierName = supplierEl ? supplierEl.innerText.trim() : '';
    
    if (customMsg) {
      customMsg.value = `Hi SinoTradeLink, I am viewing stall "${supplierName}" ${boothNo ? `(Booth: ${boothNo})` : ''} on your directory and would like quotation/contact assistance.`;
    }
  }

  function togglePopover() {
    const isHidden = popover.classList.contains('hidden');
    if (isHidden) {
      popover.classList.remove('hidden');
    } else {
      popover.classList.add('hidden');
    }
  }

  if (triggerBtn) triggerBtn.addEventListener('click', togglePopover);
  if (greetingPill) greetingPill.addEventListener('click', togglePopover);
  if (closeBtn) closeBtn.addEventListener('click', () => popover.classList.add('hidden'));

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const msg = chip.getAttribute('data-msg');
      if (msg && customMsg) {
        customMsg.value = msg;
      }
      chips.forEach(c => c.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-700'));
      chip.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-700');
    });
  });

  if (sendBtn) {
    sendBtn.addEventListener('click', () => {
      const text = customMsg ? customMsg.value.trim() : 'Hello SinoTradeLink';
      const cleanNumber = String(phoneNumber).replace(/[^\d]/g, '');
      const url = `https://wa.me/${cleanNumber}?text=${encodeURIComponent(text)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }
</script>
