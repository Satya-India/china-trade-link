---
// PayPal Client ID from Live SinoPayments App
const PAYPAL_CLIENT_ID = "BAA-U7WpNQZudJZbn-39Kd2E2Alw7toZtsb_8pRNtFgIpkZXRT2yUdps5-Eyk-N7a2cz0LF0E0R4SOYGgc";
---

<!-- Global PayPal Smart Checkout Modal -->
<dialog id="paypal-checkout-modal" class="fixed inset-0 m-auto z-50 p-0 rounded-3xl bg-transparent backdrop:bg-slate-950/75 backdrop:backdrop-blur-sm max-w-md w-full shadow-2xl open:animate-in open:fade-in open:zoom-in-95">
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-2xl max-h-[92vh] flex flex-col">
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 px-6 py-4 text-white relative shrink-0 border-b border-slate-800">
      <button 
        type="button" 
        id="paypal-modal-close"
        class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-full hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="flex items-center gap-2 text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span>Instant Encrypted Checkout</span>
      </div>
      <h3 id="checkout-item-title" class="text-base font-black text-white leading-tight">
        Wholesale Category Pack
      </h3>
      <p id="checkout-item-subtitle" class="text-xs text-slate-400 mt-0.5">
        Instant Verified Excel & CSV Spreadsheet
      </p>
    </div>

    <!-- Modal Content -->
    <div class="p-6 space-y-5 overflow-y-auto">

      <!-- Price & Item Summary Box -->
      <div id="checkout-summary-box" class="bg-slate-50 border border-slate-200 rounded-2xl p-4 flex items-center justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Total Due:</span>
          <span id="checkout-price-display" class="text-2xl font-black text-slate-900">$29.00 USD</span>
        </div>
        <div class="text-right">
          <span class="inline-flex items-center gap-1 text-[11px] font-bold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full border border-emerald-200">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Instant Fulfillment
          </span>
          <span class="text-[10px] text-slate-400 block mt-1">One-time payment</span>
        </div>
      </div>

      <!-- STATE A: PAYPAL BUTTONS CONTAINER -->
      <div id="checkout-payment-state" class="space-y-4">
        <!-- PayPal Loading Indicator -->
        <div id="paypal-loading" class="py-8 text-center text-slate-400 text-xs flex flex-col items-center justify-center gap-2">
          <span class="w-6 h-6 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
          <span>Connecting to PayPal Secure Gateway...</span>
        </div>

        <!-- Render Target for PayPal Smart Buttons -->
        <div id="paypal-button-container" class="min-h-[140px] relative z-0"></div>

        <!-- Security Trust Marks -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            PayPal Buyer Protection
          </span>
          <span>Cards & Balance Accepted</span>
        </div>
      </div>

      <!-- STATE B: SUCCESS & INSTANT DOWNLOAD STATE -->
      <div id="checkout-success-state" class="hidden space-y-4 text-center py-2">
        <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <div>
          <h4 class="text-lg font-black text-slate-900">Payment Confirmed!</h4>
          <p class="text-xs text-slate-600 mt-1">
            Thank you, <strong id="success-payer-name">Customer</strong>! Your transaction was completed successfully.
          </p>
          <p class="text-[10px] text-slate-400 font-mono mt-0.5" id="success-order-id">
            Order ID: 5X8921479812
          </p>
        </div>

        <!-- Download Action Button -->
        <div id="success-download-container" class="pt-2">
          <a 
            id="success-download-btn"
            href="#" 
            download
            class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Verified Excel Spreadsheet (CSV)</span>
          </a>
          <span class="block text-[10px] text-slate-400 mt-1.5">
            A confirmation has also been recorded in our system.
          </span>
        </div>

        <!-- Concierge specific note -->
        <div id="success-concierge-note" class="hidden p-3 rounded-xl bg-blue-50 border border-blue-200 text-xs text-blue-900 text-left">
          <strong>Next Steps:</strong> Our bilingual ground staff in Yiwu has been notified via Telegram. We will message your email and WhatsApp to coordinate stall coordinates and inspection specs.
        </div>
      </div>

    </div>
  </div>
</dialog>

<script define:vars={{ PAYPAL_CLIENT_ID }}>
  let isSdkLoaded = false;
  let activeItem = {
    id: 'category-pack',
    title: 'Category Wholesaler Pack',
    price: 29.00,
    type: 'pack'
  };

  const modal = document.getElementById('paypal-checkout-modal');
  const closeBtn = document.getElementById('paypal-modal-close');
  const itemTitleEl = document.getElementById('checkout-item-title');
  const itemSubtitleEl = document.getElementById('checkout-item-subtitle');
  const priceDisplayEl = document.getElementById('checkout-price-display');
  const paymentState = document.getElementById('checkout-payment-state');
  const successState = document.getElementById('checkout-success-state');
  const loadingEl = document.getElementById('paypal-loading');
  const buttonsContainer = document.getElementById('paypal-button-container');

  const successPayerName = document.getElementById('success-payer-name');
  const successOrderId = document.getElementById('success-order-id');
  const successDownloadBtn = document.getElementById('success-download-btn');
  const successDownloadContainer = document.getElementById('success-download-container');
  const successConciergeNote = document.getElementById('success-concierge-note');

  function loadPayPalSdk(callback) {
    if (isSdkLoaded && window.paypal) {
      callback();
      return;
    }

    const script = document.createElement('script');
    script.src = `https://www.paypal.com/sdk/js?client-id=${PAYPAL_CLIENT_ID}&currency=USD&intent=capture`;
    script.async = true;
    script.onload = () => {
      isSdkLoaded = true;
      callback();
    };
    script.onerror = () => {
      if (loadingEl) {
        loadingEl.innerHTML = `<span class="text-rose-500 font-bold">Failed to load PayPal SDK. Please check connection.</span>`;
      }
    };
    document.head.appendChild(script);
  }

  function renderButtons() {
    if (!window.paypal || !buttonsContainer) return;

    buttonsContainer.innerHTML = '';
    if (loadingEl) loadingEl.style.display = 'none';

    window.paypal.Buttons({
      style: {
        layout: 'vertical',
        color: 'gold',
        shape: 'rect',
        label: 'pay',
        height: 42
      },

      createOrder: (data, actions) => {
        return actions.order.create({
          purchase_units: [{
            description: `${activeItem.title} - SinoTradeLink`,
            amount: {
              value: activeItem.price.toFixed(2),
              currency_code: 'USD'
            }
          }]
        });
      },

      onApprove: async (data, actions) => {
        if (loadingEl) {
          loadingEl.style.display = 'flex';
          loadingEl.innerHTML = `
            <span class="w-6 h-6 rounded-full border-2 border-emerald-600 border-t-transparent animate-spin"></span>
            <span>Confirming payment & generating digital delivery...</span>
          `;
        }

        try {
          const details = await actions.order.capture();

          // Post to backend API
          const response = await fetch('/api/payment/complete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              orderId: data.orderID,
              payer: details.payer,
              amount: activeItem.price.toFixed(2),
              currency: 'USD',
              itemId: activeItem.id,
              itemTitle: activeItem.title
            })
          });

          const resData = await response.json();

          // Render Success Screen
          if (paymentState) paymentState.classList.add('hidden');
          if (successState) successState.classList.remove('hidden');

          const pName = details.payer?.name ? `${details.payer.name.given_name || ''} ${details.payer.name.surname || ''}`.trim() : 'Customer';
          if (successPayerName) successPayerName.textContent = pName;
          if (successOrderId) successOrderId.textContent = `PayPal Ref: ${data.orderID}`;

          if (activeItem.type === 'pack') {
            if (successDownloadBtn) {
              const url = resData.downloadUrl || `/api/download-pack?order_id=${encodeURIComponent(resData.orderId)}&item_id=${encodeURIComponent(activeItem.id)}`;
              successDownloadBtn.href = url;
            }
            if (successDownloadContainer) successDownloadContainer.classList.remove('hidden');
            if (successConciergeNote) successConciergeNote.classList.add('hidden');
          } else {
            // Concierge booking
            if (successDownloadContainer) successDownloadContainer.classList.add('hidden');
            if (successConciergeNote) successConciergeNote.classList.remove('hidden');
          }

        } catch (err) {
          console.error('[Payment Capture Error]:', err);
          alert('Payment succeeded with PayPal, but delivery failed to synchronize. Please contact support via WhatsApp with your order ID.');
        }
      },

      onError: (err) => {
        console.error('[PayPal Button Error]:', err);
      }
    }).render('#paypal-button-container');
  }

  // Global trigger function to open PayPal Modal
  window.openPayPalCheckout = function(options) {
    if (!modal) return;

    activeItem = {
      id: options.id || 'pack',
      title: options.title || 'Category Pack',
      price: parseFloat(options.price) || 29.00,
      type: options.type || 'pack'
    };

    if (itemTitleEl) itemTitleEl.textContent = activeItem.title;
    if (priceDisplayEl) priceDisplayEl.textContent = `$${activeItem.price.toFixed(2)} USD`;
    if (itemSubtitleEl) {
      itemSubtitleEl.textContent = activeItem.type === 'concierge' 
        ? 'On-Demand Bilingual Market Inspection Service'
        : 'Instant Verified Excel & CSV Spreadsheet';
    }

    // Reset view states
    if (paymentState) paymentState.classList.remove('hidden');
    if (successState) successState.classList.add('hidden');
    if (loadingEl) {
      loadingEl.style.display = 'flex';
      loadingEl.innerHTML = `
        <span class="w-6 h-6 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
        <span>Connecting to PayPal Secure Gateway...</span>
      `;
    }

    modal.showModal();

    loadPayPalSdk(() => {
      renderButtons();
    });
  };

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  modal?.addEventListener('click', (e) => {
    const rect = modal.getBoundingClientRect();
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      modal.close();
    }
  });

  // Attach to all elements with data-paypal-trigger
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest('.paypal-trigger-btn') as HTMLElement | null;
    if (trigger) {
      e.preventDefault();
      const id = trigger.getAttribute('data-item-id') || 'pack';
      const title = trigger.getAttribute('data-item-title') || 'Category Pack';
      const price = parseFloat(trigger.getAttribute('data-item-price') || '29');
      const type = trigger.getAttribute('data-item-type') || 'pack';

      window.openPayPalCheckout({ id, title, price, type });
    }
  });
</script>
