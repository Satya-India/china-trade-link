---
// PayPal Client ID from Live SinoPayments App
const PAYPAL_CLIENT_ID = "BAA-U7WpNQZudJZbn-39Kd2E2Alw7toZtsb_8pRNtFgIpkZXRT2yUdps5-Eyk-N7a2cz0LF0E0R4SOYGgc";
---

<!-- Global PayPal Smart Checkout Modal Dialog -->
<dialog id="paypal-checkout-modal" class="fixed inset-0 m-auto z-[9999] p-4 sm:p-0 rounded-3xl bg-transparent max-w-md w-full shadow-2xl">
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-2xl max-h-[92vh] flex flex-col w-full">
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 px-6 py-4 text-white relative shrink-0 border-b border-slate-800">
      <button 
        type="button" 
        id="paypal-modal-close"
        class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-full hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="flex items-center gap-2 text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        <span>Instant Encrypted Checkout</span>
      </div>
      <h3 id="checkout-item-title" class="text-base font-black text-white leading-tight">
        Wholesale Category Pack
      </h3>
      <p id="checkout-item-subtitle" class="text-xs text-slate-400 mt-0.5">
        Instant Verified Excel & CSV Spreadsheet
      </p>
    </div>

    <!-- Modal Content -->
    <div class="p-6 space-y-5 overflow-y-auto">

      <!-- Price & Item Summary Box -->
      <div id="checkout-summary-box" class="bg-slate-50 border border-slate-200 rounded-2xl p-4 flex items-center justify-between">
        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Total Due:</span>
          <span id="checkout-price-display" class="text-2xl font-black text-slate-900">$29.00 USD</span>
        </div>
        <div class="text-right">
          <span class="inline-flex items-center gap-1 text-[11px] font-bold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full border border-emerald-200">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Instant Fulfillment
          </span>
          <span class="text-[10px] text-slate-400 block mt-1">One-time payment</span>
        </div>
      </div>

      <!-- STATE A: PAYPAL BUTTONS CONTAINER -->
      <div id="checkout-payment-state" class="space-y-4">
        <!-- PayPal Loading Indicator -->
        <div id="paypal-loading" class="py-6 text-center text-slate-400 text-xs flex flex-col items-center justify-center gap-2">
          <span class="w-6 h-6 rounded-full border-2 border-blue-600 border-t-transparent animate-spin"></span>
          <span id="paypal-loading-text">Connecting to PayPal Secure Gateway...</span>
        </div>

        <!-- Render Target for PayPal Smart Buttons -->
        <div id="paypal-button-container" class="min-h-[120px] relative z-0"></div>

        <!-- Security Trust Marks -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400">
          <span class="flex items-center gap-1">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            PayPal Buyer Protection
          </span>
          <span>Cards & Balance Accepted</span>
        </div>

        <!-- Inline PayPal Diagnostics & Error Box -->
        <div id="paypal-error-box" class="hidden p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-rose-800 text-xs text-left leading-relaxed">
          <div class="font-bold flex items-center gap-1.5 text-rose-900 mb-1">
            <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span id="paypal-error-title">PayPal Authorization Notice</span>
          </div>
          <p id="paypal-error-desc" class="text-[11px] text-rose-700">The transaction could not proceed.</p>
        </div>
      </div>

      <!-- STATE B: SUCCESS & INSTANT DOWNLOAD STATE -->
      <div id="checkout-success-state" class="hidden space-y-4 text-center py-2">
        <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <div>
          <h4 class="text-lg font-black text-slate-900">Payment Confirmed!</h4>
          <p class="text-xs text-slate-600 mt-1">
            Thank you, <strong id="success-payer-name">Customer</strong>! Your transaction was completed successfully.
          </p>
          <p class="text-[10px] text-slate-400 font-mono mt-0.5" id="success-order-id">
            Order ID: 5X8921479812
          </p>
        </div>

        <!-- Download Action Button -->
        <div id="success-download-container" class="pt-2">
          <a 
            id="success-download-btn"
            href="#" 
            download
            class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Download Verified Excel Spreadsheet (CSV)</span>
          </a>
          <span class="block text-[10px] text-slate-400 mt-1.5">
            A confirmation has also been recorded in our system.
          </span>
        </div>

        <!-- High-Ticket Service Bridge Offer for Pack Buyers -->
        <div id="success-service-upsell" class="mt-4 p-4 rounded-2xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/90 text-left space-y-2.5">
          <div class="flex items-center gap-2 text-[10px] font-bold text-amber-800 uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
            <span>Recommended Next Step For Serious Importers</span>
          </div>
          <h5 class="text-xs font-bold text-slate-900 leading-snug">
            Need our Yiwu team to visit your chosen stalls & test real samples?
          </h5>
          <p class="text-[11px] text-slate-600 leading-relaxed">
            Don't wire funds blindly to unverified factories. Our bilingual ground agents walk straight to your target booths in Futian, test product quality, verify business licenses, and shoot live 4K video.
          </p>
          <div class="flex flex-col sm:flex-row gap-2 pt-1">
            <a
              href="/concierge"
              class="flex-1 py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs text-center shadow-sm transition"
            >
              Book Stall Audit ($99) &rarr;
            </a>
            <a
              href="https://wa.me/8613482725985?text=Hi%20SinoTradeLink%2C%20I%20just%20downloaded%20a%20Category%20Pack%20and%20want%20to%20discuss%20having%20your%20team%20visit%20stalls%20in%20Yiwu."
              target="_blank"
              rel="noopener noreferrer"
              class="py-2.5 px-3 rounded-xl bg-white hover:bg-slate-50 text-slate-800 border border-slate-200 font-bold text-xs text-center flex items-center justify-center gap-1.5 transition"
            >
              <span>WhatsApp Liaison</span>
            </a>
          </div>
        </div>

        <!-- Concierge specific note -->
        <div id="success-concierge-note" class="hidden p-3 rounded-xl bg-blue-50 border border-blue-200 text-xs text-blue-900 text-left">
          <strong>Next Steps:</strong> Our bilingual ground staff in Yiwu has been notified via Telegram. We will message your email and WhatsApp to coordinate stall coordinates and inspection specs.
        </div>
      </div>

    </div>
  </div>
</dialog>

<style>
  dialog#paypal-checkout-modal:not([open]) {
    display: none !important;
  }
  dialog#paypal-checkout-modal[open] {
    display: flex !important;
    align-items: center;
    justify-content: center;
  }
  dialog#paypal-checkout-modal::backdrop {
    background: rgba(2, 6, 23, 0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
</style>

<script is:inline>
(function() {
  var PAYPAL_CLIENT_ID = "BAA-U7WpNQZudJZbn-39Kd2E2Alw7toZtsb_8pRNtFgIpkZXRT2yUdps5-Eyk-N7a2cz0LF0E0R4SOYGgc";
  var isSdkLoaded = false;
  var isSdkLoading = false;
  var buttonsRendered = false;
  var activeItem = {
    id: 'category-pack',
    title: 'Category Wholesaler Pack',
    price: 29.00,
    type: 'pack'
  };

  function getEl(id) {
    return document.getElementById(id);
  }

  function loadPayPalSdk(callback) {
    if (isSdkLoaded && window.paypal) {
      if (typeof callback === 'function') callback();
      return;
    }

    if (isSdkLoading) {
      var checkInterval = setInterval(function() {
        if (isSdkLoaded && window.paypal) {
          clearInterval(checkInterval);
          if (typeof callback === 'function') callback();
        }
      }, 50);
      return;
    }

    isSdkLoading = true;
    var script = document.createElement('script');
    script.src = 'https://www.paypal.com/sdk/js?client-id=' + encodeURIComponent(PAYPAL_CLIENT_ID) + '&currency=USD&intent=capture';
    script.async = true;
    script.onload = function() {
      isSdkLoaded = true;
      isSdkLoading = false;
      if (typeof callback === 'function') callback();
    };
    script.onerror = function() {
      isSdkLoading = false;
      var loadingEl = getEl('paypal-loading');
      if (loadingEl) {
        loadingEl.innerHTML = '<span class="text-rose-500 font-bold">Failed to connect to PayPal. Please refresh or check connection.</span>';
      }
    };
    document.head.appendChild(script);
  }

  function showError(title, msg) {
    var box = getEl('paypal-error-box');
    var titleEl = getEl('paypal-error-title');
    var descEl = getEl('paypal-error-desc');
    var loadEl = getEl('paypal-loading');
    if (loadEl) loadEl.style.display = 'none';
    if (box && titleEl && descEl) {
      titleEl.textContent = title;
      descEl.textContent = msg;
      box.classList.remove('hidden');
    }
  }

  function hideError() {
    var box = getEl('paypal-error-box');
    if (box) box.classList.add('hidden');
  }

  function renderButtons() {
    var container = getEl('paypal-button-container');
    var loadingEl = getEl('paypal-loading');
    if (!window.paypal || !container) return;

    container.innerHTML = '';
    hideError();
    if (loadingEl) {
      loadingEl.style.display = 'flex';
      var loadingText = getEl('paypal-loading-text');
      if (loadingText) loadingText.textContent = 'Rendering PayPal & Card buttons...';
    }

    try {
      window.paypal.Buttons({
        style: {
          layout: 'vertical',
          color: 'gold',
          shape: 'rect',
          label: 'pay',
          height: 44
        },

        createOrder: function(data, actions) {
          hideError();
          return actions.order.create({
            intent: 'CAPTURE',
            purchase_units: [{
              description: (activeItem.title || 'Category Pack') + ' - SinoTradeLink',
              amount: {
                value: activeItem.price.toFixed(2),
                currency_code: 'USD'
              }
            }]
          }).catch(function(err) {
            console.error('[PayPal createOrder Error]:', err);
            showError(
              'Merchant Account Restricted (PAYEE_ACCOUNT_RESTRICTED)',
              'PayPal rejected order creation. Your merchant account at paypal.com requires business/identity verification before receiving live payments.'
            );
            throw err;
          });
        },

        onApprove: async function(data, actions) {
          var loadEl = getEl('paypal-loading');
          if (loadEl) {
            loadEl.style.display = 'flex';
            loadEl.innerHTML = '<span class="w-6 h-6 rounded-full border-2 border-emerald-600 border-t-transparent animate-spin"></span><span>Confirming payment & generating digital delivery...</span>';
          }

          try {
            var details = await actions.order.capture();

            var response = await fetch('/api/payment/complete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                orderId: data.orderID,
                payer: details.payer,
                amount: activeItem.price.toFixed(2),
                currency: 'USD',
                itemId: activeItem.id,
                itemTitle: activeItem.title
              })
            });

            var resData = await response.json();

            var paymentState = getEl('checkout-payment-state');
            var successState = getEl('checkout-success-state');
            if (paymentState) paymentState.classList.add('hidden');
            if (successState) successState.classList.remove('hidden');

            var payerGiven = details.payer && details.payer.name && details.payer.name.given_name ? details.payer.name.given_name : '';
            var payerSur = details.payer && details.payer.name && details.payer.name.surname ? details.payer.name.surname : '';
            var pName = (payerGiven + ' ' + payerSur).trim() || 'Customer';

            var successPayerName = getEl('success-payer-name');
            var successOrderId = getEl('success-order-id');
            if (successPayerName) successPayerName.textContent = pName;
            if (successOrderId) successOrderId.textContent = 'PayPal Ref: ' + data.orderID;

            var successDownloadBtn = getEl('success-download-btn');
            var successDownloadContainer = getEl('success-download-container');
            var successConciergeNote = getEl('success-concierge-note');
            var successServiceUpsell = getEl('success-service-upsell');

            if (activeItem.type === 'pack') {
              if (successDownloadBtn) {
                var url = resData.downloadUrl || ('/api/download-pack?order_id=' + encodeURIComponent(resData.orderId || data.orderID) + '&item_id=' + encodeURIComponent(activeItem.id));
                successDownloadBtn.href = url;
              }
              if (successDownloadContainer) successDownloadContainer.classList.remove('hidden');
              if (successServiceUpsell) successServiceUpsell.classList.remove('hidden');
              if (successConciergeNote) successConciergeNote.classList.add('hidden');
            } else {
              if (successDownloadContainer) successDownloadContainer.classList.add('hidden');
              if (successServiceUpsell) successServiceUpsell.classList.add('hidden');
              if (successConciergeNote) successConciergeNote.classList.remove('hidden');
            }

          } catch (err) {
            console.error('[Payment Capture Error]:', err);
            alert('Payment was authorized with PayPal, but automatic sync encountered a delay. Please contact WhatsApp support with Order ID: ' + data.orderID);
          }
        },

        onCancel: function(data) {
          console.log('[PayPal Cancelled]:', data);
          var loadEl = getEl('paypal-loading');
          if (loadEl) loadEl.style.display = 'none';
        },

        onError: function(err) {
          console.error('[PayPal Button Error]:', err);
          showError(
            'PayPal Authorization Notice',
            'PayPal popup closed or could not proceed. ' + (err && err.message ? err.message : 'Please check your PayPal merchant account.')
          );
        }
      }).render('#paypal-button-container').then(function() {
        buttonsRendered = true;
        if (loadingEl) loadingEl.style.display = 'none';
      }).catch(function(err) {
        console.error('[PayPal Render Error]:', err);
        if (loadingEl) {
          loadingEl.innerHTML = '<span class="text-rose-500 font-bold">Failed to render PayPal buttons. Please reload the page.</span>';
        }
      });
    } catch (e) {
      console.error('[PayPal Button Init Error]:', e);
    }
  }

  // Global trigger function to open PayPal Modal
  window.openPayPalCheckout = function(options) {
    var modal = getEl('paypal-checkout-modal');
    if (!modal) return;

    options = options || {};
    activeItem = {
      id: options.id || 'pack',
      title: options.title || 'Category Pack',
      price: parseFloat(options.price) || 29.00,
      type: options.type || 'pack'
    };

    var itemTitleEl = getEl('checkout-item-title');
    var priceDisplayEl = getEl('checkout-price-display');
    var itemSubtitleEl = getEl('checkout-item-subtitle');
    var paymentState = getEl('checkout-payment-state');
    var successState = getEl('checkout-success-state');
    var loadingEl = getEl('paypal-loading');

    if (itemTitleEl) itemTitleEl.textContent = activeItem.title;
    if (priceDisplayEl) priceDisplayEl.textContent = '$' + activeItem.price.toFixed(2) + ' USD';
    if (itemSubtitleEl) {
      itemSubtitleEl.textContent = activeItem.type === 'concierge' 
        ? 'On-Demand Bilingual Market Inspection Service'
        : 'Instant Verified Excel & CSV Spreadsheet';
    }

    if (paymentState) paymentState.classList.remove('hidden');
    if (successState) successState.classList.add('hidden');
    var successServiceUpsell = getEl('success-service-upsell');
    if (successServiceUpsell) successServiceUpsell.classList.add('hidden');
    hideError();
    if (loadingEl) {
      loadingEl.style.display = 'flex';
      var loadingText = getEl('paypal-loading-text');
      if (loadingText) loadingText.textContent = 'Connecting to PayPal Secure Gateway...';
    }

    // Open native dialog with fallback
    if (typeof modal.showModal === 'function') {
      try {
        modal.showModal();
      } catch (err) {
        modal.setAttribute('open', '');
      }
    } else {
      modal.setAttribute('open', '');
    }

    loadPayPalSdk(function() {
      renderButtons();
    });
  };

  // Close handlers
  var closeBtn = getEl('paypal-modal-close');
  if (closeBtn) {
    closeBtn.addEventListener('click', function() {
      var modal = getEl('paypal-checkout-modal');
      if (modal) {
        if (typeof modal.close === 'function') modal.close();
        else modal.removeAttribute('open');
      }
    });
  }

  var modalEl = getEl('paypal-checkout-modal');
  if (modalEl) {
    modalEl.addEventListener('click', function(e) {
      var rect = modalEl.getBoundingClientRect();
      if (
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom
      ) {
        if (typeof modalEl.close === 'function') modalEl.close();
        else modalEl.removeAttribute('open');
      }
    });
  }

  // Global click delegate for .paypal-trigger-btn
  document.addEventListener('click', function(e) {
    var target = e.target;
    var trigger = target && target.closest ? target.closest('.paypal-trigger-btn') : null;
    if (trigger) {
      e.preventDefault();
      var id = trigger.getAttribute('data-item-id') || 'pack';
      var title = trigger.getAttribute('data-item-title') || 'Category Pack';
      var price = parseFloat(trigger.getAttribute('data-item-price') || '29');
      var type = trigger.getAttribute('data-item-type') || 'pack';

      if (typeof window.openPayPalCheckout === 'function') {
        window.openPayPalCheckout({ id: id, title: title, price: price, type: type });
      } else {
        console.warn('PayPal checkout function not ready yet.');
      }
    }
  });

  // Preload PayPal SDK when idle
  if (typeof window !== 'undefined') {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(function() { loadPayPalSdk(); });
    } else {
      setTimeout(function() { loadPayPalSdk(); }, 1200);
    }
  }
})();
</script>
