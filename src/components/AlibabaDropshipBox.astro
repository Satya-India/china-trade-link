    statusReady: 'Chat pronta! Clicca qui sotto se WhatsApp non si è aperto automaticamente:',
    errorSummaryPrefix: 'Errore:',
    guarantee1: '0 $ di Abbonamento',
    guarantee2: 'Pacchi Neutri White-Label',
    guarantee3: 'Foto QC in Magazzino'
  }
};

const copy = BOX_DICT[currentLocale] || BOX_DICT.en;
const rootId = `alibaba-box-${Math.random().toString(36).slice(2, 8)}`;
---

<section
  id="alibaba-dropship-box"
  aria-labelledby={headingId}
  class={`w-full scroll-mt-20 ${compact ? '' : 'py-10 sm:py-12'}`}
  data-alibaba-root={rootId}
  data-detected-label={copy.detectedLabel}
  data-url-error={copy.urlError}
  data-search-error={copy.searchError}
  data-submitting-label={copy.submittingBtn}
  data-submit-label={copy.submitBtn}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-slate-900 text-white border border-slate-800 shadow-2xl overflow-hidden">
      <!-- Top Header Band -->
      <div class="bg-gradient-to-r from-orange-600/20 via-amber-500/15 to-emerald-500/15 border-b border-slate-800 px-6 sm:px-8 pt-6 pb-5">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold mb-3">
          <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          {copy.badge}
        </span>
        <h2 id={headingId} class="text-xl sm:text-3xl font-black tracking-tight text-white">
          {copy.title}
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed max-w-3xl">
          {copy.subtitle}
        </p>
      </div>

      <!-- Accessible Tabs -->
      <div class="px-6 sm:px-8 pt-4 bg-slate-950/60 border-b border-slate-800">
        <div role="tablist" aria-label={copy.title} class="stl-tablist flex items-center gap-6 overflow-x-auto no-scrollbar">
          <button
            type="button"
            role="tab"
            id={`${rootId}-tab-paste`}
            aria-selected="true"
            tabindex="0"
            class="stl-tab text-xs sm:text-sm py-3 whitespace-nowrap text-slate-300 cursor-pointer"
          >
            {copy.tabPaste}
          </button>
          <button
            type="button"
            role="tab"
            id={`${rootId}-tab-search`}
            aria-selected="false"
            tabindex="-1"
            class="stl-tab text-xs sm:text-sm py-3 whitespace-nowrap text-slate-300 cursor-pointer"
          >
            {copy.tabSearch} &#8599;
          </button>
        </div>
      </div>

      <!-- Tab Panel 1: Paste Alibaba Link -->
      <div
        role="tabpanel"
        id={`${rootId}-panel-paste`}
        aria-labelledby={`${rootId}-tab-paste`}
        class="stl-tabpanel"
      >
        <div class="p-6 sm:p-8 space-y-6 bg-slate-900">
          <form id={`${rootId}-paste-form`} aria-labelledby={headingId} novalidate class="space-y-5">
            <!-- Alibaba URL Field -->
            <div class="stl-field">
              <label for={`${rootId}-url-input`} class="block text-xs sm:text-sm font-bold text-slate-100 mb-1">
                {copy.urlLabel} <span class="text-amber-400" aria-hidden="true">*</span>
              </label>
              <span id={`${rootId}-url-hint`} class="block text-[11px] sm:text-xs text-slate-400 mb-2">
                {copy.urlHint}
              </span>
              <input
                type="url"
                id={`${rootId}-url-input`}
                name="alibaba_url"
                required
                autocorrect="off"
                autocapitalize="none"
                spellcheck="false"
                enterkeyhint="next"
                aria-invalid="false"
                aria-describedby={`${rootId}-url-hint`}
                data-error={`${rootId}-url-error`}
                placeholder={copy.urlPlaceholder}
                class="stl-control w-full px-4 py-3.5 rounded-2xl bg-slate-950 border-2 border-slate-700 text-white placeholder-slate-500 text-sm sm:text-base focus:outline-none focus:border-amber-400 transition-colors"
              />
              <div id={`${rootId}-url-error`} class="stl-error-msg mt-2 text-xs text-rose-300 font-semibold">
                <span role="img" aria-label={copy.errorSummaryPrefix}>&#10060;</span> {copy.urlError}
              </div>

              <!-- Live Parsed Slug Preview (Polite Status) -->
              <div
                id={`${rootId}-slug-preview`}
                role="status"
                aria-live="polite"
                class="hidden mt-3 p-3.5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-xs text-emerald-200"
              >
                <div class="flex items-center gap-2.5">
                  <span class="shrink-0 w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
                  <div>
                    <span class="font-bold text-emerald-300">{copy.detectedLabel} </span>
                    <span id={`${rootId}-slug-text`} class="font-semibold text-white"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- 3-Option Radio Group: Fulfillment Mode -->
            <fieldset class="space-y-2.5">
              <legend class="text-xs sm:text-sm font-bold text-slate-100 mb-1">
                {copy.orderLegend}
              </legend>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div class="relative flex items-start gap-3 p-3.5 rounded-2xl bg-slate-950/90 border border-slate-700/80 hover:border-amber-400/60 transition-colors">
                  <input
                    type="radio"
                    id={`${rootId}-mode-dropship`}
                    name="order_type"
                    value="1-Piece Private Dropshipping"
                    checked
                    class="mt-1 w-4 h-4 shrink-0 cursor-pointer accent-amber-400"
                  />
                  <label for={`${rootId}-mode-dropship`} class="cursor-pointer select-none">
                    <span class="block text-xs font-bold text-white">{copy.modeDropship}</span>
                    <span class="block text-[11px] text-slate-400 mt-0.5 leading-snug">{copy.modeDropshipHint}</span>
                  </label>
                </div>

                <div class="relative flex items-start gap-3 p-3.5 rounded-2xl bg-slate-950/90 border border-slate-700/80 hover:border-amber-400/60 transition-colors">
                  <input
                    type="radio"
                    id={`${rootId}-mode-lowmoq`}
                    name="order_type"
                    value="Low-MOQ Test Batch (10-100 pcs)"
