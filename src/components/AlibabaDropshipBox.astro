                  />
                  <label for={`${rootId}-mode-lowmoq`} class="cursor-pointer select-none">
                    <span class="block text-xs font-bold text-white">{copy.modeLowMoq}</span>
                    <span class="block text-[11px] text-slate-400 mt-0.5 leading-snug">{copy.modeLowMoqHint}</span>
                  </label>
                </div>

                <div class="relative flex items-start gap-3 p-3.5 rounded-2xl bg-slate-950/90 border border-slate-700/80 hover:border-amber-400/60 transition-colors">
                  <input
                    type="radio"
                    id={`${rootId}-mode-bulk`}
                    name="order_type"
                    value="Bulk / Mixed Consolidation"
                    class="mt-1 w-4 h-4 shrink-0 cursor-pointer accent-amber-400"
                  />
                  <label for={`${rootId}-mode-bulk`} class="cursor-pointer select-none">
                    <span class="block text-xs font-bold text-white">{copy.modeBulk}</span>
                    <span class="block text-[11px] text-slate-400 mt-0.5 leading-snug">{copy.modeBulkHint}</span>
                  </label>
                </div>
              </div>
            </fieldset>

            <!-- Optional Destination Country & Buyer Contact -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="stl-field">
                <label for={`${rootId}-country-input`} class="block text-xs font-bold text-slate-200 mb-1.5">
                  {copy.countryLabel}
                </label>
                <input
                  type="text"
                  id={`${rootId}-country-input`}
                  name="buyer_country"
                  list={`${rootId}-country-datalist`}
                  autocomplete="country-name"
                  enterkeyhint="next"
                  placeholder={copy.countryPlaceholder}
                  class="stl-control w-full px-4 py-3 rounded-2xl bg-slate-950 border-2 border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 transition-colors"
                />
                <datalist id={`${rootId}-country-datalist`}>
                  <option value="United States" />
                  <option value="United Kingdom" />
                  <option value="Canada" />
                  <option value="Australia" />
                  <option value="United Arab Emirates" />
                  <option value="Saudi Arabia" />
                  <option value="Germany" />
                  <option value="France" />
                  <option value="Spain" />
                  <option value="Italy" />
                  <option value="Brazil" />
                  <option value="Mexico" />
                  <option value="Nigeria" />
                  <option value="South Africa" />
                  <option value="Kenya" />
                  <option value="Tanzania" />
                  <option value="India" />
                  <option value="Netherlands" />
                  <option value="Poland" />
                  <option value="Russia" />
                </datalist>
              </div>

              <div class="stl-field">
                <label for={`${rootId}-contact-input`} class="block text-xs font-bold text-slate-200 mb-1.5">
                  {copy.contactLabel}
                </label>
                <input
                  type="text"
                  id={`${rootId}-contact-input`}
                  name="buyer_contact"
                  autocomplete="name"
                  enterkeyhint="done"
                  placeholder={copy.contactPlaceholder}
                  class="stl-control w-full px-4 py-3 rounded-2xl bg-slate-950 border-2 border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 transition-colors"
                />
              </div>
            </div>

            <!-- Submit Button + Screenshot App Option -->
            <div class="pt-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <button
                type="submit"
                id={`${rootId}-submit-btn`}
                class="flex-1 min-h-[48px] px-6 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs sm:text-sm shadow-lg shadow-emerald-500/20 transition-all cursor-pointer flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.586 1.761.884 2.791.884 3.182 0 5.768-2.586 5.768-5.766 0-3.18-2.586-5.77-5.768-5.77zm3.393 8.163c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.008-.472-1.68-.696-2.757-2.42-2.841-2.531-.084-.112-.68-1.026-.68-1.956 0-.93.486-1.385.66-1.575.174-.189.38-.236.507-.236.126 0 .253.001.364.007.119.006.277-.045.434.33.162.388.555 1.353.604 1.452.049.1.082.216.016.347-.066.13-.1.21-.197.324-.099.113-.208.253-.297.34-.1.098-.204.205-.088.404.116.199.516.852 1.108 1.38.763.68 1.408.89 1.609.99.201.1.319.083.437-.052.119-.136.508-.59.644-.793.136-.203.273-.169.458-.101.186.068 1.182.557 1.385.658.203.102.338.152.388.237.05.085.05.49-.094.895z" />
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.528 3.659 1.446 5.174L2 22l4.981-1.306C8.423 21.545 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.062c-1.644 0-3.167-.487-4.444-1.325l-.318-.21-2.964.777.791-2.89-.229-.364C3.935 14.717 3.438 13.398 3.438 12c0-4.721 3.841-8.562 8.562-8.562 4.721 0 8.562 3.841 8.562 8.562 0 4.721-3.841 8.062-8.562 8.062z" />
                </svg>
                <span>{copy.submitBtn}</span>
              </button>

              <a
                href="https://wa.me/8613482725985?text=Hi%20SinoTradeLink%2C%20I%20am%20browsing%20Alibaba%20and%20want%20to%20send%20product%20screenshots%20for%20a%20direct%20factory%20%26%20dropshipping%20quote."
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[48px] px-5 py-3.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700 font-bold text-xs text-center flex items-center justify-center gap-2 transition-colors whitespace-nowrap"
              >
                <span>&#128248; {copy.appBtn}</span>
              </a>
            </div>

            <!-- Live Submission Confirmation & Fallback Link -->
            <div
              id={`${rootId}-submit-status`}
              role="status"
              aria-live="polite"
              class="hidden p-4 rounded-2xl bg-emerald-950/60 border border-emerald-500/40 text-xs text-emerald-100 space-y-2"
            >
              <p class="font-semibold">{copy.statusReady}</p>
              <a
                id={`${rootId}-wa-fallback-link`}
                href="https://wa.me/8613482725985"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs transition-colors"
              >
                Open WhatsApp Chat (+86 134 8272 5985) &rarr;
              </a>
            </div>
          </form>

          <!-- Guarantee Pills Footer -->
          <div class="pt-4 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-[11px] text-slate-400">
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              <span class="inline-flex items-center gap-1.5"><span class="text-emerald-400">&#10003;</span> {copy.guarantee1}</span>
              <span class="inline-flex items-center gap-1.5"><span class="text-emerald-400">&#10003;</span> {copy.guarantee2}</span>
              <span class="inline-flex items-center gap-1.5"><span class="text-emerald-400">&#10003;</span> {copy.guarantee3}</span>
            </div>
            <span class="text-slate-500">{copy.appHint}</span>
          </div>
        </div>
      </div>

      <!-- Tab Panel 2: Search on Alibaba.com Helper -->
      <div
        role="tabpanel"
        id={`${rootId}-panel-search`}
        aria-labelledby={`${rootId}-tab-search`}
        hidden="until-found"
        class="stl-tabpanel"
      >
        <div class="p-6 sm:p-8 space-y-5 bg-slate-900">
          <form id={`${rootId}-search-form`} aria-label={copy.tabSearch} novalidate class="space-y-4">
            <div class="stl-field">
              <label for={`${rootId}-search-input`} class="block text-xs sm:text-sm font-bold text-slate-100 mb-1">
                {copy.searchLabel} <span class="text-amber-400" aria-hidden="true">*</span>
              </label>
              <span id={`${rootId}-search-hint`} class="block text-[11px] sm:text-xs text-slate-400 mb-2">
                {copy.searchHint}
              </span>
              <div class="flex flex-col sm:flex-row gap-3">
                <div class="flex-1">
                  <input
                    type="search"
                    id={`${rootId}-search-input`}
                    name="alibaba_query"
                    required
                    minlength="2"
                    autocorrect="off"
                    autocapitalize="none"
                    spellcheck="false"
                    enterkeyhint="search"
                    aria-invalid="false"
                    aria-describedby={`${rootId}-search-hint`}
                    data-error={`${rootId}-search-error`}
                    placeholder={copy.searchPlaceholder}
                    class="stl-control w-full px-4 py-3.5 rounded-2xl bg-slate-950 border-2 border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-amber-400 transition-colors"
                  />
                  <div id={`${rootId}-search-error`} class="stl-error-msg mt-2 text-xs text-rose-300 font-semibold">
                    <span role="img" aria-label={copy.errorSummaryPrefix}>&#10060;</span> {copy.searchError}
                  </div>
                </div>
                <button
                  type="submit"
                  class="min-h-[48px] px-6 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm shadow-md transition-colors cursor-pointer whitespace-nowrap self-start"
                >
                  {copy.searchBtn}
                </button>
              </div>
            </div>
          </form>

          <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs text-slate-300 leading-relaxed flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <p>{copy.searchNote}</p>
            <a
              href="https://wa.me/8613482725985?text=Hi%20SinoTradeLink%2C%20I%20am%20browsing%20Alibaba%20and%20want%20to%20send%20product%20screenshots%20for%20a%20direct%20factory%20%26%20dropshipping%20quote."
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 px-4 py-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 font-bold text-xs whitespace-nowrap transition-colors"
            >
              &#128248; {copy.appBtn}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stl-tab {
    position: relative;
    transition: color 0.15s ease;
  }

  .stl-tab[aria-selected="true"] {
    color: #fbbf24;
  }

  .stl-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    border-block-end: 3px solid #fbbf24;
  }

  .stl-tab:focus-visible,
  .stl-control:focus-visible {
    outline: 3px solid #fbbf24;
    outline-offset: 2px;
  }

  .stl-error-msg {
    display: none;
  }

  .stl-control:is(:user-invalid, .user-invalid-fallback) {
    border-color: #fb7185;
    background-color: rgba(136, 19, 55, 0.2);
  }

  .stl-control:is(:user-invalid, .user-invalid-fallback) + .stl-error-msg {
    display: block;
  }

  .stl-control:is(:user-valid, .user-valid-fallback):not(:placeholder-shown) {
    border-color: #34d399;
  }

  .stl-visually-hidden:where(:not(:focus-within, :active)) {
    position: absolute !important;
    clip-path: inset(50%) !important;
    overflow: hidden !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    border: 0 !important;
    white-space: nowrap !important;
  }
</style>

<script is:inline define:vars={{ rootId }}>
  (function () {
    var root = document.querySelector('[data-alibaba-root="' + rootId + '"]');
    if (!root) return;

    var tabPaste = document.getElementById(rootId + '-tab-paste');
    var tabSearch = document.getElementById(rootId + '-tab-search');
    var panelPaste = document.getElementById(rootId + '-panel-paste');
    var panelSearch = document.getElementById(rootId + '-panel-search');

    var pasteForm = document.getElementById(rootId + '-paste-form');
    var urlInput = document.getElementById(rootId + '-url-input');
    var urlErrorMsg = root.getAttribute('data-url-error') || 'Please paste a valid Alibaba.com link.';
    var searchErrorMsg = root.getAttribute('data-search-error') || 'Please enter a keyword.';
    var slugPreview = document.getElementById(rootId + '-slug-preview');
    var slugText = document.getElementById(rootId + '-slug-text');
    var countryInput = document.getElementById(rootId + '-country-input');
    var contactInput = document.getElementById(rootId + '-contact-input');
    var submitBtn = document.getElementById(rootId + '-submit-btn');
    var submitStatus = document.getElementById(rootId + '-submit-status');
    var waFallbackLink = document.getElementById(rootId + '-wa-fallback-link');

    var searchForm = document.getElementById(rootId + '-search-form');
    var searchInput = document.getElementById(rootId + '-search-input');

    var tabs = [tabPaste, tabSearch];
    var panels = [panelPaste, panelSearch];

    function selectTab(index, moveFocus) {
      for (var i = 0; i < tabs.length; i++) {
        var isSelected = i === index;
        var t = tabs[i];
        var p = panels[i];
        if (!t || !p) continue;
        t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        t.setAttribute('tabindex', isSelected ? '0' : '-1');
        if (isSelected) {
          p.removeAttribute('hidden');
        } else {
          p.hidden = 'until-found';
        }
        if (isSelected && moveFocus) {
          t.focus();
        }
      }
    }

    for (var ti = 0; ti < tabs.length; ti++) {
      (function (idx) {
        var t = tabs[idx];
        var p = panels[idx];
        if (!t || !p) return;
        t.addEventListener('click', function () {
          selectTab(idx, false);
        });
        t.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            var next = idx === 0 ? 1 : 0;
            selectTab(next, true);
          } else if (e.key === 'Home') {
            e.preventDefault();
            selectTab(0, true);
          } else if (e.key === 'End') {
            e.preventDefault();
            selectTab(tabs.length - 1, true);
          }
        });
        p.addEventListener('beforematch', function () {
          selectTab(idx, false);
        });
      })(ti);
    }

    // Shared polite live announcer for blur/change validation errors
    var announcer = document.createElement('div');
    announcer.setAttribute('aria-live', 'polite');
    announcer.className = 'stl-visually-hidden';
    document.body.appendChild(announcer);
    var announceTimer = null;
    var announcedField = null;

    function linkError(el, shown) {
      var errorId = el.getAttribute('data-error');
      if (!errorId) return;
      var raw = el.getAttribute('aria-describedby') || '';
      var parts = raw.split(/\s+/).filter(function (id) {
        return id && id !== errorId;
      });
      if (shown) parts.push(errorId);
      if (parts.length) el.setAttribute('aria-describedby', parts.join(' '));
      else el.removeAttribute('aria-describedby');
    }

    function normalizeAlibabaUrl(val) {
      var trimmed = (val || '').trim();
      if (!trimmed) return '';
      if (/^alibaba\./i.test(trimmed) || /^www\.alibaba\./i.test(trimmed) || /^[a-z]{1,8}\.alibaba\./i.test(trimmed)) {
        return 'https://' + trimmed;
      }
      return trimmed;
    }

    function isAlibabaUrlValid(rawVal) {
      var normalized = normalizeAlibabaUrl(rawVal);
      if (!normalized) return false;
      try {
        var parsed = new URL(normalized);
        var host = parsed.hostname.toLowerCase();
        return host === 'alibaba.com' || host.endsWith('.alibaba.com');
      } catch (err) {
        return false;
      }
    }

    function extractProductTitle(rawUrl) {
      var normalized = normalizeAlibabaUrl(rawUrl);
      if (!normalized) return '';
      try {
        var parsed = new URL(normalized);
        var path = parsed.pathname || '';
        var detailMatch = path.match(/\/product-detail\/([^/?#]+?)(?:_\d+)?\.html/i);
        var slug = '';
        if (detailMatch && detailMatch[1]) {
          slug = detailMatch[1];
        } else {
          var q = parsed.searchParams.get('SearchText') || '';
          if (q) slug = q;
        }
        if (!slug) {
          var cleanedParts = path.split('/').filter(function (seg) {
            return seg && seg !== 'product-detail' && !/^\d+\.html$/.test(seg);
          });
          if (cleanedParts.length) {
            slug = cleanedParts[cleanedParts.length - 1].replace(/\.html$/i, '').replace(/_\d+$/, '');
          }
        }
        if (!slug) return '';
        var decoded = decodeURIComponent(slug).replace(/[-_+]+/g, ' ').replace(/\s+/g, ' ').trim();
        if (!decoded) return '';
        return decoded.slice(0, 90);
      } catch (err) {
        return '';
      }
    }

    function updateSlugPreview() {
      if (!urlInput || !slugPreview || !slugText) return;
      var raw = urlInput.value.trim();
      if (!isAlibabaUrlValid(raw)) {
        slugPreview.classList.add('hidden');
        slugText.textContent = '';
        return;
      }
      var title = extractProductTitle(raw);
      if (title && title.length >= 3) {
        slugText.textContent = title;
        slugPreview.classList.remove('hidden');
      } else {
        slugText.textContent = 'Alibaba.com Product Link Ready';
        slugPreview.classList.remove('hidden');
      }
    }

    var dirtyMap = new WeakMap();
    var announcedMap = new WeakSet();

    function applyFieldState(el, isValid, announce) {
      if (!el) return;
      el.classList.toggle('user-invalid-fallback', !isValid);
      el.classList.toggle('user-valid-fallback', isValid);
      el.setAttribute('aria-invalid', isValid ? 'false' : 'true');
      linkError(el, !isValid);

      if (!isValid && announce && !announcedMap.has(el)) {
        announcedMap.add(el);
        var errEl = document.getElementById(el.getAttribute('data-error') || '');
        if (errEl) {
          clearTimeout(announceTimer);
          announcer.textContent = '';
          announcedField = el;
          announceTimer = setTimeout(function () {
            announcer.textContent = errEl.textContent.replace(/\s+/g, ' ').trim();
          }, 500);
        }
      } else if (isValid) {
        announcedMap.delete(el);
        if (announcedField === el) {
          clearTimeout(announceTimer);
          announcer.textContent = '';
        }
      }
    }

    if (urlInput) {
      urlInput.addEventListener('input', function () {
        var st = dirtyMap.get(urlInput) || { interacted: false, blurred: false };
        st.interacted = true;
        dirtyMap.set(urlInput, st);
        urlInput.setCustomValidity('');
        if (urlInput.getAttribute('aria-invalid') === 'true' && isAlibabaUrlValid(urlInput.value)) {
          applyFieldState(urlInput, true, false);
        }
        updateSlugPreview();
      });

      urlInput.addEventListener('blur', function () {
        var normalized = normalizeAlibabaUrl(urlInput.value);
        if (normalized && normalized !== urlInput.value.trim()) {
          urlInput.value = normalized;
        }
        var st = dirtyMap.get(urlInput) || { interacted: false, blurred: false };
        st.blurred = true;
        dirtyMap.set(urlInput, st);
        if (st.interacted || urlInput.value.trim()) {
          var valid = isAlibabaUrlValid(urlInput.value);
          urlInput.setCustomValidity(valid ? '' : urlErrorMsg);
          applyFieldState(urlInput, valid, true);
        }
        updateSlugPreview();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        var st = dirtyMap.get(searchInput) || { interacted: false, blurred: false };
        st.interacted = true;
        dirtyMap.set(searchInput, st);
        searchInput.setCustomValidity('');
        if (searchInput.getAttribute('aria-invalid') === 'true' && searchInput.value.trim().length >= 2) {
          applyFieldState(searchInput, true, false);
        }
      });

      searchInput.addEventListener('blur', function () {
        var st = dirtyMap.get(searchInput) || { interacted: false, blurred: false };
        st.blurred = true;
        dirtyMap.set(searchInput, st);
        if (st.interacted && searchInput.value.trim().length > 0 && searchInput.value.trim().length < 2) {
          searchInput.setCustomValidity(searchErrorMsg);
          applyFieldState(searchInput, false, true);
        }
      });
    }

    if (pasteForm && urlInput) {
      pasteForm.addEventListener('submit', function (e) {
        e.preventDefault();

        var normalized = normalizeAlibabaUrl(urlInput.value);
        if (normalized) urlInput.value = normalized;

        var valid = isAlibabaUrlValid(normalized);
        urlInput.setCustomValidity(valid ? '' : urlErrorMsg);
        applyFieldState(urlInput, valid, false);
        if (!valid) {
          urlInput.focus();
          return;
        }

        var selectedRadio = pasteForm.querySelector('input[name="order_type"]:checked');
        var orderMode = selectedRadio ? selectedRadio.value : '1-Piece Private Dropshipping';
        var countryVal = countryInput && countryInput.value ? countryInput.value.trim() : '';
        var contactVal = contactInput && contactInput.value ? contactInput.value.trim() : '';
        var parsedTitle = extractProductTitle(normalized) || 'Product from Alibaba Link';

        var origHtml = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
        }

        var msgLines = [
          'Hi SinoTradeLink Yiwu Desk, I want a factory-direct & dropshipping quote for this Alibaba product:',
          '• Product: ' + parsedTitle,
          '• Alibaba Link: ' + normalized,
          '• Order Mode: ' + orderMode
        ];
        if (countryVal) msgLines.push('• Destination Country: ' + countryVal);
        if (contactVal) msgLines.push('• Buyer Name / Contact: ' + contactVal);
        var waText = msgLines.join('\n');
        var waUrl = 'https://wa.me/8613482725985?text=' + encodeURIComponent(waText);

        // Silent non-blocking lead capture to Cloudflare D1 / Telegram / Resend
        try {
          fetch('/api/inquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
            body: JSON.stringify({
              quick_whatsapp: true,
              shop_id: 'ALIBABA_DROPSHIP',
              alibaba_url: normalized,
              order_type: orderMode,
              buyer_name: contactVal || 'WhatsApp Direct Buyer',
              buyer_country: countryVal || 'Global',
              phone: contactVal || undefined,
              service_type: 'Alibaba Dropshipping Quote (' + orderMode + ')',
              message: waText
            })
          }).catch(function () {});
        } catch (err) {}

        if (waFallbackLink) {
          waFallbackLink.href = waUrl;
        }
        if (submitStatus) {
          submitStatus.classList.remove('hidden');
        }

        window.open(waUrl, '_blank', 'noopener,noreferrer');

        setTimeout(function () {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (origHtml) submitBtn.innerHTML = origHtml;
          }
        }, 900);
      });
    }

    if (searchForm && searchInput) {
      searchForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var kw = (searchInput.value || '').trim();
        if (kw.length < 2) {
          searchInput.setCustomValidity(searchErrorMsg);
          applyFieldState(searchInput, false, false);
          searchInput.focus();
          return;
        }
        applyFieldState(searchInput, true, false);
        var alibabaSearchUrl = 'https://www.alibaba.com/trade/search?SearchText=' + encodeURIComponent(kw);
        window.open(alibabaSearchUrl, '_blank', 'noopener,noreferrer');
      });
    }
  })();
</script>
