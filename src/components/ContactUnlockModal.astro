---
---

<!-- Global Contact Unlock & RFQ Lead Capture Modal Dialog -->
<dialog id="contact-unlock-modal" class="fixed inset-0 m-auto z-50 p-0 rounded-3xl bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm max-w-lg w-full shadow-2xl open:animate-in open:fade-in open:zoom-in-95">
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-2xl max-h-[90vh] flex flex-col">
    <!-- Top Header Banner -->
    <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 px-6 py-4 text-white relative shrink-0">
      <button 
        type="button" 
        id="modal-close-btn"
        class="absolute top-4 right-4 text-white/80 hover:text-white p-1 rounded-full hover:bg-white/10 transition-colors"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="flex items-center gap-2 text-xs font-bold text-blue-200 uppercase tracking-wider mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Verified Stall Contact & Direct RFQ</span>
      </div>
      <h3 id="modal-supplier-name" class="text-lg font-black text-white leading-tight">
        Supplier Name
      </h3>
      <p id="modal-stall-info" class="text-xs text-blue-100 mt-1 flex items-center gap-2">
        <span>District 5</span> • <span>Booth 62159</span>
      </p>
    </div>

    <!-- Modal Body Content (Scrollable) -->
    <div class="p-6 space-y-5 overflow-y-auto">
      <!-- Unmasked Contact Card -->
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block">Contact Person:</span>
            <span id="modal-contact-person" class="text-sm font-bold text-slate-800">Stall Manager</span>
          </div>
          <span class="inline-flex items-center gap-1 text-[11px] font-bold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            100% Unmasked
          </span>
        </div>

        <div>
          <span class="text-[10px] uppercase font-bold text-slate-400 block">Direct Mobile / WhatsApp:</span>
          <div class="flex items-center justify-between mt-1 bg-white p-2.5 rounded-xl border border-slate-200">
            <span id="modal-phone-display" class="font-mono text-base font-bold text-slate-900 tracking-wide">
              +86-180-xxxx-xxxx
            </span>
            <button 
              type="button" 
              id="copy-phone-btn"
              class="px-2.5 py-1 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors flex items-center gap-1 cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Copy</span>
            </button>
          </div>
        </div>

        <!-- Quick Chat Buttons -->
        <div class="grid grid-cols-2 gap-2 pt-1">
          <a 
            id="whatsapp-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer"
            class="py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-colors text-center cursor-pointer"
          >
            <span>Open WhatsApp</span>
          </a>
          <button 
            type="button" 
            id="wechat-btn"
            class="py-2.5 px-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition-colors text-center cursor-pointer"
          >
            <span>WeChat ID Copied</span>
          </button>
        </div>
      </div>

      <!-- Direct RFQ Form Section (Saves directly to Cloudflare D1) -->
      <div class="border-t border-slate-200 pt-4">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-slate-900 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Send Direct RFQ / Request Quotation
          </span>
          <span class="text-[10px] text-slate-500 font-medium">Recorded in Database</span>
        </div>

        <form id="modal-rfq-form" class="space-y-2.5">
          <input type="hidden" id="rfq-shop-id" name="shop_id" value="" />
          <input type="hidden" id="rfq-target-booth" name="target_booth" value="" />

          <div class="grid grid-cols-2 gap-2">
            <input 
              type="text" 
              id="rfq-buyer-name" 
              name="buyer_name" 
              placeholder="Your Full Name *" 
              required 
              class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 bg-slate-50"
            />
            <input 
              type="email" 
              id="rfq-buyer-email" 
              name="buyer_email" 
              placeholder="Business Email *" 
              required 
              class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 bg-slate-50"
            />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <input 
              type="text" 
              id="rfq-buyer-country" 
              name="buyer_country" 
              placeholder="Your Country / Region" 
              class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 bg-slate-50"
            />
            <input 
              type="text" 
              id="rfq-buyer-phone" 
              name="phone" 
              placeholder="WhatsApp / Phone (Optional)" 
              class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 bg-slate-50"
            />
          </div>

          <textarea 
            id="rfq-message" 
            name="message" 
            rows="2" 
            required 
            placeholder="Describe product models, target order quantities (MOQ), and shipping port..." 
            class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-blue-500 bg-slate-50"
          ></textarea>

          <button 
            type="submit" 
            id="rfq-submit-btn"
            class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-sm transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
          >
            <span>Submit RFQ to Stall & Coordinator &rarr;</span>
          </button>
        </form>

        <div id="rfq-feedback" class="hidden mt-2 p-3 rounded-xl text-xs font-medium"></div>
      </div>

      <!-- Upsell 1: Category Pack -->
      <div class="rounded-2xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/80 p-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <span class="inline-block text-[10px] font-black uppercase tracking-wider bg-amber-500 text-white px-2 py-0.5 rounded mb-1">
              Save 20+ Hours
            </span>
            <h4 class="text-xs font-bold text-slate-900">Download the Full Category Excel Sheet ($29)</h4>
            <p class="text-[11px] text-slate-600 mt-0.5">
              Get all 1,500+ direct factory contacts in this niche with clean spreadsheets, WeChat IDs, and booth numbers.
            </p>
          </div>
          <a 
            href="/category-packs" 
            class="shrink-0 px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs rounded-xl shadow-sm transition-colors text-center mt-1"
          >
            View Packs &rarr;
          </a>
        </div>
      </div>

      <!-- Upsell 2: On-Demand Ground Concierge -->
      <div class="rounded-2xl bg-slate-900 text-white p-4 flex items-center justify-between gap-3">
        <div>
          <span class="text-[10px] uppercase font-bold text-emerald-400 block">Can't travel to China?</span>
          <h4 class="text-xs font-bold text-white">Book an On-Demand Physical Stall Visit ($99)</h4>
          <p class="text-[11px] text-slate-400">Our local agent walks to this booth, verifies stock, and takes 4K video.</p>
        </div>
        <a 
          href="/concierge" 
          class="shrink-0 px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-sm transition-colors"
        >
          Book Visit
        </a>
      </div>
    </div>
  </div>
</dialog>

<script>
  // Client-side controller for modal dialog
  const modal = document.getElementById('contact-unlock-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('modal-close-btn');
  const modalSupplierName = document.getElementById('modal-supplier-name');
  const modalStallInfo = document.getElementById('modal-stall-info');
  const modalContactPerson = document.getElementById('modal-contact-person');
  const modalPhoneDisplay = document.getElementById('modal-phone-display');
  const copyPhoneBtn = document.getElementById('copy-phone-btn');
  const whatsappLink = document.getElementById('whatsapp-link') as HTMLAnchorElement | null;
  const wechatBtn = document.getElementById('wechat-btn');

  // RFQ Form Elements
  const rfqForm = document.getElementById('modal-rfq-form') as HTMLFormElement | null;
  const rfqShopId = document.getElementById('rfq-shop-id') as HTMLInputElement | null;
  const rfqTargetBooth = document.getElementById('rfq-target-booth') as HTMLInputElement | null;
  const rfqSubmitBtn = document.getElementById('rfq-submit-btn') as HTMLButtonElement | null;
  const rfqFeedback = document.getElementById('rfq-feedback');

  let currentRawPhone = '';
  let currentShopId = '';
  let currentBooth = '';

  function openUnlockModal(btn: HTMLElement) {
    if (!modal) return;

    const sName = btn.getAttribute('data-supplier-name') || 'Supplier';
    const cPerson = btn.getAttribute('data-contact-person') || 'Stall Manager';
    const rawP = btn.getAttribute('data-phone') || '';
    const intlP = btn.getAttribute('data-intl-phone') || rawP;
    const district = btn.getAttribute('data-district') || 'Market Stall';
    const booth = btn.getAttribute('data-booth') || '';
    const shopId = btn.getAttribute('data-unlock-id') || '';

    currentRawPhone = rawP;
    currentShopId = shopId;
    currentBooth = booth;

    if (modalSupplierName) modalSupplierName.textContent = sName;
    if (modalStallInfo) modalStallInfo.innerHTML = `<span>${district}</span>${booth ? ` • <span>Booth ${booth}</span>` : ''}`;
    if (modalContactPerson) modalContactPerson.textContent = cPerson;
    if (modalPhoneDisplay) modalPhoneDisplay.textContent = intlP || rawP || 'Verified on Request';

    if (rfqShopId) rfqShopId.value = shopId;
    if (rfqTargetBooth) rfqTargetBooth.value = booth;
    if (rfqFeedback) {
      rfqFeedback.className = 'hidden';
      rfqFeedback.innerHTML = '';
    }

    // WhatsApp Direct Link
    const cleanDigits = rawP.replace(/\D/g, '');
    const intlDigits = cleanDigits.startsWith('86') ? cleanDigits : `86${cleanDigits}`;
    if (whatsappLink) {
      whatsappLink.href = `https://wa.me/${intlDigits}?text=Hi%20${encodeURIComponent(cPerson)}%2C%20I%20saw%20your%20stall%20at%20Yiwu%20Futian%20Market%20and%20would%20like%20to%20inquire%20about%20your%20wholesale%20products.`;
    }

    modal.showModal();
  }

  // Attach event listeners to all unlock / RFQ buttons
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.unlock-contact-btn') as HTMLElement | null;
    if (target) {
      openUnlockModal(target);
    }
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });

  // Close when clicking modal backdrop
  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      modal.close();
    }
  });

  // Copy phone action
  copyPhoneBtn?.addEventListener('click', () => {
    if (!currentRawPhone) return;
    navigator.clipboard.writeText(currentRawPhone).then(() => {
      const orig = copyPhoneBtn.innerHTML;
      copyPhoneBtn.innerHTML = `<span>Copied!</span>`;
      setTimeout(() => { copyPhoneBtn.innerHTML = orig; }, 2000);
    });
  });

  // Copy WeChat action
  wechatBtn?.addEventListener('click', () => {
    if (!currentRawPhone) return;
    navigator.clipboard.writeText(currentRawPhone).then(() => {
      const orig = wechatBtn.innerHTML;
      wechatBtn.innerHTML = `<span>Copied WeChat ID!</span>`;
      setTimeout(() => { wechatBtn.innerHTML = orig; }, 2000);
    });
  });

  // RFQ Form Async Submission
  rfqForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!rfqSubmitBtn || !rfqFeedback) return;

    const origBtnText = rfqSubmitBtn.innerHTML;
    rfqSubmitBtn.disabled = true;
    rfqSubmitBtn.innerHTML = `<span>Submitting RFQ...</span>`;
    rfqFeedback.className = 'hidden';

    const formData = new FormData(rfqForm);
    const payload = {
      shop_id: formData.get('shop_id') || currentShopId,
      target_booth: formData.get('target_booth') || currentBooth,
      buyer_name: formData.get('buyer_name'),
      buyer_email: formData.get('buyer_email'),
      buyer_country: formData.get('buyer_country'),
      phone: formData.get('phone'),
      message: formData.get('message'),
      service_type: 'rfq'
    };

    try {
      const res = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (res.ok && data.success) {
        rfqFeedback.className = 'mt-2 p-3 rounded-xl text-xs font-medium bg-emerald-50 text-emerald-800 border border-emerald-200';
        rfqFeedback.innerHTML = `
          <div class="font-bold text-emerald-900 mb-0.5">✅ RFQ Recorded Successfully!</div>
          <div>Inquiry ID: <span class="font-mono font-bold">${data.inquiryId ? data.inquiryId.slice(0, 8) : 'CONFIRMED'}</span>. Our Yiwu coordinator and the booth manager will review your specs and email you back.</div>
        `;
        rfqForm.reset();
      } else {
        rfqFeedback.className = 'mt-2 p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200';
        rfqFeedback.textContent = data.error || 'Failed to submit RFQ. Please try again.';
      }
    } catch (err) {
      rfqFeedback.className = 'mt-2 p-3 rounded-xl text-xs font-medium bg-rose-50 text-rose-800 border border-rose-200';
      rfqFeedback.textContent = 'Network error. Please check your connection or contact via WhatsApp.';
    } finally {
      rfqSubmitBtn.disabled = false;
      rfqSubmitBtn.innerHTML = origBtnText;
    }
  });
</script>
