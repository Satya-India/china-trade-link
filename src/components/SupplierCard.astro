---
import type { Supplier } from '../lib/data';

interface Props {
  supplier: Supplier;
}

const { supplier } = Astro.props;

// Format masked phone preview for Apollo-style paywall
const rawPhone = supplier.unmasked_direct_phone || '';
let maskedPhone = '+86-***-****-****';
if (rawPhone.length >= 11) {
  const digits = rawPhone.replace(/\D/g, '');
  if (digits.length >= 11) {
    maskedPhone = `+86-${digits.slice(0, 3)}-***-${digits.slice(-4)}`;
  }
}

// Split trust badges
const badges = supplier.trust_badges ? supplier.trust_badges.split(' | ') : [];

// Sample products array
const sampleProducts = supplier.sample_products ? supplier.sample_products.split(' | ') : [];

const districtNameMap: Record<string, string> = {
  '1': 'District 1 (Toys & Jewelry)',
  '2': 'District 2 (Hardware & Kitchen)',
  '3': 'District 3 (Stationery & Sports)',
  '4': 'District 4 (Footwear & Daily)',
  '5': 'District 5 (Home Textiles & Auto)',
  '6': 'Huangyuan Market (Apparel)'
};

const districtName = districtNameMap[supplier.district] || `District ${supplier.district || '1'}`;
---

<div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between group hover:border-blue-400">
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200/60">
          <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {districtName}
        </span>
      </div>

      <div class="flex items-center gap-1.5">
        {supplier.booth_no && (
          <span class="text-xs font-mono font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">
            Booth {supplier.booth_no}
          </span>
        )}
        <button 
          type="button"
          data-id={supplier.shop_id}
          data-name={supplier.clean_name || supplier.name}
          data-contact={supplier.contact_person || 'Stall Manager'}
          data-phone={supplier.unmasked_direct_phone}
          data-district={districtName}
          data-booth={supplier.booth_no}
          class="shortlist-toggle-btn p-1 rounded-lg border border-slate-200 bg-white text-slate-400 hover:text-amber-500 hover:border-amber-300 transition-colors cursor-pointer"
          title="Save to Sourcing List"
          aria-label="Save to Sourcing List"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
            <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Company Name -->
    <h3 class="text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 mb-1">
      {supplier.clean_name || supplier.name}
    </h3>

    {supplier.company_name && supplier.company_name !== supplier.clean_name && (
      <p class="text-xs text-slate-400 line-clamp-1 mb-2 font-medium">
        {supplier.company_name}
      </p>
    )}

    <!-- Physical Location Breakdown -->
    <div class="text-xs text-slate-600 mb-3 flex items-center flex-wrap gap-x-2 gap-y-1">
      {supplier.floor && <span class="bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200 text-slate-600">Floor {supplier.floor}</span>}
      {supplier.gate && <span class="bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200 text-slate-600">Gate {supplier.gate}</span>}
      {supplier.street && <span class="bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200 text-slate-600">Street {supplier.street}</span>}
    </div>

    <!-- Badges Row -->
    <div class="flex items-center flex-wrap gap-1.5 mb-4">
      {supplier.is_direct_factory === 'Yes' && (
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full">
          <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          Direct Factory
        </span>
      )}

      {supplier.years_in_futian >= 5 && (
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold bg-purple-50 text-purple-700 border border-purple-200 px-2 py-0.5 rounded-full">
          Veteran ({supplier.years_in_futian}Y)
        </span>
      )}

      {supplier.unmasked_direct_phone && (
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded-full">
          Direct Mobile Verified
        </span>
      )}
    </div>

    <!-- Sample Products Section -->
    {sampleProducts.length > 0 && (
      <div class="mb-4 bg-slate-50/80 rounded-xl p-2.5 border border-slate-100 text-xs">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1">
          Catalog Samples:
        </span>
        <div class="space-y-1">
          {sampleProducts.slice(0, 2).map(prod => (
            <p class="text-slate-700 truncate flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>
              <span class="truncate">{prod}</span>
            </p>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Apollo-Style Direct Contact Reveal Footer -->
  <div class="pt-3 border-t border-slate-100 mt-2">
    <div class="flex items-center justify-between mb-2.5">
      <div class="text-xs">
        <span class="text-slate-400 block text-[10px] font-semibold uppercase">Contact Person:</span>
        <span class="font-bold text-slate-800">{supplier.contact_person || 'Stall Manager'}</span>
      </div>
      <div class="text-xs text-right">
        <span class="text-slate-400 block text-[10px] font-semibold uppercase">Direct Mobile:</span>
        <span class="font-mono font-bold text-slate-500 flex items-center gap-1 justify-end">
          <svg class="w-3 h-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
          {maskedPhone}
        </span>
      </div>
    </div>

    <!-- Action Button Triggering Unlock Modal -->
    <button 
      type="button"
      data-unlock-id={supplier.shop_id}
      data-supplier-name={supplier.clean_name || supplier.name}
      data-contact-person={supplier.contact_person || 'Stall Manager'}
      data-phone={supplier.unmasked_direct_phone}
      data-intl-phone={supplier.international_mobile}
      data-district={districtName}
      data-booth={supplier.booth_no}
      class="unlock-contact-btn w-full py-2.5 px-3 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-xs shadow-sm hover:shadow transition-all flex items-center justify-center gap-2 cursor-pointer"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
      </svg>
      <span>Click to Reveal Direct Phone & WeChat</span>
    </button>
  </div>
</div>
