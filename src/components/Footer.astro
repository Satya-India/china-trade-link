---
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-sm">
  <!-- Partner Upsell Banner: The Two-Brand Flywheel -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border-b border-slate-800 py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400 shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <div>
          <h4 class="text-white font-bold text-base">Need Full-Container Consolidation & Global Shipping?</h4>
          <p class="text-xs text-slate-400">
            For multi-booth consolidation, factory warehousing, customs clearance, and door-to-port ocean freight, connect with our licensed logistics partner:
            <a href="https://www.yiwutradelink.com" target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:text-blue-300 font-semibold underline ml-1">
              Yiwu Trade Link (www.yiwutradelink.com)
            </a>
          </p>
        </div>
      </div>
      <a 
        href="https://www.yiwutradelink.com" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="shrink-0 px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-xs font-bold border border-slate-700 hover:border-slate-600 transition-colors"
      >
        Visit Yiwu Trade Link &rarr;
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand Info -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl overflow-hidden shadow-md shrink-0">
            <svg viewBox="0 0 48 48" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="48" height="48" rx="12" fill="url(#footCrestBg)"/>
              <path d="M24 5L39.5 10.8V23.2C39.5 33.2 32.7 41 24 43.5C15.3 41 8.5 33.2 8.5 23.2V10.8L24 5Z" fill="#0F172A" stroke="url(#footCrestRim)" stroke-width="2.8" stroke-linejoin="round"/>
              <path d="M30 16H19C16.8 16 15 17.8 15 20C15 22.2 16.8 24 19 24H29C31.2 24 33 25.8 33 28C33 30.2 31.2 32 29 32H18" stroke="url(#footSRibbonGrad)" stroke-width="4.2" stroke-linecap="round"/>
              <path d="M27.5 12.8L31.2 16L27.5 19.2" stroke="#38BDF8" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20.5 28.8L16.8 32L20.5 35.2" stroke="#FBBF24" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
              <defs>
                <linearGradient id="footCrestBg" x1="0" y1="0" x2="48" y2="48" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#1E293B"/>
                  <stop offset="1" stop-color="#0F172A"/>
                </linearGradient>
                <linearGradient id="footCrestRim" x1="8.5" y1="5" x2="39.5" y2="43.5" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#38BDF8"/>
                  <stop offset="0.5" stop-color="#10B981"/>
                  <stop offset="1" stop-color="#F59E0B"/>
                </linearGradient>
                <linearGradient id="footSRibbonGrad" x1="15" y1="16" x2="33" y2="32" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#FFFFFF"/>
                  <stop offset="0.48" stop-color="#38BDF8"/>
                  <stop offset="0.52" stop-color="#FBBF24"/>
                  <stop offset="1" stop-color="#F59E0B"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="text-base font-black text-white tracking-tight">
            Sino<span class="text-blue-400">Trade</span><span class="text-emerald-400">Link</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          The premier independent B2B China wholesale markets directory & sourcing intelligence network. Providing verified booth directories, 99.9% unmasked direct mobile numbers, and on-demand ground inspection services across China.
        </p>
        <div class="pt-2 text-xs text-slate-400">
          <span class="text-emerald-400 font-semibold">10,000+ Verified Suppliers</span> • Yiwu Futian Market Districts 1–5 & Huangyuan
        </div>
      </div>

      <!-- Col 2: Market Districts -->
      <div>
        <h5 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Market Districts</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="/directory?district=1" class="hover:text-white transition-colors">District 1: Toys, Plush & Jewelry (9,000 stalls)</a></li>
          <li><a href="/directory?district=2" class="hover:text-white transition-colors">District 2: Hardware & Kitchenware (10,000 stalls)</a></li>
          <li><a href="/directory?district=3" class="hover:text-white transition-colors">District 3: Stationery & Sports (7,000 stalls)</a></li>
          <li><a href="/directory?district=4" class="hover:text-white transition-colors">District 4: Footwear, Socks & Daily (16,000 stalls)</a></li>
          <li><a href="/directory?district=5" class="hover:text-white transition-colors">District 5: Home Textiles & Auto (7,000 stalls)</a></li>
          <li><a href="/directory?district=6" class="hover:text-white transition-colors">Huangyuan: Wholesale Garments & Jeans</a></li>
        </ul>
      </div>

      <!-- Col 3: Sourcing Solutions -->
      <div>
        <h5 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Directory Solutions</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="/category-packs#toys" class="hover:text-white transition-colors">Toys & Festival Crafts Pack ($29)</a></li>
          <li><a href="/category-packs#hardware" class="hover:text-white transition-colors">Tools & Kitchenware Pack ($39)</a></li>
          <li><a href="/category-packs#footwear" class="hover:text-white transition-colors">Socks, Footwear & Daily Pack ($49)</a></li>
          <li><a href="/category-packs#textiles" class="hover:text-white transition-colors">Home Textiles & Bedding Pack ($29)</a></li>
          <li><a href="/concierge" class="hover:text-white transition-colors">On-Demand Physical Stall Audit ($99)</a></li>
          <li><a href="/concierge#sample" class="hover:text-white transition-colors">Stall Sample Pickup & Parcel Dispatch ($149)</a></li>
          <li><a href="/sourcing-guide" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors">China Sourcing, OEM & Shipping Guide &rarr;</a></li>
          <li><a href="/market-map#specialized-streets" class="hover:text-white transition-colors">14 Yiwu Stock-Lot & Specialty Streets</a></li>
          <li class="pt-1"><a href="/for-suppliers" class="text-amber-400 hover:text-amber-300 font-semibold transition-colors">List Your Business / Factory &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 4: Anti-Piracy & Verification Notice -->
      <div>
        <h5 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Verified Data Standards</h5>
        <p class="text-xs text-slate-400 leading-relaxed mb-3">
          All numbers are direct Chinese mobile lines (13x, 15x, 18x, 19x) verified on-site in Futian Market. Zero masked asterisks.
        </p>
        <div class="p-3 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-slate-400">
          <strong class="text-slate-300">Anti-Piracy Policy:</strong> All digital spreadsheets include buyer cryptographic watermarking to ensure compliance with single-user business licensing.
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400">
      <p>&copy; 2026 Sino Trade Link (sinotradelink.com). All rights reserved. Strictly independent from trading brokerages.</p>
      <div class="flex items-center gap-4 mt-2 sm:mt-0">
        <span>Yiwu • Shenzhen • Guangzhou</span>
        <span>•</span>
        <span>Offline Markets Intelligence</span>
      </div>
    </div>
  </div>
</footer>
