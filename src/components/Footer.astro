---
const localeMatch = Astro.url.pathname.match(/^\/(es|pt|fr|de|ar|ru|it)(\/|$)/);
const localePrefix = localeMatch ? `/${localeMatch[1]}` : '';
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand Info -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <img src="/brand/logo-dark.svg" width="40" height="40" alt="" aria-hidden="true" class="shrink-0" />
          <span class="text-base font-black text-white tracking-tight">
            Sino Trade Link
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          The premier independent B2B China sourcing network. Browse 27,706+ verified stalls and let our bilingual team negotiate direct factory quotes anywhere in China.
        </p>
        <div class="pt-2 text-xs text-slate-400">
          <span class="text-emerald-400 font-semibold">10,000+ Verified Suppliers</span> • Yiwu Futian Market Districts 1–5 & Huangyuan
        </div>
      </div>

      <!-- Col 2: Market Districts -->
      <div>
        <h5 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Market Districts</h5>
        <ul class="space-y-2 text-xs">
          <li><a href={`${localePrefix}/directory?district=1`} class="hover:text-white transition-colors">District 1: Toys, Plush & Jewelry (9,000 stalls)</a></li>
          <li><a href={`${localePrefix}/directory?district=2`} class="hover:text-white transition-colors">District 2: Hardware & Kitchenware (10,000 stalls)</a></li>
          <li><a href={`${localePrefix}/directory?district=3`} class="hover:text-white transition-colors">District 3: Stationery & Sports (7,000 stalls)</a></li>
          <li><a href={`${localePrefix}/directory?district=4`} class="hover:text-white transition-colors">District 4: Footwear, Socks & Daily (16,000 stalls)</a></li>
          <li><a href={`${localePrefix}/directory?district=5`} class="hover:text-white transition-colors">District 5: Home Textiles & Auto (7,000 stalls)</a></li>
          <li><a href={`${localePrefix}/directory?district=6`} class="hover:text-white transition-colors">Huangyuan: Wholesale Garments & Jeans</a></li>
        </ul>
      </div>

      <!-- Col 3: Sourcing Solutions -->
      <div>
        <h5 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Sourcing Solutions</h5>
        <ul class="space-y-2 text-xs">
          <li><a href={`${localePrefix}/directory?factory=true`} class="hover:text-white transition-colors">Verified Direct China Factories</a></li>
          <li><a href="/sourcing-guide" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors">China Sourcing, OEM & Shipping Guide &rarr;</a></li>
          <li><a href="/market-map#specialized-streets" class="hover:text-white transition-colors">14 Yiwu Stock-Lot & Specialty Streets</a></li>
          <li class="pt-1"><a href="/for-suppliers" class="text-amber-400 hover:text-amber-300 font-semibold transition-colors">List Your Business / Factory &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div>
        <h5 class="text-white font-semibold text-xs uppercase tracking-wider mb-3">Contact</h5>
        <div class="space-y-2 text-xs">
          <p>Email: <a href="mailto:support@sinotradelink.com" class="hover:text-white transition-colors">support@sinotradelink.com</a></p>
          <p>WhatsApp: <a href="https://wa.me/8613482725985" target="_blank" rel="noopener" class="hover:text-white transition-colors">+86 134 8272 5985</a></p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Discrete SEO Corridors -->
    <div class="mt-8 pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400">
      <p>&copy; 2026 Sino Trade Link (sinotradelink.com). All rights reserved. Strictly independent from trading brokerages.</p>
      <div class="flex items-center gap-4 mt-2 sm:mt-0">
        <span>Yiwu • Shenzhen • Guangzhou • Ningbo</span>
        <span>•</span>
        <span>China-Wide Factory Sourcing</span>
      </div>
    </div>

    <!-- Discrete Small-Font SEO Corridor Index -->
    <div class="mt-4 pt-3 border-t border-slate-900/60 text-[10px] text-slate-600 leading-relaxed flex flex-wrap items-center gap-x-2 gap-y-1">
      <a href={`${localePrefix}/countries`} class="hover:text-slate-400 transition-colors">Global Trade Corridors:</a>
      <a href={`${localePrefix}/country/usa`} class="hover:text-slate-400 transition-colors">USA</a><span>·</span>
      <a href={`${localePrefix}/country/canada`} class="hover:text-slate-400 transition-colors">Canada</a><span>·</span>
      <a href={`${localePrefix}/country/brazil`} class="hover:text-slate-400 transition-colors">Brazil</a><span>·</span>
      <a href={`${localePrefix}/country/mexico`} class="hover:text-slate-400 transition-colors">Mexico</a><span>·</span>
      <a href={`${localePrefix}/country/uk`} class="hover:text-slate-400 transition-colors">UK</a><span>·</span>
      <a href={`${localePrefix}/country/germany`} class="hover:text-slate-400 transition-colors">Germany</a><span>·</span>
      <a href={`${localePrefix}/country/france`} class="hover:text-slate-400 transition-colors">France</a><span>·</span>
      <a href={`${localePrefix}/country/spain`} class="hover:text-slate-400 transition-colors">Spain</a><span>·</span>
      <a href={`${localePrefix}/country/italy`} class="hover:text-slate-400 transition-colors">Italy</a><span>·</span>
      <a href={`${localePrefix}/country/netherlands`} class="hover:text-slate-400 transition-colors">Netherlands</a><span>·</span>
      <a href={`${localePrefix}/country/poland`} class="hover:text-slate-400 transition-colors">Poland</a><span>·</span>
      <a href={`${localePrefix}/country/uae`} class="hover:text-slate-400 transition-colors">UAE</a><span>·</span>
      <a href={`${localePrefix}/country/saudi-arabia`} class="hover:text-slate-400 transition-colors">Saudi Arabia</a><span>·</span>
      <a href={`${localePrefix}/country/india`} class="hover:text-slate-400 transition-colors">India</a><span>·</span>
      <a href={`${localePrefix}/country/australia`} class="hover:text-slate-400 transition-colors">Australia</a><span>·</span>
      <a href={`${localePrefix}/country/south-africa`} class="hover:text-slate-400 transition-colors">South Africa</a><span>·</span>
      <a href={`${localePrefix}/country/nigeria`} class="hover:text-slate-400 transition-colors">Nigeria</a><span>·</span>
      <a href={`${localePrefix}/country/egypt`} class="hover:text-slate-400 transition-colors">Egypt</a><span>·</span>
      <a href={`${localePrefix}/country/kenya`} class="hover:text-slate-400 transition-colors">Kenya</a><span>·</span>
      <a href={`${localePrefix}/countries`} class="hover:text-slate-400 transition-colors">All 100 Countries</a>
    </div>
  </div>
</footer>
