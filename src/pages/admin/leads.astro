---
import '../../styles/global.css';
import { verifyAdminAuth } from '../../lib/admin-auth';

const isAuthorized = await verifyAdminAuth(Astro.request, Astro.url);
const currentKey = Astro.url.searchParams.get('key') || '';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lead & RFQ Operations Portal | SinoTradeLink</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      /* Fail-safe styles if JS or CSS is slow to load */
      .hidden { display: none !important; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        background-color: #0b0f19;
        color: #f1f5f9;
      }
      .glass-card {
        background: rgba(17, 24, 39, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(51, 65, 85, 0.6);
      }
      .glass-card-subtle {
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(51, 65, 85, 0.4);
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0b0f19] text-slate-100 selection:bg-amber-500 selection:text-slate-950 antialiased">

    <!-- Background Subtle Mesh Glow -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-b from-amber-500/10 via-blue-500/5 to-transparent blur-3xl opacity-70"></div>
    </div>

    <!-- ================= AUTH GATE ================= -->
    <div id="auth-gate" class={`relative z-10 min-h-screen flex items-center justify-center p-4 sm:p-6 ${isAuthorized ? 'hidden' : ''}`}>
      <div class="max-w-md w-full glass-card rounded-2xl p-6 sm:p-8 shadow-2xl relative border border-slate-800">
        
        <!-- Logo & Header -->
        <div class="flex items-center space-x-3.5 mb-6">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500 via-amber-600 to-amber-700 flex items-center justify-center text-slate-950 font-black text-lg shadow-lg shadow-amber-500/20">
            ST
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h1 class="text-xl font-bold tracking-tight text-white">SinoTradeLink</h1>
              <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full">Admin</span>
            </div>
            <p class="text-xs text-slate-400 mt-0.5">Wholesale Leads & RFQ Operations Hub</p>
          </div>
        </div>

        <div class="mb-6 bg-slate-900/60 rounded-xl p-4 border border-slate-800/80">
          <div class="flex items-start space-x-3">
            <div class="p-2 bg-amber-500/10 rounded-lg text-amber-400 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div>
              <h2 class="text-sm font-semibold text-white">Security Verification</h2>
              <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                Enter your administrative passkey to review verified buyer inquiries, contact unlocks, and stall RFQs.
              </p>
            </div>
          </div>
        </div>

        <!-- Login Form -->
        <form id="login-form" class="space-y-4">
          <div>
            <label for="passkey" class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
              Passkey
            </label>
            <div class="relative">
              <input
                type="password"
                id="passkey"
                name="passkey"
                value={currentKey}
                placeholder="Enter passkey..."
                required
                class="w-full pl-4 pr-11 py-3 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 text-sm font-mono transition"
              />
              <button
                type="button"
                id="toggle-passkey-visibility"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200 p-1"
                title="Toggle visibility"
              >
                <svg id="eye-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          </div>

          <div id="auth-error" class="hidden text-xs text-rose-300 bg-rose-950/60 border border-rose-800/80 rounded-xl p-3 flex items-center space-x-2">
            <svg class="w-4 h-4 text-rose-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Invalid passkey. Please check and try again.</span>
          </div>

          <button
            type="submit"
            id="unlock-btn"
            class="w-full py-3 px-4 bg-gradient-to-r from-amber-500 via-amber-600 to-amber-700 hover:from-amber-400 hover:to-amber-600 text-slate-950 font-bold rounded-xl text-sm transition shadow-lg shadow-amber-500/25 flex items-center justify-center space-x-2 cursor-pointer"
          >
            <span>Unlock Operations Dashboard</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-500">
          <span class="flex items-center space-x-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>Cloudflare D1 Protected</span>
          </span>
          <span class="font-mono text-slate-600">sinotradelink-db</span>
        </div>

      </div>
    </div>

    <!-- ================= MAIN DASHBOARD ================= -->
    <div id="dashboard" class={`relative z-10 ${isAuthorized ? '' : 'hidden'} min-h-screen flex flex-col`}>
      
      <!-- Top Executive Navigation Bar -->
      <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          
          <div class="flex items-center space-x-4">
            <a href="/" class="flex items-center space-x-3 group">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 via-amber-600 to-amber-700 flex items-center justify-center font-black text-slate-950 text-sm shadow shadow-amber-500/20 group-hover:scale-105 transition">
                ST
              </div>
              <div>
                <div class="flex items-center space-x-2">
                  <span class="text-base font-bold text-white tracking-tight">SinoTradeLink</span>
                  <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-md">
                    Ops Portal
                  </span>
                </div>
                <div class="flex items-center space-x-2 text-[10px] text-slate-400">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>Live Edge Sync</span>
                </div>
              </div>
            </a>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex items-center space-x-2.5">
            
            <a
              href="/"
              target="_blank"
              class="hidden sm:inline-flex items-center space-x-1 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 text-xs font-medium border border-slate-800 transition"
              title="Open Live Website"
            >
              <span>View Site</span>
              <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <button
              id="export-csv-btn"
              class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-md shadow-emerald-900/30 transition cursor-pointer"
              title="Download CSV for Excel & Google Sheets"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Export CSV</span>
            </button>

            <button
              id="refresh-btn"
              class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 text-xs font-medium border border-slate-800 transition cursor-pointer"
              title="Refresh Inquiries"
            >
              <svg id="refresh-icon" class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span class="hidden sm:inline">Refresh</span>
            </button>

            <button
              id="logout-btn"
              class="p-1.5 sm:px-3 sm:py-1.5 rounded-lg bg-slate-900 hover:bg-rose-950/40 text-slate-400 hover:text-rose-300 border border-slate-800 hover:border-rose-900/50 text-xs transition cursor-pointer"
              title="Sign Out / Lock"
            >
              <span class="hidden sm:inline">Lock</span>
              <svg class="w-4 h-4 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>

          </div>
        </div>
      </header>

      <!-- Main Page Container -->
      <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
        
        <!-- ================= KPI METRIC CARDS ================= -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          
          <div class="glass-card rounded-xl p-4 sm:p-5 border border-slate-800/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Leads</span>
              <div class="p-2 bg-slate-800/60 rounded-lg text-slate-300">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
            </div>
            <div id="kpi-total" class="text-2xl sm:text-3xl font-black text-white mt-2">0</div>
            <p class="text-[11px] text-slate-500 mt-1">Recorded buyer RFQs</p>
          </div>

          <div class="glass-card rounded-xl p-4 sm:p-5 border border-slate-800/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Pending Action</span>
              <div class="p-2 bg-amber-500/10 rounded-lg text-amber-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div id="kpi-pending" class="text-2xl sm:text-3xl font-black text-amber-400 mt-2">0</div>
            <p class="text-[11px] text-amber-500/70 mt-1">Awaiting quotation</p>
          </div>

          <div class="glass-card rounded-xl p-4 sm:p-5 border border-slate-800/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-blue-400">In Contact</span>
              <div class="p-2 bg-blue-500/10 rounded-lg text-blue-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
              </div>
            </div>
            <div id="kpi-contacted" class="text-2xl sm:text-3xl font-black text-blue-400 mt-2">0</div>
            <p class="text-[11px] text-blue-500/70 mt-1">Contacted & quoted</p>
          </div>

          <div class="glass-card rounded-xl p-4 sm:p-5 border border-slate-800/80 shadow-sm relative overflow-hidden">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Top Buyer Country</span>
              <div class="p-2 bg-emerald-500/10 rounded-lg text-emerald-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
                </svg>
              </div>
            </div>
            <div id="kpi-country" class="text-xl sm:text-2xl font-bold text-emerald-400 mt-2 truncate">Global</div>
            <p class="text-[11px] text-emerald-500/70 mt-1">Primary inquiry volume</p>
          </div>

        </div>

        <!-- ================= TOOLBAR & FILTERS ================= -->
        <div class="glass-card rounded-xl p-4 border border-slate-800/80 flex flex-col md:flex-row gap-3.5 items-stretch md:items-center justify-between">
          
          <!-- Search Bar -->
          <div class="relative flex-grow max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="search-input"
              placeholder="Search by buyer name, email, phone, booth, supplier..."
              class="w-full pl-10 pr-4 py-2 bg-slate-950/80 border border-slate-700/80 rounded-lg text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
            />
          </div>

          <!-- Status & District Filters -->
          <div class="flex flex-wrap items-center gap-2">
            
            <!-- Status Buttons -->
            <div class="inline-flex rounded-lg bg-slate-950/90 p-1 border border-slate-800 text-xs">
              <button data-filter="ALL" class="status-filter-btn px-2.5 sm:px-3 py-1 rounded-md bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30 transition cursor-pointer">
                All <span id="count-all" class="ml-1 text-[10px] opacity-80">(0)</span>
              </button>
              <button data-filter="PENDING" class="status-filter-btn px-2.5 sm:px-3 py-1 rounded-md text-slate-400 hover:text-white transition cursor-pointer">
                Pending <span id="count-pending" class="ml-1 text-[10px] opacity-80">(0)</span>
              </button>
              <button data-filter="CONTACTED" class="status-filter-btn px-2.5 sm:px-3 py-1 rounded-md text-slate-400 hover:text-white transition cursor-pointer">
                Contacted
              </button>
              <button data-filter="QUOTED" class="status-filter-btn px-2.5 sm:px-3 py-1 rounded-md text-slate-400 hover:text-white transition cursor-pointer">
                Quoted
              </button>
              <button data-filter="COMPLETED" class="status-filter-btn px-2.5 sm:px-3 py-1 rounded-md text-slate-400 hover:text-white transition cursor-pointer">
                Done
              </button>
            </div>

            <!-- District Dropdown -->
            <select id="district-filter" class="bg-slate-950/90 border border-slate-800 text-slate-300 text-xs rounded-lg px-3 py-1.5 focus:outline-none focus:border-amber-500 cursor-pointer">
              <option value="">All Sourcing Corridors</option>
              <option value="District 1">District 1 (Toys & Jewelry)</option>
              <option value="District 2">District 2 (Hardware & Kitchen)</option>
              <option value="District 3">District 3 (Stationery & Sports)</option>
              <option value="District 4">District 4 (Footwear & Daily)</option>
              <option value="District 5">District 5 (Textiles & Bedding)</option>
              <option value="District 6">District 6 (Huangyuan Garments)</option>
              <option value="District 7">District 7 (Production Materials)</option>
              <option value="GENERAL">General Concierge / RFQ</option>
            </select>

          </div>

        </div>

        <!-- ================= LEADS TABLE CONTAINER ================= -->
        <div class="glass-card rounded-xl border border-slate-800/80 overflow-hidden shadow-xl">
          
          <!-- Loading Spinner -->
          <div id="loading-state" class="p-16 text-center text-slate-400">
            <div class="inline-block animate-spin w-8 h-8 border-2 border-amber-500 border-t-transparent rounded-full mb-3"></div>
            <p class="text-sm font-medium text-slate-300">Synchronizing with Cloudflare D1...</p>
            <p class="text-xs text-slate-500 mt-1 font-mono">Querying inquiries & joined booth directory</p>
          </div>

          <!-- Empty State -->
          <div id="empty-state" class="hidden p-16 text-center">
            <div class="w-14 h-14 rounded-2xl bg-slate-800/60 border border-slate-700/60 text-slate-400 mx-auto flex items-center justify-center mb-4 shadow-inner">
              <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-white">No Inquiries Found</h3>
            <p class="text-xs sm:text-sm text-slate-400 mt-1.5 max-w-md mx-auto leading-relaxed">
              When international buyers request factory quotations or unlock direct stall phone numbers, leads appear here with complete stall coordinates.
            </p>
            <div class="mt-5 flex items-center justify-center space-x-3">
              <button id="send-test-lead-btn" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold rounded-lg text-xs shadow-md shadow-amber-500/20 transition cursor-pointer">
                Create Sample Inquiry
              </button>
              <a href="/directory" target="_blank" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold border border-slate-700 transition">
                Browse Directory
              </a>
            </div>
          </div>

          <!-- Table View -->
          <div id="table-container" class="hidden overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="bg-slate-950/90 border-b border-slate-800 text-slate-400 uppercase tracking-wider font-semibold text-[11px]">
                  <th class="py-3.5 px-4">Status & Time</th>
                  <th class="py-3.5 px-4">Buyer Identity</th>
                  <th class="py-3.5 px-4">Target Stall / Sourcing Match</th>
                  <th class="py-3.5 px-4">RFQ Specifications</th>
                  <th class="py-3.5 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="leads-tbody" class="divide-y divide-slate-800/80">
                <!-- Dynamically populated via JS -->
              </tbody>
            </table>
          </div>

        </div>

      </main>

      <!-- Operations Footer -->
      <footer class="border-t border-slate-800/80 py-4 mt-8 bg-slate-950/60">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-2">
          <div class="flex items-center space-x-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>SinoTradeLink Operations Engine</span>
            <span>·</span>
            <span class="font-mono text-slate-400">Cloudflare D1 (sinotradelink-db)</span>
          </div>
          <div>
            <span class="text-slate-500">Access: </span>
            <span class="px-2 py-0.5 bg-slate-900 border border-slate-800 rounded font-mono text-emerald-400 text-[10px]">Restricted · Strict Access</span>
          </div>
        </div>
      </footer>

    </div>

    <!-- ================= INQUIRY DETAIL MODAL ================= -->
    <div id="lead-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm">
      <div class="glass-card max-w-xl w-full rounded-2xl p-6 border border-slate-800 shadow-2xl space-y-4 relative">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div class="flex items-center space-x-2">
            <span class="text-base font-bold text-white" id="modal-title">Inquiry Details</span>
            <span id="modal-status-badge"></span>
          </div>
          <button id="modal-close-btn" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 text-lg leading-none cursor-pointer">
            &times;
          </button>
        </div>

        <div class="space-y-3 text-xs" id="modal-content">
          <!-- Injected via JavaScript -->
        </div>

        <div class="pt-3 border-t border-slate-800 flex justify-end space-x-2">
          <button id="modal-close-btn-bottom" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-semibold cursor-pointer">
            Close
          </button>
        </div>
      </div>
    </div>

    <!-- ================= CLIENT JAVASCRIPT ================= -->
    <script is:inline>
      let adminKey = localStorage.getItem('sino_admin_key') || '';
      let allLeads = [];
      let currentFilter = 'ALL';
      let currentDistrict = '';
      let searchQuery = '';

      const authGate = document.getElementById('auth-gate');
      const dashboard = document.getElementById('dashboard');
      const loginForm = document.getElementById('login-form');
      const passkeyInput = document.getElementById('passkey');
      const authError = document.getElementById('auth-error');
      const exportCsvBtn = document.getElementById('export-csv-btn');
      const refreshBtn = document.getElementById('refresh-btn');
      const refreshIcon = document.getElementById('refresh-icon');
      const logoutBtn = document.getElementById('logout-btn');
      const loadingState = document.getElementById('loading-state');
      const emptyState = document.getElementById('empty-state');
      const tableContainer = document.getElementById('table-container');
      const leadsTbody = document.getElementById('leads-tbody');
      const searchInput = document.getElementById('search-input');
      const districtFilter = document.getElementById('district-filter');
      const statusFilterBtns = document.querySelectorAll('.status-filter-btn');
      const sendTestLeadBtn = document.getElementById('send-test-lead-btn');
      const togglePasskeyVisibility = document.getElementById('toggle-passkey-visibility');

      // Modal elements
      const leadModal = document.getElementById('lead-modal');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalCloseBtnBottom = document.getElementById('modal-close-btn-bottom');

      // Check URL param first
      const urlParams = new URLSearchParams(window.location.search);
      const keyFromUrl = urlParams.get('key');
      if (keyFromUrl) {
        adminKey = keyFromUrl;
        localStorage.setItem('sino_admin_key', adminKey);
        document.cookie = `admin_key=${encodeURIComponent(adminKey)}; Path=/; Max-Age=2592000; SameSite=Lax`;
      }

      function init() {
        if (adminKey) {
          fetchLeads();
        } else {
          showAuthGate();
        }
      }

      function showAuthGate() {
        authGate.classList.remove('hidden');
        dashboard.classList.add('hidden');
      }

      function showDashboard() {
        authGate.classList.add('hidden');
        dashboard.classList.remove('hidden');
      }

      // Password visibility toggle
      if (togglePasskeyVisibility) {
        togglePasskeyVisibility.addEventListener('click', () => {
          if (passkeyInput.type === 'password') {
            passkeyInput.type = 'text';
          } else {
            passkeyInput.type = 'password';
          }
        });
      }


      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const candidateKey = passkeyInput.value.trim();
        if (!candidateKey) return;

        authError.classList.add('hidden');
        const btn = document.getElementById('unlock-btn');
        btn.disabled = true;
        btn.innerText = 'Verifying with Edge...';

        try {
          const res = await fetch(`/api/admin/leads?key=${encodeURIComponent(candidateKey)}`);
          if (res.ok) {
            adminKey = candidateKey;
            localStorage.setItem('sino_admin_key', adminKey);
            document.cookie = `admin_key=${encodeURIComponent(adminKey)}; Path=/; Max-Age=2592000; SameSite=Lax`;
            showDashboard();
            fetchLeads();
          } else {
            authError.classList.remove('hidden');
          }
        } catch (err) {
          authError.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.innerHTML = '<span>Unlock Operations Dashboard</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>';
        }
      });

      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('sino_admin_key');
        document.cookie = 'admin_key=; Path=/; Max-Age=0;';
        adminKey = '';
        passkeyInput.value = '';
        showAuthGate();
      });

      refreshBtn.addEventListener('click', () => {
        refreshIcon.classList.add('animate-spin');
        fetchLeads().finally(() => {
          setTimeout(() => refreshIcon.classList.remove('animate-spin'), 600);
        });
      });

      exportCsvBtn.addEventListener('click', () => {
        const downloadUrl = `/api/admin/export.csv?key=${encodeURIComponent(adminKey)}`;
        window.open(downloadUrl, '_blank');
      });

      async function fetchLeads() {
        loadingState.classList.remove('hidden');
        emptyState.classList.add('hidden');
        tableContainer.classList.add('hidden');

        try {
          const res = await fetch(`/api/admin/leads?key=${encodeURIComponent(adminKey)}`);
          if (res.status === 401) {
            showAuthGate();
            authError.classList.remove('hidden');
            return;
          }

          const data = await res.json();
          if (data.success) {
            allLeads = data.leads || [];
            updateKpis(allLeads);
            renderLeads();
            showDashboard();
          } else {
            alert('Error loading leads: ' + (data.error || 'Unknown'));
          }
        } catch (err) {
          console.error('Fetch leads error:', err);
        } finally {
          loadingState.classList.add('hidden');
        }
      }

      function updateKpis(leads) {
        document.getElementById('kpi-total').innerText = leads.length;
        const pendingCount = leads.filter(l => (l.status || 'PENDING') === 'PENDING').length;
        document.getElementById('kpi-pending').innerText = pendingCount;
        const contactedCount = leads.filter(l => ['CONTACTED', 'QUOTED'].includes(l.status)).length;
        document.getElementById('kpi-contacted').innerText = contactedCount;

        // Update counts in filter buttons
        const countAllEl = document.getElementById('count-all');
        const countPendingEl = document.getElementById('count-pending');
        if (countAllEl) countAllEl.innerText = `(${leads.length})`;
        if (countPendingEl) countPendingEl.innerText = `(${pendingCount})`;

        // Country breakdown
        const countries = {};
        leads.forEach(l => {
          const c = l.buyerCountry || 'Global';
          countries[c] = (countries[c] || 0) + 1;
        });
        const topCountry = Object.keys(countries).sort((a,b) => countries[b] - countries[a])[0] || 'Global';
        document.getElementById('kpi-country').innerText = topCountry;
      }

      function renderLeads() {
        let filtered = allLeads.slice();

        // Status Filter
        if (currentFilter !== 'ALL') {
          filtered = filtered.filter(l => (l.status || 'PENDING') === currentFilter);
        }

        // District Filter
        if (currentDistrict) {
          if (currentDistrict === 'GENERAL') {
            filtered = filtered.filter(l => !l.supplierDistrict || l.shopId === 'GENERAL');
          } else {
            filtered = filtered.filter(l => (l.supplierDistrict || '').includes(currentDistrict));
          }
        }

        // Search Filter
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          filtered = filtered.filter(l => 
            (l.buyerName && l.buyerName.toLowerCase().includes(q)) ||
            (l.buyerEmail && l.buyerEmail.toLowerCase().includes(q)) ||
            (l.buyerPhone && l.buyerPhone.toLowerCase().includes(q)) ||
            (l.targetBooth && l.targetBooth.toLowerCase().includes(q)) ||
            (l.supplierName && l.supplierName.toLowerCase().includes(q)) ||
            (l.message && l.message.toLowerCase().includes(q)) ||
            (l.buyerCountry && l.buyerCountry.toLowerCase().includes(q))
          );
        }

        if (filtered.length === 0) {
          tableContainer.classList.add('hidden');
          emptyState.classList.remove('hidden');
          return;
        }

        emptyState.classList.add('hidden');
        tableContainer.classList.remove('hidden');

        leadsTbody.innerHTML = filtered.map(lead => {
          const statusBadge = getStatusBadge(lead.status || 'PENDING');
          const cleanPhone = (lead.buyerPhone || '').replace(/[^\d+]/g, '');
          const waUrl = cleanPhone ? `https://wa.me/${cleanPhone.replace('+', '')}?text=${encodeURIComponent(`Hi ${lead.buyerName}, regarding your inquiry on SinoTradeLink for Booth ${lead.targetBooth}...`)}` : '';
          const initials = (lead.buyerName || 'B').split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();

          return `
            <tr class="hover:bg-slate-800/40 transition">
              <td class="py-3.5 px-4 align-top whitespace-nowrap">
                <div class="flex items-center space-x-2 mb-1.5">
                  ${statusBadge}
                </div>
                <div class="text-[11px] text-slate-400 font-mono">
                  ${formatDate(lead.createdAt)}
                </div>
                <div class="mt-2.5">
                  <select onchange="updateLeadStatus('${lead.id}', this.value)" class="bg-slate-950 border border-slate-700 text-slate-300 text-[10px] rounded px-2 py-1 focus:outline-none focus:border-amber-500 cursor-pointer">
                    <option value="PENDING" ${lead.status === 'PENDING' ? 'selected' : ''}>Pending</option>
                    <option value="CONTACTED" ${lead.status === 'CONTACTED' ? 'selected' : ''}>Contacted</option>
                    <option value="QUOTED" ${lead.status === 'QUOTED' ? 'selected' : ''}>Quoted</option>
                    <option value="COMPLETED" ${lead.status === 'COMPLETED' ? 'selected' : ''}>Completed</option>
                    <option value="ARCHIVED" ${lead.status === 'ARCHIVED' ? 'selected' : ''}>Archived</option>
                  </select>
                </div>
              </td>

              <td class="py-3.5 px-4 align-top">
                <div class="flex items-start space-x-2.5">
                  <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 text-amber-400 font-bold flex items-center justify-center text-xs flex-shrink-0 mt-0.5">
                    ${initials}
                  </div>
                  <div>
                    <div class="font-bold text-slate-100 text-sm">${escapeHtml(lead.buyerName)}</div>
                    <a href="mailto:${escapeHtml(lead.buyerEmail)}" class="text-blue-400 hover:text-blue-300 hover:underline block text-xs mt-0.5">
                      ${escapeHtml(lead.buyerEmail)}
                    </a>
                    <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
                      <span class="inline-flex items-center px-2 py-0.5 bg-slate-900 rounded text-[10px] text-slate-300 border border-slate-800">
                        🌍 ${escapeHtml(lead.buyerCountry || 'Global')}
                      </span>
                      ${lead.buyerPhone ? `
                        <span class="inline-flex items-center px-2 py-0.5 bg-slate-900 rounded text-[10px] text-amber-300 font-mono border border-slate-800">
                          📱 ${escapeHtml(lead.buyerPhone)}
                        </span>
                      ` : ''}
                    </div>
                  </div>
                </div>
              </td>

              <td class="py-3.5 px-4 align-top">
                ${lead.targetBooth ? `
                  <div class="flex items-center space-x-1.5">
                    <span class="px-2.5 py-0.5 bg-amber-500/20 text-amber-300 font-mono font-bold rounded text-[11px] border border-amber-500/30">
                      Booth ${escapeHtml(lead.targetBooth)}
                    </span>
                  </div>
                ` : '<span class="px-2 py-0.5 bg-slate-800 text-slate-400 rounded text-[10px] font-medium">General Concierge RFQ</span>'}
                
                ${lead.supplierName ? `
                  <div class="font-semibold text-slate-200 mt-1.5 line-clamp-1">${escapeHtml(lead.supplierName)}</div>
                  <div class="text-[11px] text-slate-400">
                    ${escapeHtml(lead.supplierDistrict || '')} ${lead.supplierFloor ? '· Floor ' + escapeHtml(lead.supplierFloor) : ''}
                  </div>
                  ${lead.supplierPhone ? `
                    <div class="text-[11px] text-emerald-400 font-mono mt-1 font-semibold flex items-center space-x-1">
                      <span>📞 Direct: ${escapeHtml(lead.supplierPhone)}</span>
                      <span class="text-slate-500 font-normal">(${escapeHtml(lead.supplierContact || 'Owner')})</span>
                    </div>
                  ` : ''}
                ` : ''}

                ${lead.shopId && lead.shopId !== 'GENERAL' ? `
                  <a href="/supplier/${lead.shopId}" target="_blank" class="inline-flex items-center space-x-1 text-[11px] text-amber-400 hover:text-amber-300 hover:underline mt-1.5 font-medium">
                    <span>View Stall Profile</span>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                ` : ''}
              </td>

              <td class="py-3.5 px-4 align-top max-w-xs">
                <div class="p-3 bg-slate-950 rounded-xl border border-slate-800/80 text-slate-300 text-xs leading-relaxed max-h-28 overflow-y-auto whitespace-pre-wrap">
                  ${escapeHtml(lead.message || 'No additional message provided.')}
                </div>
                <button onclick="openLeadModal('${lead.id}')" class="text-[10px] text-slate-400 hover:text-amber-400 mt-1.5 font-medium underline underline-offset-2 cursor-pointer">
                  Expand full specifications &rarr;
                </button>
              </td>

              <td class="py-3.5 px-4 align-top text-right whitespace-nowrap space-y-1.5">
                ${waUrl ? `
                  <div>
                    <a href="${waUrl}" target="_blank" class="inline-flex items-center space-x-1 px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold shadow-sm transition">
                      <span>WhatsApp</span>
                    </a>
                  </div>
                ` : ''}
                <div>
                  <a href="mailto:${escapeHtml(lead.buyerEmail)}?subject=${encodeURIComponent('Regarding your SinoTradeLink Wholesale Sourcing Inquiry')}" class="inline-flex items-center space-x-1 px-3 py-1 bg-blue-600 hover:bg-blue-500 text-white rounded-lg text-xs font-semibold shadow-sm transition">
                    <span>Email</span>
                  </a>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      function getStatusBadge(status) {
        switch(status) {
          case 'PENDING':
            return '<span class="inline-flex items-center space-x-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse mr-1"></span>PENDING</span>';
          case 'CONTACTED':
            return '<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/40">CONTACTED</span>';
          case 'QUOTED':
            return '<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/40">QUOTED</span>';
          case 'COMPLETED':
            return '<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">COMPLETED</span>';
          case 'ARCHIVED':
            return '<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">ARCHIVED</span>';
          default:
            return `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-300">${status}</span>`;
        }
      }

      function formatDate(dateStr) {
        if (!dateStr) return '';
        try {
          const d = new Date(dateStr);
          return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        } catch {
          return dateStr;
        }
      }

      function escapeHtml(text) {
        if (!text) return '';
        return String(text)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      window.openLeadModal = function(id) {
        const lead = allLeads.find(l => l.id === id);
        if (!lead) return;

        document.getElementById('modal-title').innerText = `RFQ: ${lead.buyerName}`;
        document.getElementById('modal-status-badge').innerHTML = getStatusBadge(lead.status || 'PENDING');

        const content = document.getElementById('modal-content');
        content.innerHTML = `
          <div class="grid grid-cols-2 gap-3 bg-slate-900 p-3 rounded-xl border border-slate-800">
            <div>
              <span class="text-slate-400 text-[10px] uppercase font-bold block">Buyer Email</span>
              <a href="mailto:${escapeHtml(lead.buyerEmail)}" class="text-blue-400 hover:underline font-medium">${escapeHtml(lead.buyerEmail)}</a>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase font-bold block">Phone / WhatsApp</span>
              <span class="text-slate-200 font-mono">${escapeHtml(lead.buyerPhone || 'Not provided')}</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase font-bold block">Buyer Country</span>
              <span class="text-slate-200">${escapeHtml(lead.buyerCountry || 'Global')}</span>
            </div>
            <div>
              <span class="text-slate-400 text-[10px] uppercase font-bold block">Target Stall</span>
              <span class="text-amber-400 font-semibold font-mono">${escapeHtml(lead.targetBooth || 'General Inquiry')}</span>
            </div>
          </div>

          ${lead.supplierName ? `
            <div class="bg-slate-900 p-3 rounded-xl border border-slate-800">
              <span class="text-slate-400 text-[10px] uppercase font-bold block mb-1">Supplier Intelligence</span>
              <div class="font-bold text-slate-100">${escapeHtml(lead.supplierName)}</div>
              <div class="text-emerald-400 font-mono mt-0.5">Direct Mobile: ${escapeHtml(lead.supplierPhone)} (${escapeHtml(lead.supplierContact || 'Owner')})</div>
            </div>
          ` : ''}

          <div>
            <span class="text-slate-400 text-[10px] uppercase font-bold block mb-1">Full Inquiry Details & Requirements</span>
            <div class="p-3 bg-slate-950 rounded-xl border border-slate-800 text-slate-200 leading-relaxed whitespace-pre-wrap text-xs">
              ${escapeHtml(lead.rawMessage || lead.message)}
            </div>
          </div>
        `;

        leadModal.classList.remove('hidden');
      };

      if (modalCloseBtn) modalCloseBtn.addEventListener('click', () => leadModal.classList.add('hidden'));
      if (modalCloseBtnBottom) modalCloseBtnBottom.addEventListener('click', () => leadModal.classList.add('hidden'));
      if (leadModal) {
        leadModal.addEventListener('click', (e) => {
          if (e.target === leadModal) leadModal.classList.add('hidden');
        });
      }

      window.updateLeadStatus = async function(id, newStatus) {
        try {
          const res = await fetch(`/api/admin/leads?key=${encodeURIComponent(adminKey)}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, status: newStatus })
          });
          const data = await res.json();
          if (data.success) {
            const target = allLeads.find(l => l.id === id);
            if (target) target.status = newStatus;
            updateKpis(allLeads);
            renderLeads();
          } else {
            alert('Failed to update status: ' + (data.error || 'Unknown error'));
          }
        } catch (err) {
          alert('Error communicating with server.');
        }
      };

      // Filter events
      statusFilterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          statusFilterBtns.forEach(b => {
            b.classList.remove('bg-amber-500/20', 'text-amber-300', 'font-semibold', 'border', 'border-amber-500/30');
            b.classList.add('text-slate-400');
          });
          btn.classList.add('bg-amber-500/20', 'text-amber-300', 'font-semibold', 'border', 'border-amber-500/30');
          btn.classList.remove('text-slate-400');
          currentFilter = btn.dataset.filter;
          renderLeads();
        });
      });

      districtFilter.addEventListener('change', (e) => {
        currentDistrict = e.target.value;
        renderLeads();
      });

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim();
        renderLeads();
      });

      if (sendTestLeadBtn) {
        sendTestLeadBtn.addEventListener('click', async () => {
          sendTestLeadBtn.disabled = true;
          sendTestLeadBtn.innerText = 'Submitting sample inquiry...';
          try {
            const testPayload = {
              shop_id: '6166453',
              buyer_name: 'David Sterling',
              buyer_email: 'david@sterling-imports.com',
              buyer_country: 'United States',
              phone: '+1 415 890 1234',
              target_booth: '103240B',
              service_type: 'Full Container Load (FCL)',
              message: 'Requesting wholesale catalog and factory FOB Ningbo price list for stainless steel vacuum flasks (500ml & 750ml). Initial order 2,000 units with custom silkscreen logo.'
            };

            const res = await fetch('/api/inquiry', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(testPayload)
            });

            const data = await res.json();
            if (data.success) {
              await fetchLeads();
            } else {
              alert('Failed to create sample lead: ' + data.error);
            }
          } catch (err) {
            alert('Network error while creating sample lead.');
          } finally {
            sendTestLeadBtn.disabled = false;
            sendTestLeadBtn.innerText = 'Create Sample Inquiry';
          }
        });
      }

      // Start
      init();
    </script>
  </body>
</html>
