---
import Layout from '../layouts/Layout.astro';
import SupplierCard from '../components/SupplierCard.astro';
import ContactUnlockModal from '../components/ContactUnlockModal.astro';
import { getStats, getFeaturedSuppliers } from '../lib/data';
import { WHOLESALE_MARKETS, CATEGORY_PACKS, CONCIERGE_SERVICES } from '../lib/markets';

const stats = await getStats();
const featuredSuppliers = await getFeaturedSuppliers(8);
---

<Layout title="Sino Trade Link | 20,000+ Verified China Wholesale Market Suppliers & Direct Contacts" activePage="home">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-16 pb-24 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/30 via-transparent to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-xs font-bold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>The Apollo & ImportYeti for Physical Chinese Wholesale Markets</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight sm:leading-none">
        Source Directly from <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-300 bg-clip-text text-transparent">Physical Factory Stalls</span> in China.
      </h1>

      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Bypass trading agents and 30% trading markups. Access <strong class="text-white font-semibold">{stats.totalSuppliers.toLocaleString()}+ verified stalls</strong> across Yiwu Futian & Huangyuan Wholesale Markets with real, unmasked Chinese mobile numbers.
      </p>

      <!-- Search Bar -->
      <div class="mt-8 max-w-2xl mx-auto">
        <form action="/directory" method="GET" class="relative flex items-center bg-white rounded-2xl p-2 shadow-2xl border border-slate-200">
          <div class="pl-3 pr-2 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            name="q" 
            placeholder="Search by product, category, or stall name (e.g. Toys, Kitchenware, Booth 62159)..." 
            class="w-full py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none bg-transparent"
          />
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors shrink-0"
          >
            Search Directory
          </button>
        </form>
        <div class="flex items-center justify-center gap-2 mt-3 text-xs text-slate-400">
          <span>Popular searches:</span>
          <a href="/directory?q=toy" class="hover:text-white underline decoration-slate-600">Toys</a>
          <span>•</span>
          <a href="/directory?q=hardware" class="hover:text-white underline decoration-slate-600">Hardware</a>
          <span>•</span>
          <a href="/directory?q=kitchen" class="hover:text-white underline decoration-slate-600">Kitchenware</a>
          <span>•</span>
          <a href="/directory?q=socks" class="hover:text-white underline decoration-slate-600">Socks</a>
          <span>•</span>
          <a href="/directory?q=textile" class="hover:text-white underline decoration-slate-600">Bedding</a>
        </div>
      </div>

      <!-- Live Metric Badges Grid -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-white">{stats.totalSuppliers.toLocaleString()}+</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Verified Stalls Ingested</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400">{stats.phoneCoverageRate}%</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Unmasked Direct Mobiles</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-amber-400">{stats.directFactories.toLocaleString()}</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Licensed Factories</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-blue-400">0%</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Trading Markups</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Market District Breakdown Section -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">
            Yiwu Futian International Trade City
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Browse by Wholesale Market District
          </h2>
          <p class="text-sm text-slate-600 mt-1 max-w-xl">
            Futian Market is divided into 5 interconnected mega-districts plus Huangyuan Market. Filter suppliers by their exact physical coordinates.
          </p>
        </div>
        <a 
          href="/directory" 
          class="mt-4 md:mt-0 inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700"
        >
          View all market stalls &rarr;
        </a>
      </div>

      <!-- District Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {WHOLESALE_MARKETS.map(market => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all hover:border-blue-400 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
                  {market.boothCount}
                </span>
                <span class="text-xs font-medium text-slate-400 font-mono">
                  {market.chineseName}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                {market.name}
              </h3>

              <p class="text-xs text-slate-600 line-clamp-2 mb-4 leading-relaxed">
                {market.description}
              </p>

              <!-- Floor Categories -->
              <div class="space-y-1.5 pt-3 border-t border-slate-100 mb-6">
                {market.floors.slice(0, 3).map(f => (
                  <div class="text-xs flex items-center justify-between text-slate-600">
                    <span class="font-bold text-slate-800">Floor {f.floor}:</span>
                    <span class="text-[11px] text-slate-500 truncate max-w-[180px]">{f.categories.join(', ')}</span>
                  </div>
                ))}
              </div>
            </div>

            <a 
              href={`/directory?district=${market.id.replace('district-', '')}`}
              class="w-full py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-800 font-bold text-xs text-center transition-colors block"
            >
              Explore {market.name} Stalls &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Verified Stalls Section -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">
            Hand-Picked Verified Profiles
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Top Direct Factories & Veteran Suppliers
          </h2>
          <p class="text-sm text-slate-600 mt-1 max-w-xl">
            Every stall profile features 100% genuine unmasked Chinese mobile numbers, physical stall street addresses, and verified booth numbers.
          </p>
        </div>
        <a 
          href="/directory" 
          class="mt-4 md:mt-0 px-4 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold text-xs rounded-xl border border-blue-200 transition-colors"
        >
          Browse All {stats.totalSuppliers.toLocaleString()} Stalls
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {featuredSuppliers.map(s => (
          <SupplierCard supplier={s} />
        ))}
      </div>
    </div>
  </section>

  <!-- Category Packs Showcase Section ($29–$49) -->
  <section class="py-16 bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block mb-1">
          Instant Excel & CSV Downloads
        </span>
        <h2 class="text-3xl font-black text-white tracking-tight">
          Niche Category Directory Packs
        </h2>
        <p class="text-sm text-slate-400 mt-2">
          Rather than buying an expensive generic database, get targeted, category-specific direct contact sheets with unmasked numbers and booth navigation coordinates.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {CATEGORY_PACKS.slice(0, 3).map(pack => (
          <div class={`rounded-2xl border p-6 flex flex-col justify-between ${pack.popular ? 'bg-gradient-to-b from-slate-800 to-slate-900 border-amber-500/50 shadow-xl shadow-amber-500/10' : 'bg-slate-800/60 border-slate-700'}`}>
            <div>
              {pack.popular && (
                <span class="inline-block bg-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full mb-3">
                  Most Popular
                </span>
              )}
              <span class="text-xs font-bold text-blue-400 block">{pack.district}</span>
              <h3 class="text-lg font-bold text-white mt-1 mb-2">{pack.title}</h3>
              <p class="text-xs text-slate-400 leading-relaxed mb-4">{pack.description}</p>

              <div class="flex items-baseline gap-2 mb-6">
                <span class="text-3xl font-black text-white">${pack.price}</span>
                <span class="text-sm text-slate-500 line-through">${pack.originalPrice}</span>
                <span class="text-xs text-emerald-400 font-semibold ml-auto">{pack.supplierCount}</span>
              </div>

              <ul class="space-y-2 text-xs text-slate-300 border-t border-slate-700/60 pt-4 mb-6">
                {pack.features.map(f => (
                  <li class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a 
              href="/category-packs" 
              class={`w-full py-3 rounded-xl font-bold text-xs text-center transition-all ${pack.popular ? 'bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-lg shadow-amber-500/20' : 'bg-blue-600 hover:bg-blue-500 text-white'}`}
            >
              Get Directory Pack (${pack.price}) &rarr;
            </a>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/category-packs" class="text-xs font-bold text-slate-400 hover:text-white underline">
          View all 6 category directory packs &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- On-Demand Ground Concierge & Inspection Section ($99–$299) -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">
          Ground Verification In Yiwu
        </span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight">
          Can't Fly to China? We Walk the Market for You.
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Order an on-demand physical stall visit. Our bilingual local agents inspect the booth, take 4K video walkthroughs, and collect physical product samples.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {CONCIERGE_SERVICES.map(svc => (
          <div class={`rounded-2xl border p-6 flex flex-col justify-between ${svc.recommended ? 'bg-blue-50/50 border-blue-300 shadow-md' : 'bg-slate-50 border-slate-200'}`}>
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-blue-600">{svc.turnaround}</span>
                {svc.recommended && (
                  <span class="bg-blue-600 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                    Recommended
                  </span>
                )}
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2">{svc.title}</h3>
              <p class="text-xs text-slate-600 mb-4 leading-relaxed">{svc.description}</p>
              <div class="text-2xl font-black text-slate-900 mb-4">${svc.price} <span class="text-xs font-normal text-slate-500">flat fee</span></div>

              <div class="space-y-2 text-xs text-slate-700 border-t border-slate-200 pt-4 mb-6">
                <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Included:</span>
                {svc.deliverables.map(d => (
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 shrink-0"></span>
                    <span>{d}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="space-y-2">
              <a 
                href={`/concierge?service=${svc.id}`} 
                class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs text-center transition-colors block"
              >
                Book Service (${svc.price}) &rarr;
              </a>
              <a
                href={`https://wa.me/8613482725985?text=${encodeURIComponent(`Hi SinoTradeLink, I want to inquire about your ${svc.title} ($${svc.price}). Can you help me inspect suppliers in Yiwu?`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold text-[11px] text-center transition-colors flex items-center justify-center gap-1.5"
              >
                <span>WhatsApp Liaison</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sourcing Playbook, Freight Calculator & 14 Stock-Lot Streets Section -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 block mb-1">
            Free Buyer Intelligence & Calculators
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Master Yiwu Sourcing, OEM Manufacturing & China Freight
          </h2>
          <p class="text-sm text-slate-600 mt-1 max-w-2xl">
            Stop losing 5%–10% of every order to opaque sourcing brokerages. Explore our field-tested guides on China-to-US shipping costs, OEM private-label tooling, and Yiwu's 14 stock-lot streets.
          </p>
        </div>
        <a 
          href="/sourcing-guide" 
          class="mt-4 md:mt-0 inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700"
        >
          Open Complete Sourcing Playbook &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/sourcing-guide#freight-calculator" class="group bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md hover:border-blue-400 transition-all flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 text-[11px] font-bold mb-3">
              Interactive Calculator + 7 Freight Modes
            </span>
            <h3 class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
              China-to-US Shipping Cost & CBM Calculator
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Compare FedEx IP/IE, Air + UPS Combined (AFUC), Sea + UPS Combined (SFUC at $1.50–$1.80/kg), LCL CBM rates, and 20'GP/40'HQ containers—plus calculate volumetric weight (÷5000 vs ÷6000) instantly.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 flex items-center gap-1">
            Calculate Landed Freight Cost &rarr;
          </span>
        </a>

        <a href="/sourcing-guide#oem-roadmap" class="group bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md hover:border-blue-400 transition-all flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 text-[11px] font-bold mb-3">
              9-Step OEM & Private Label Guide
            </span>
            <h3 class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
              Custom Manufacturing, Molds & MOQ Scripts
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              From $10 3D-printed parts and $35 silicone molds to NNN IP protection agreements, exact sub-MOQ negotiation scripts, and low-MOQ custom retail packaging in Yiwu.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 flex items-center gap-1">
            Read 9-Step Manufacturing Roadmap &rarr;
          </span>
        </a>

        <a href="/market-map#specialized-streets" class="group bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md hover:border-blue-400 transition-all flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 text-[11px] font-bold mb-3">
              5 Niche Markets + 14 Specialty Streets
            </span>
            <h3 class="text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
              Yiwu Stock-Lot Streets (Up to 80% Off) & Taxi Cards
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              Explore Meihu & Wuai Stock-Lot Streets, Changchun Jewelry Findings Street, Chouzhou Packaging Street, plus Furniture & Timber markets with 1-click Chinese taxi addresses.
            </p>
          </div>
          <span class="text-xs font-bold text-blue-600 flex items-center gap-1">
            Explore 14 Streets & Niche Markets &rarr;
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Global Contact Unlock Modal Dialog -->
  <ContactUnlockModal />
</Layout>
