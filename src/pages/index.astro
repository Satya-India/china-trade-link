---
import Layout from '../layouts/Layout.astro';
import SupplierCard from '../components/SupplierCard.astro';
import ContactUnlockModal from '../components/ContactUnlockModal.astro';
import AlibabaDropshipBox from '../components/AlibabaDropshipBox.astro';
import { getStats, getFeaturedSuppliers } from '../lib/data';
import { WHOLESALE_MARKETS, CONCIERGE_SERVICES } from '../lib/markets';

const stats = await getStats();
const featuredSuppliers = await getFeaturedSuppliers(8);
---

<Layout
  title="Sino Trade Link | Alibaba.com Dropshipping & China-Wide Direct Factory Sourcing"
  description="Source directly from factories anywhere in China (Yiwu, Shenzhen, Guangzhou, Ningbo & beyond). Paste any Alibaba.com product link or browse 27,706+ verified stalls free and request managed factory quotes."
  activePage="home"
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-16 pb-24 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/30 via-transparent to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-xs font-bold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>🇨🇳 China-Wide Factory Sourcing · Yiwu, Shenzhen, Guangzhou &amp; Nationwide · Zero Middleman Markups</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight sm:leading-none">
        Source Directly from <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-300 bg-clip-text text-transparent">Factories Anywhere</span> in China.
      </h1>

      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        We procure across <strong class="text-white font-semibold">Yiwu, Shenzhen, Guangzhou, Ningbo &amp; factory belts nationwide</strong> — not only Yiwu market. Paste any Alibaba.com link or browse <strong class="text-white font-semibold">{stats.totalSuppliers.toLocaleString()}+ verified stalls</strong> free and request direct factory quotes through our team.
      </p>

      <!-- Search Bar -->
      <div class="mt-8 max-w-2xl mx-auto">
        <form action="/directory" method="GET" class="relative flex items-center bg-white rounded-2xl p-2 shadow-2xl border border-slate-200">
          <div class="pl-3 pr-2 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            name="q" 
            placeholder="Search by product, category, or stall name (e.g. Toys, Kitchenware, Booth 62159)..." 
            class="w-full py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none bg-transparent"
          />
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors shrink-0"
          >
            Search Directory
          </button>
        </form>
        <div class="flex items-center justify-center gap-2 mt-3 text-xs text-slate-400">
          <span>Popular searches:</span>
          <a href="/directory?q=toy" rel="nofollow" class="hover:text-white underline decoration-slate-600">Toys</a>
          <span>•</span>
          <a href="/directory?q=hardware" rel="nofollow" class="hover:text-white underline decoration-slate-600">Hardware</a>
          <span>•</span>
          <a href="/directory?q=kitchen" rel="nofollow" class="hover:text-white underline decoration-slate-600">Kitchenware</a>
          <span>•</span>
          <a href="/directory?q=socks" rel="nofollow" class="hover:text-white underline decoration-slate-600">Socks</a>
          <span>•</span>
          <a href="/directory?q=textile" rel="nofollow" class="hover:text-white underline decoration-slate-600">Bedding</a>
        </div>
        <div class="mt-5 flex flex-wrap items-center justify-center gap-3">
          <a
            href="#alibaba-dropship-box"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs shadow-lg shadow-emerald-500/20 transition-all"
          >
            <span>&#128230; Have an Alibaba Link? Get Factory Quote Free &rarr;</span>
          </a>
          <a
            href="/dropshipping"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700 font-bold text-xs transition-all"
          >
            1-Piece Dropshipping Workflow &rarr;
          </a>
        </div>
      </div>

      <!-- On-Ground Trust Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-400">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">📍</span> Yiwu, Shenzhen, Guangzhou &amp; Nationwide</span>
        <span class="hidden sm:block text-slate-700">|</span>
        <span class="flex items-center gap-1.5"><span class="text-blue-400">💬</span> Direct Sourcing Desk via WhatsApp</span>
        <span class="hidden sm:block text-slate-700">|</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400">✅</span> Vetted China Factory &amp; Stall Network</span>
        <span class="hidden sm:block text-slate-700">|</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">🛡️</span> Managed Outreach — We Contact Suppliers For You</span>
      </div>

      <!-- Live Metric Badges Grid -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-white">{stats.totalSuppliers.toLocaleString()}+</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Verified Stalls Indexed</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400">100% China</div>
          <div class="text-xs text-slate-400 font-medium mt-1">All Industrial Belts Covered</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-amber-400">{stats.directFactories.toLocaleString()}</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Licensed Factories</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-blue-400">0%</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Trading Markups</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alibaba.com Dropshipping & Direct Factory Quote Box -->
  <div class="bg-slate-950 border-b border-slate-800">
    <AlibabaDropshipBox locale="en" headingId="home-alibaba-box-heading" />
  </div>

  <!-- Alibaba.com vs Direct China Factory Price Comparison Section -->
  <section class="py-16 bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block mb-1">Alibaba.com vs. China Factory Direct</span>
        <h2 class="text-3xl font-black text-white tracking-tight">Alibaba.com Price vs. Our Direct Factory Price</h2>
        <p class="text-sm text-slate-400 mt-2">Typical public Alibaba.com trader listings vs. direct RMB factory rates we procure across Yiwu, Shenzhen, Guangzhou, Ningbo &amp; all Chinese manufacturing hubs.</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-700 shadow-xl">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
              <th class="text-left px-5 py-3.5 font-bold">Product</th>
              <th class="text-left px-4 py-3.5 font-bold">China Sourcing Hub</th>
              <th class="text-right px-4 py-3.5 font-bold text-red-400">Alibaba.com Price</th>
              <th class="text-right px-4 py-3.5 font-bold text-emerald-400">Our Direct Price</th>
              <th class="text-right px-4 py-3.5 font-bold">Dropship / MOQ</th>
              <th class="text-right px-5 py-3.5 font-bold text-amber-400">Saving</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <tr class="bg-slate-900 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=phone+case" rel="nofollow" class="hover:text-blue-400 transition-colors">MagSafe Silicone Phone Case</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/dropshipping" class="hover:text-blue-400 transition-colors">Shenzhen · Electronics Belt</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$1.85/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$0.92/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">From 1 pc · Bulk 100+</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−50%</td>
            </tr>
            <tr class="bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=insulated+mug" rel="nofollow" class="hover:text-blue-400 transition-colors">Stainless 304 Insulated Tumbler</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=2" rel="nofollow" class="hover:text-blue-400 transition-colors">Yongkang / Yiwu · Dist 2</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$4.90/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$2.45/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">From 1 pc · Bulk 50+</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−50%</td>
            </tr>
            <tr class="bg-slate-900 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=LED+lamp" rel="nofollow" class="hover:text-blue-400 transition-colors">Rechargeable LED Desk Lamp</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/dropshipping" class="hover:text-blue-400 transition-colors">Zhongshan · Lighting Belt</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$5.60/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$2.95/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">From 1 pc · Bulk 50+</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−47%</td>
            </tr>
            <tr class="bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=plush+bear" rel="nofollow" class="hover:text-blue-400 transition-colors">Plush Stuffed Toy 30cm</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=1" rel="nofollow" class="hover:text-blue-400 transition-colors">Yangzhou / Yiwu · Dist 1</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$4.40/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$2.25/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">From 1 pc · Bulk 100+</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−49%</td>
            </tr>
            <tr class="bg-slate-900 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=kitchen" rel="nofollow" class="hover:text-blue-400 transition-colors">Silicone Kitchen Utensil Set</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/dropshipping" class="hover:text-blue-400 transition-colors">Ningbo / Yangjiang Hub</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$6.80/set</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$3.60/set</td>
              <td class="px-4 py-4 text-right text-slate-400">From 1 pc · Bulk 100+</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−47%</td>
            </tr>
            <tr class="bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=socks" rel="nofollow" class="hover:text-blue-400 transition-colors">Custom Athletic &amp; Linen Socks</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=4" rel="nofollow" class="hover:text-blue-400 transition-colors">Zhuji / Yiwu · Dist 4</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$1.45/pair</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$0.62/pair</td>
              <td class="px-4 py-4 text-right text-slate-400">From 1 pc · Bulk 200+</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−57%</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 mt-4 text-center">* Sample direct China factory EXW pricing across Yiwu, Shenzhen, Guangzhou &amp; Ningbo hubs compared against public Alibaba.com trader listings. 1-piece dropshipping &amp; bulk test orders available.</p>
      <div class="text-center mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="#alibaba-dropship-box" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-sm transition-colors shadow-md shadow-emerald-500/20">Paste Alibaba.com Link For Exact Quote →</a>
        <a href="/directory" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition-colors shadow-md shadow-blue-600/20">Browse 27,706+ Verified Stalls →</a>
      </div>
    </div>
  </section>

  <!-- Market District Breakdown Section -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">
            Yiwu Futian International Trade City
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Browse by Wholesale Market District
          </h2>
          <p class="text-sm text-slate-600 mt-1 max-w-xl">
            Futian Market is divided into 5 interconnected mega-districts plus Huangyuan Market. Filter suppliers by their exact physical coordinates.
          </p>
        </div>
        <a 
          href="/directory" 
          class="mt-4 md:mt-0 inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700"
        >
          View all market stalls &rarr;
        </a>
      </div>

      <!-- District Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {WHOLESALE_MARKETS.map(market => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all hover:border-blue-400 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
                  {market.boothCount}
                </span>
                <span class="text-xs font-medium text-slate-400 font-mono">
                  {market.chineseName}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                {market.name}
              </h3>

              <p class="text-xs text-slate-600 line-clamp-2 mb-4 leading-relaxed">
                {market.description}
              </p>

              <!-- Floor Categories -->
              <div class="space-y-1.5 pt-3 border-t border-slate-100 mb-6">
                {market.floors.slice(0, 3).map(f => (
                  <div class="text-xs flex items-center justify-between text-slate-600">
                    <span class="font-bold text-slate-800">Floor {f.floor}:</span>
                    <span class="text-[11px] text-slate-500 truncate max-w-[180px]">{f.categories.join(', ')}</span>
                  </div>
                ))}
              </div>
            </div>

            <a 
              href={`/directory?district=${market.id.replace('district-', '')}`}
              class="w-full py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-800 font-bold text-xs text-center transition-colors block"
            >
              Explore {market.name} Stalls &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Zero-Upfront Fulfillment & Sourcing Models -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">Zero Upfront Subscriptions · Pay Per Order</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight">Browse Free. Quote Direct. Ship From 1 Unit.</h2>
        <p class="text-sm text-slate-600 mt-2">No paid directory downloads or annual platform fees. Browse all 27,706+ stalls free or paste any Alibaba.com product link to source directly from the factory.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        
        <!-- 1-Piece Dropshipping -->
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-amber-600 uppercase tracking-wider block mb-3">1-Piece Dropshipping</span>
            <div class="mb-2">
              <span class="text-4xl font-black text-slate-900">From 1 Unit</span>
            </div>
            <p class="text-xs text-slate-600 mb-6 leading-relaxed">Paste any Alibaba.com product link. Our Yiwu desk locates the direct factory line, checks stock, and fulfills blind-labeled parcels worldwide in 5–9 days.</p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8">
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Bypass 100–500 pc online MOQs</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 100% blind packaging (no Chinese flyers)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Warehouse QC photos before air dispatch</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> YunExpress, 4PX, DHL &amp; DDP Express lines</li>
            </ul>
          </div>
          <a href="#alibaba-dropship-box" class="w-full py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs text-center transition-colors block">Paste Alibaba Link (Free) →</a>
        </div>

        <!-- Alibaba Link -> Factory Direct -->
        <div class="rounded-3xl border-2 border-emerald-500 bg-white p-8 flex flex-col justify-between shadow-xl shadow-emerald-500/10 relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="bg-emerald-600 text-white text-[11px] font-black px-4 py-1.5 rounded-full shadow-md">MOST POPULAR</span>
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block mb-3 mt-2">Alibaba Link &rarr; Factory Direct</span>
            <div class="mb-1">
              <span class="text-4xl font-black text-slate-900">$0 Upfront</span>
            </div>
            <p class="text-xs text-emerald-600 font-semibold mb-1">Save 10–35% vs. public Alibaba trader quotes</p>
            <p class="text-xs text-slate-600 mb-6 leading-relaxed">Send an Alibaba link or app screenshot on WhatsApp. We negotiate real RMB factory cost, combine items from multiple booths, and remove third-party brand tags.</p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8">
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Direct factory negotiation on your behalf</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Custom thank-you cards &amp; logo stickers</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Combine multi-stall items into one box</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Priority WhatsApp response (2–6 hrs)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Pay $0 until you approve your unit quote</li>
            </ul>
          </div>
          <a
            href="https://wa.me/8613482725985?text=Hi%20SinoTradeLink%2C%20I%20want%20a%20free%20factory-direct%20and%20dropshipping%20quote%20for%20my%20Alibaba.com%20product%20links."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs text-center transition-all flex items-center justify-center gap-2 shadow-md shadow-emerald-600/20"
          >Get Free Factory Quote →</a>
          <span class="block text-center text-[10px] text-slate-400 mt-2">Zero monthly fee · Direct Yiwu WhatsApp desk</span>
        </div>

        <!-- Open-Book Wholesale -->
        <div class="rounded-3xl border border-indigo-300 bg-gradient-to-b from-indigo-50/70 to-white p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-indigo-700 uppercase tracking-wider block mb-3">Open-Book Wholesale</span>
            <div class="mb-1">
              <span class="text-4xl font-black text-slate-900">6% Flat Fee</span>
            </div>
            <p class="text-xs text-indigo-700 font-semibold mb-1">Original RMB factory receipts shared before payment</p>
            <p class="text-xs text-slate-600 mb-6 leading-relaxed">Scale winning SKUs with a dedicated bilingual Yiwu field rep, physical stall verification, custom OEM packaging, and sea or air container consolidation from Ningbo.</p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-6">
