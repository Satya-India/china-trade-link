---
import Layout from '../layouts/Layout.astro';
import SupplierCard from '../components/SupplierCard.astro';
import ContactUnlockModal from '../components/ContactUnlockModal.astro';
import { getStats, getFeaturedSuppliers } from '../lib/data';
import { WHOLESALE_MARKETS, CATEGORY_PACKS, CONCIERGE_SERVICES } from '../lib/markets';

const stats = await getStats();
const featuredSuppliers = await getFeaturedSuppliers(8);
---

<Layout title="Sino Trade Link | 20,000+ Verified China Wholesale Market Suppliers & Direct Contacts" activePage="home">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-16 pb-24 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/30 via-transparent to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-xs font-bold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>🇨🇳 27,706 Verified Stalls · 99.9% Direct Mobiles · No Agents · No Kickbacks</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight sm:leading-none">
        Source Directly from <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-300 bg-clip-text text-transparent">Physical Factory Stalls</span> in China.
      </h1>

      <p class="mt-6 text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Bypass trading agents and 30% trading markups. Access <strong class="text-white font-semibold">{stats.totalSuppliers.toLocaleString()}+ verified stalls</strong> across Yiwu Futian & Huangyuan Wholesale Markets with real, unmasked Chinese mobile numbers.
      </p>

      <!-- Search Bar -->
      <div class="mt-8 max-w-2xl mx-auto">
        <form action="/directory" method="GET" class="relative flex items-center bg-white rounded-2xl p-2 shadow-2xl border border-slate-200">
          <div class="pl-3 pr-2 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            name="q" 
            placeholder="Search by product, category, or stall name (e.g. Toys, Kitchenware, Booth 62159)..." 
            class="w-full py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none bg-transparent"
          />
          <button 
            type="submit" 
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors shrink-0"
          >
            Search Directory
          </button>
        </form>
        <div class="flex items-center justify-center gap-2 mt-3 text-xs text-slate-400">
          <span>Popular searches:</span>
          <a href="/directory?q=toy" class="hover:text-white underline decoration-slate-600">Toys</a>
          <span>•</span>
          <a href="/directory?q=hardware" class="hover:text-white underline decoration-slate-600">Hardware</a>
          <span>•</span>
          <a href="/directory?q=kitchen" class="hover:text-white underline decoration-slate-600">Kitchenware</a>
          <span>•</span>
          <a href="/directory?q=socks" class="hover:text-white underline decoration-slate-600">Socks</a>
          <span>•</span>
          <a href="/directory?q=textile" class="hover:text-white underline decoration-slate-600">Bedding</a>
        </div>
      </div>

      <!-- On-Ground Trust Bar -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-400">
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">📍</span> Yiwu Futian Market, Zhejiang, China</span>
        <span class="hidden sm:block text-slate-700">|</span>
        <span class="flex items-center gap-1.5"><span class="text-blue-400">📞</span> On-Ground Team: +86 134 8272 5985</span>
        <span class="hidden sm:block text-slate-700">|</span>
        <span class="flex items-center gap-1.5"><span class="text-amber-400">✅</span> B2B commercial stall signboard data</span>
        <span class="hidden sm:block text-slate-700">|</span>
        <span class="flex items-center gap-1.5"><span class="text-emerald-400">🔁</span> Dead Contact Replacement Guarantee</span>
      </div>

      <!-- Live Metric Badges Grid -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-white">{stats.totalSuppliers.toLocaleString()}+</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Verified Stalls Ingested</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400">{stats.phoneCoverageRate}%</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Unmasked Direct Mobiles</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-amber-400">{stats.directFactories.toLocaleString()}</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Licensed Factories</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur border border-slate-700/60 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-black text-blue-400">0%</div>
          <div class="text-xs text-slate-400 font-medium mt-1">Trading Markups</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Amazon vs Yiwu Price Comparison Section -->
  <section class="py-16 bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block mb-1">Real Price Intelligence</span>
        <h2 class="text-3xl font-black text-white tracking-tight">Same Product. Fraction of the Price.</h2>
        <p class="text-sm text-slate-400 mt-2">Real prices from Amazon vs. what verified Yiwu Futian stalls actually charge — before any middleman margin.</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-700 shadow-xl">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-800 text-slate-400 text-[11px] uppercase tracking-wider">
              <th class="text-left px-5 py-3.5 font-bold">Product</th>
              <th class="text-left px-4 py-3.5 font-bold">District & Floor</th>
              <th class="text-right px-4 py-3.5 font-bold text-red-400">Amazon Price</th>
              <th class="text-right px-4 py-3.5 font-bold text-emerald-400">Yiwu Booth</th>
              <th class="text-right px-4 py-3.5 font-bold">MOQ</th>
              <th class="text-right px-5 py-3.5 font-bold text-amber-400">Saving</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <tr class="bg-slate-900 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=phone+case" class="hover:text-blue-400 transition-colors">Silicone Phone Cases (12-pack)</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=2" class="hover:text-blue-400 transition-colors">Dist 2 · Floor 3</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$2.08/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$0.38/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">120 pcs</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−82%</td>
            </tr>
            <tr class="bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=insulated+mug" class="hover:text-blue-400 transition-colors">Stainless 304 Insulated Mugs</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=2" class="hover:text-blue-400 transition-colors">Dist 2 · Floor 3</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$18.99/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$2.10/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">50 pcs</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−89%</td>
            </tr>
            <tr class="bg-slate-900 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=LED+string+lights" class="hover:text-blue-400 transition-colors">LED String Lights 10m</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=1" class="hover:text-blue-400 transition-colors">Dist 1 · Floor 4</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$15.99/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$1.65/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">100 pcs</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−90%</td>
            </tr>
            <tr class="bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=plush+bear" class="hover:text-blue-400 transition-colors">Plush Stuffed Bear 30cm</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=1" class="hover:text-blue-400 transition-colors">Dist 1 · Floor 1</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$19.99/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$2.40/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">100 pcs</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−88%</td>
            </tr>
            <tr class="bg-slate-900 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=gel+pen" class="hover:text-blue-400 transition-colors">Gel Pen Set 36-pack</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=3" class="hover:text-blue-400 transition-colors">Dist 3 · Floor 1</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$0.42/unit</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$0.06/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">500 pcs</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−86%</td>
            </tr>
            <tr class="bg-slate-900/80 hover:bg-slate-800/80 transition-colors">
              <td class="px-5 py-4 font-medium text-white"><a href="/directory?q=socks" class="hover:text-blue-400 transition-colors">Custom Linen Socks</a></td>
              <td class="px-4 py-4 text-slate-400"><a href="/directory?district=4" class="hover:text-blue-400 transition-colors">Dist 4 · Floor 1</a></td>
              <td class="px-4 py-4 text-right text-red-400 font-mono">$8.99/pair</td>
              <td class="px-4 py-4 text-right text-emerald-400 font-mono font-bold">$0.62/unit</td>
              <td class="px-4 py-4 text-right text-slate-400">200 pcs</td>
              <td class="px-5 py-4 text-right font-black text-amber-400">−93%</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 mt-4 text-center">* Ex-works prices from stall. Add shipping (~$1.50–$3.50/kg via sea freight) for landed cost. Prices vary by order volume.</p>
      <div class="text-center mt-8">
        <a href="/directory" class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm transition-colors shadow-md shadow-blue-600/20">Browse 27,706+ Verified Stalls →</a>
      </div>
    </div>
  </section>

  <!-- Market District Breakdown Section -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">
            Yiwu Futian International Trade City
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Browse by Wholesale Market District
          </h2>
          <p class="text-sm text-slate-600 mt-1 max-w-xl">
            Futian Market is divided into 5 interconnected mega-districts plus Huangyuan Market. Filter suppliers by their exact physical coordinates.
          </p>
        </div>
        <a 
          href="/directory" 
          class="mt-4 md:mt-0 inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700"
        >
          View all market stalls &rarr;
        </a>
      </div>

      <!-- District Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {WHOLESALE_MARKETS.map(market => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all hover:border-blue-400 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 text-slate-700">
                  {market.boothCount}
                </span>
                <span class="text-xs font-medium text-slate-400 font-mono">
                  {market.chineseName}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                {market.name}
              </h3>

              <p class="text-xs text-slate-600 line-clamp-2 mb-4 leading-relaxed">
                {market.description}
              </p>

              <!-- Floor Categories -->
              <div class="space-y-1.5 pt-3 border-t border-slate-100 mb-6">
                {market.floors.slice(0, 3).map(f => (
                  <div class="text-xs flex items-center justify-between text-slate-600">
                    <span class="font-bold text-slate-800">Floor {f.floor}:</span>
                    <span class="text-[11px] text-slate-500 truncate max-w-[180px]">{f.categories.join(', ')}</span>
                  </div>
                ))}
              </div>
            </div>

            <a 
              href={`/directory?district=${market.id.replace('district-', '')}`}
              class="w-full py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-800 font-bold text-xs text-center transition-colors block"
            >
              Explore {market.name} Stalls &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Membership Tiers -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">Flexible Access Plans</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight">Choose Your Access Level</h2>
        <p class="text-sm text-slate-600 mt-2">From a one-time niche pack to full-platform membership with a dedicated Yiwu field rep and open-book order execution.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        
        <!-- Single Pack -->
        <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block mb-3">Single Niche</span>
            <div class="mb-2">
              <span class="text-4xl font-black text-slate-900">From $29</span>
              <span class="text-xs text-slate-500 ml-2">one-time</span>
            </div>
            <p class="text-xs text-slate-600 mb-6 leading-relaxed">One market district. One product category. Instant CSV download with unmasked direct mobile numbers and exact booth coordinates.</p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8">
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 1 district CSV (600–2,200 stalls)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 99.9% unmasked direct mobile numbers</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Exact booth coordinates & street navigation</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Single-user license, lifetime access to that pack</li>
              <li class="flex items-center gap-2"><span class="text-slate-300">–</span> <span class="text-slate-400">No ground services included</span></li>
            </ul>
          </div>
          <a href="/category-packs" class="w-full py-3 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs text-center transition-colors block">Browse Category Packs →</a>
        </div>

        <!-- Pro Annual -->
        <div class="rounded-3xl border-2 border-blue-500 bg-white p-8 flex flex-col justify-between shadow-xl shadow-blue-500/10 relative">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2">
            <span class="bg-blue-600 text-white text-[11px] font-black px-4 py-1.5 rounded-full shadow-md">RECOMMENDED</span>
          </div>
          <div>
            <span class="text-xs font-bold text-blue-600 uppercase tracking-wider block mb-3 mt-2">Pro All-Access</span>
            <div class="mb-1">
              <span class="text-4xl font-black text-slate-900">$149</span>
              <span class="text-xs text-slate-500 ml-2">/year</span>
            </div>
            <p class="text-xs text-emerald-600 font-semibold mb-1">Saves $50 vs. buying all 6 packs separately</p>
            <p class="text-xs text-slate-600 mb-6 leading-relaxed">Full platform access. All 6 district packs. Weekly new verified stall additions.</p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-8">
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> All 6 district CSVs (27,706+ total stalls)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Weekly new verified stall additions</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> CSV refresh download every 30 days</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Priority WhatsApp support (24hr response)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Dead contact replacement guarantee</li>
            </ul>
          </div>
          <button
            type="button"
            data-item-id="pro-annual"
            data-item-title="Pro Annual Pass – All 6 District Packs (27,706+ Stalls)"
            data-item-price="149"
            data-item-type="pack"
            class="paypal-trigger-btn w-full py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs text-center transition-all cursor-pointer flex items-center justify-center gap-2 shadow-md shadow-blue-600/20"
          >Get Pro Access ($149/yr) →</button>
          <span class="block text-center text-[10px] text-slate-400 mt-2">Renews annually · Cancel anytime via PayPal</span>
        </div>

        <!-- Business Tier -->
        <div class="rounded-3xl border border-amber-400 bg-gradient-to-b from-amber-50 to-white p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-amber-700 uppercase tracking-wider block mb-3">Business</span>
            <div class="mb-1">
              <span class="text-4xl font-black text-slate-900">$399</span>
              <span class="text-xs text-slate-500 ml-2">/year</span>
            </div>
            <p class="text-xs text-amber-700 font-semibold mb-1">4 stall audits alone = $396 value — pays for itself</p>
            <p class="text-xs text-slate-600 mb-6 leading-relaxed">Everything in Pro, plus a dedicated Yiwu field rep, quarterly physical stall audits, and open-book order execution at 6% transparent commission.</p>
            <ul class="space-y-2.5 text-xs text-slate-700 mb-6">
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Everything in Pro</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> 1 Free $99 Stall Audit per quarter (4/yr)</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Dedicated bilingual Yiwu rep on WhatsApp</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Open-Book Order Execution at 6% commission</li>
              <li class="flex items-center gap-2"><span class="text-emerald-600">✓</span> Pre-shipment AQL 2.5 inspection on 1st order</li>
            </ul>
            <p class="text-[11px] text-amber-700 bg-amber-100 border border-amber-200 rounded-xl px-3 py-2 leading-relaxed">💡 You receive the raw RMB factory receipt + our separate invoice. You see exactly what the factory charges vs. our fee.</p>
          </div>
          <a
            href="https://wa.me/8613482725985?text=Hi%20SinoTradeLink%2C%20I%27m%20interested%20in%20the%20Business%20Sourcing%20Tier%20(%24399%2Fyr).%20Can%20we%20talk%3F"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs text-center transition-all flex items-center justify-center gap-2 mt-4"
          >Start on WhatsApp →</a>
          <span class="block text-center text-[10px] text-slate-400 mt-2">Onboarded personally by our Yiwu team</span>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured Verified Stalls Section -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">
            Hand-Picked Verified Profiles
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Top Direct Factories & Veteran Suppliers
          </h2>
          <p class="text-sm text-slate-600 mt-1 max-w-xl">
            Every stall profile features 100% genuine unmasked Chinese mobile numbers, physical stall street addresses, and verified booth numbers.
          </p>
        </div>
        <a 
          href="/directory" 
