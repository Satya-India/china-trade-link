<script is:inline>
  (function () {
    var lInput = document.getElementById('calc-l');
    var wInput = document.getElementById('calc-w');
    var hInput = document.getElementById('calc-h');
    var wtInput = document.getElementById('calc-wt');
    var ctnsInput = document.getElementById('calc-ctns');
    var unitsInput = document.getElementById('calc-units');
    var destSelect = document.getElementById('calc-dest');

    var resCbm = document.getElementById('res-cbm');
    var resActualWt = document.getElementById('res-actual-wt');
    var resExpWt = document.getElementById('res-exp-wt');
    var resExpNote = document.getElementById('res-exp-note');
    var resAirWt = document.getElementById('res-air-wt');

    var resCostExp = document.getElementById('res-cost-express');
    var resUnitExp = document.getElementById('res-unit-express');
    var resCostAfuc = document.getElementById('res-cost-afuc');
    var resUnitAfuc = document.getElementById('res-unit-afuc');
    var resCostSfuc = document.getElementById('res-cost-sfuc');
    var resUnitSfuc = document.getElementById('res-unit-sfuc');
    var resCostLcl = document.getElementById('res-cost-lcl');
    var resUnitLcl = document.getElementById('res-unit-lcl');

    var resRecBox = document.getElementById('res-recommendation');
    var resRecText = document.getElementById('res-rec-text');

    function recalc() {
      if (!lInput || !wInput || !hInput || !wtInput || !ctnsInput || !unitsInput || !destSelect) return;
      var l = Math.max(1, parseFloat(lInput.value) || 1);
      var w = Math.max(1, parseFloat(wInput.value) || 1);
      var h = Math.max(1, parseFloat(hInput.value) || 1);
      var wtPerCtn = Math.max(0.1, parseFloat(wtInput.value) || 0.1);
      var ctns = Math.max(1, parseInt(ctnsInput.value, 10) || 1);
      var units = Math.max(1, parseInt(unitsInput.value, 10) || 1);
      var dest = destSelect.value || 'west';

      var totalVolCm3 = l * w * h * ctns;
      var totalCbm = totalVolCm3 / 1000000;
      var actualGrossKg = wtPerCtn * ctns;
      var expVolKg = totalVolCm3 / 5000;
      var airVolKg = totalVolCm3 / 6000;

      var expBillableKg = Math.max(actualGrossKg, expVolKg);
      var airBillableKg = Math.max(actualGrossKg, airVolKg);

      resCbm.textContent = totalCbm.toFixed(2) + ' CBM';
      resActualWt.textContent = Math.round(actualGrossKg) + ' kg';
      resExpWt.textContent = Math.round(expBillableKg) + ' kg';
      resExpNote.textContent = expVolKg > actualGrossKg ? 'Volumetric (÷ 5000)' : 'Actual Gross Wt';
      resAirWt.textContent = Math.round(airBillableKg) + ' kg';

      // 1. Express IE Estimate
      var expRatePerKg = expBillableKg > 70 ? 6.25 : expBillableKg >= 21 ? 6.60 : 8.50;
      var totalExpCost = Math.max(29, expBillableKg * expRatePerKg);

      // 2. AFUC (Air + UPS Combined)
      var afucBase = dest === 'west' ? 4.3 : dest === 'central' ? 4.5 : 4.9;
      if (airBillableKg > 300) afucBase -= 0.4;
      var totalAfucCost = Math.max(110, airBillableKg * afucBase);

      // 3. SFUC (Sea + UPS Combined)
      var sfucRate = dest === 'west' ? 1.5 : dest === 'central' ? 1.6 : 1.8;
      var sfucChargeKg = Math.max(100, airBillableKg);
      var totalSfucCost = sfucChargeKg * sfucRate;

      // 4. Sea LCL All-In Reference
      var lclRatePerCbm = 310;
      if (dest === 'west') {
        lclRatePerCbm = totalCbm >= 10 ? 180 : totalCbm >= 5 ? 240 : 310;
      } else if (dest === 'central') {
        lclRatePerCbm = totalCbm >= 10 ? 240 : totalCbm >= 5 ? 290 : 340;
      } else {
        lclRatePerCbm = totalCbm >= 10 ? 260 : totalCbm >= 5 ? 320 : 370;
      }
      var lclChargeCbm = Math.max(2, totalCbm);
      var totalLclCost = lclChargeCbm * lclRatePerCbm;

      resCostExp.textContent = '$' + Math.round(totalExpCost).toLocaleString();
      resUnitExp.textContent = '$' + (totalExpCost / units).toFixed(2) + ' / pc';

      resCostAfuc.textContent = '$' + Math.round(totalAfucCost).toLocaleString();
      resUnitAfuc.textContent = '$' + (totalAfucCost / units).toFixed(2) + ' / pc';

      resCostSfuc.textContent = '$' + Math.round(totalSfucCost).toLocaleString();
      resUnitSfuc.textContent = '$' + (totalSfucCost / units).toFixed(2) + ' / pc';

      resCostLcl.textContent = '$' + Math.round(totalLclCost).toLocaleString();
      resUnitLcl.textContent = '$' + (totalLclCost / units).toFixed(2) + ' / pc';

      var titleEl = resRecBox ? resRecBox.querySelector('strong') : null;
      if (totalCbm >= 15) {
        if (titleEl) titleEl.textContent = 'Recommended Mode: 20\' GP or 40\' HQ Full Container Load (FCL)';
        resRecText.textContent = 'At ' + totalCbm.toFixed(1) + ' CBM, booking a dedicated 20\' GP container (28 CBM capacity) from Ningbo Port is cheaper and safer than LCL or per-kg DDP.';
      } else if (totalCbm >= 3.5 && totalLclCost < totalSfucCost) {
        if (titleEl) titleEl.textContent = 'Recommended Mode: Sea Freight LCL (CBM Volume Basis)';
        resRecText.textContent = 'At ' + totalCbm.toFixed(2) + ' CBM, LCL sea freight gives you the lowest landed cost per unit ($' + (totalLclCost / units).toFixed(2) + '/pc).';
      } else if (expBillableKg < 45) {
        if (titleEl) titleEl.textContent = 'Recommended Mode: International Express (FedEx IP/IE) or $149 Sample Consolidation';
        resRecText.textContent = 'For small shipments under 45 kg, Express courier is fastest and avoids minimum sea freight surcharges.';
      } else {
        if (titleEl) titleEl.textContent = 'Recommended Mode: Sea Freight + UPS Combined (SFUC Fast DDP)';
        resRecText.textContent = 'SFUC gives you the best balance of speed (25–32 days) and low landed cost ($' + (totalSfucCost / units).toFixed(2) + '/pc) without port deconsolidation delays.';
      }
    }

    var inputs = [lInput, wInput, hInput, wtInput, ctnsInput, unitsInput, destSelect];
    for (var i = 0; i < inputs.length; i++) {
      if (inputs[i]) {
        inputs[i].addEventListener('input', recalc);
        inputs[i].addEventListener('change', recalc);
      }
    }
    recalc();
  })();
</script>
