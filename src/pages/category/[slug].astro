---
import Layout from '../../layouts/Layout.astro';
import SupplierCard from '../../components/SupplierCard.astro';
import ContactUnlockModal from '../../components/ContactUnlockModal.astro';
import { CATEGORY_HUBS, getCategoryBySlug } from '../../lib/categories';
import { CATEGORY_PACKS } from '../../lib/markets';
import { getSuppliersPaginated } from '../../lib/data';

const { slug } = Astro.params;
const category = slug ? getCategoryBySlug(slug) : undefined;

if (!category) {
  return Astro.redirect('/directory');
}

// Fetch matching verified stalls from Cloudflare D1
let result = await getSuppliersPaginated({
  district: category.district,
  query: category.searchQuery,
  page: 1,
  pageSize: 24
});

// If fewer than 6 stalls match the narrow keyword + district combo, enrich with verified direct factories in that district
if (result.suppliers.length < 6) {
  const districtFallback = await getSuppliersPaginated({
    district: category.district,
    isFactory: true,
    page: 1,
    pageSize: 24
  });
  const existingIds = new Set(result.suppliers.map(s => s.shop_id));
  for (const s of districtFallback.suppliers) {
    if (!existingIds.has(s.shop_id) && result.suppliers.length < 24) {
      result.suppliers.push(s);
      existingIds.add(s.shop_id);
    }
  }
  result.total = Math.max(result.total, districtFallback.total);
}

const matchingPack = CATEGORY_PACKS.find(p => p.id === category.packId) || CATEGORY_PACKS[0];
const canonicalUrl = `https://sinotradelink.com/category/${category.slug}`;

const seoTitle = `${category.title} (${category.districtLabel}, ${category.floor}) | Sino Trade Link`;
const seoDescription = `${category.description} Browse ${result.total.toLocaleString()}+ verified stalls at ${category.districtLabel} (${category.floor}, ${category.gateGuide}), unlock direct +86 mobile & WeChat IDs, or book a $99 physical stall audit.`;
const seoKeywords = [
  ...category.seoKeywords,
  category.chineseCategory,
  `Yiwu ${category.shortName} wholesale`,
  `Yiwu ${category.shortName} factory`,
  `${category.districtLabel} ${category.floor} booths`,
  'Yiwu direct factory WeChat numbers'
].join(', ');

const whatsappCategoryUrl = `https://wa.me/8613482725985?text=${encodeURIComponent(
  `Hi SinoTradeLink, I am sourcing "${category.shortName}" in Yiwu (${category.districtLabel}, ${category.floor}). Can your on-ground team help inspect stalls or consolidate samples?`
)}`;

const categoryJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#collection`,
      "name": category.title,
      "description": seoDescription,
      "url": canonicalUrl,
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": result.total,
        "itemListElement": result.suppliers.slice(0, 12).map((s, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "url": `https://sinotradelink.com/supplier/${s.shop_id}`,
          "name": `${s.clean_name || s.name} (Booth ${s.booth_no || 'N/A'})`
        }))
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sinotradelink.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Yiwu Wholesale Directory",
          "item": "https://sinotradelink.com/directory"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": category.shortName,
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": `Which district and floor in Yiwu Market has ${category.shortName} suppliers?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Wholesale ${category.shortName} stalls and direct factory showrooms are concentrated in ${category.districtLabel}, ${category.floor} (best accessed via ${category.gateGuide}). Official Chinese market classification: ${category.chineseCategory}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the typical MOQ and master carton CBM for ${category.shortName} in Yiwu?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Typical minimum order quantity (MOQ) is ${category.typicalMoq}, with an average master carton volume of ${category.avgMasterCartonCbm}.`
          }
        },
        {
          "@type": "Question",
          "name": `How do I verify ${category.shortName} quality before paying a 30% deposit?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Sino Trade Link's bilingual Yiwu field engineers perform $99 physical stall audits covering: ${category.qcChecklist.join('; ')}.`
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonicalUrl={canonicalUrl}
  jsonLd={categoryJsonLd}
  activePage="directory"
>
  <!-- Category Hero Header -->
  <section class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="flex items-center flex-wrap gap-2 text-xs text-slate-400 mb-4">
        <a href="/" class="hover:text-white">Home</a>
        <span>/</span>
        <a href="/directory" class="hover:text-white">Yiwu Directory</a>
        <span>/</span>
        <a href={`/directory?district=${category.district}`} class="hover:text-white">{category.districtLabel}</a>
        <span>/</span>
        <span class="text-slate-200">{category.shortName}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 text-xs font-bold">
              {category.districtLabel} &bull; {category.floor}
            </span>
            <span class="px-3 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 text-xs font-bold">
              {category.gateGuide}
            </span>
            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700 text-xs font-mono">
              {category.chineseCategory}
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
            {category.title}
          </h1>

          <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl">
            {category.description}
          </p>

          <!-- Key Category Specs Bar -->
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl">
            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Typical Stall MOQ:</span>
              <span class="text-xs font-bold text-white mt-0.5 block">{category.typicalMoq}</span>
            </div>
            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Avg. Master Carton CBM:</span>
              <span class="text-xs font-bold text-amber-300 mt-0.5 block">{category.avgMasterCartonCbm}</span>
            </div>
          </div>
        </div>

        <!-- Right Tripwire Pack + $99 Audit Card -->
        <div class="lg:col-span-4 bg-slate-950/90 border border-slate-800 rounded-3xl p-6 shadow-xl">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-black uppercase tracking-wider text-amber-400">
              Full Excel Directory Pack
            </span>
            <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              {matchingPack.supplierCount}
            </span>
          </div>
          <h2 class="text-base font-black text-white mb-1">
            {matchingPack.title}
          </h2>
          <p class="text-xs text-slate-400 mb-4 leading-relaxed">
            Download the complete spreadsheet of unmasked +86 mobile numbers, WeChat IDs, and booth numbers for {category.districtLabel}.
          </p>

          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-3xl font-black text-white">${matchingPack.price}</span>
            <span class="text-sm text-slate-500 line-through">${matchingPack.originalPrice}</span>
            <span class="text-[11px] text-slate-400 ml-auto">Instant CSV / Excel</span>
          </div>

          <div class="space-y-2.5">
            <button
              type="button"
              data-item-id={matchingPack.id}
              data-item-title={matchingPack.title}
              data-item-price={matchingPack.price}
              data-item-type="pack"
              class="paypal-trigger-btn w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-md transition-all cursor-pointer"
            >
              Download Full Excel Pack (${matchingPack.price}) &rarr;
            </button>

            <button
              type="button"
              class="open-sample-audit-btn w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs transition-all cursor-pointer flex items-center justify-center gap-1.5"
            >
              <span>Preview Sample $99 Stall Audit Report</span>
            </button>

            <a
              href={whatsappCategoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 font-bold text-xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Ask Yiwu Ground Desk on WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Field QC Checklist & Freight Calculator Callout -->
  <section class="py-8 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50 rounded-3xl border border-slate-200 p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-3xl">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase">
              Yiwu Field Engineer QC Protocol
            </span>
            <span class="text-xs font-semibold text-slate-500">
              What we inspect at {category.shortName} stalls ($99 Flat Fee):
            </span>
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-1">
            {category.qcChecklist.map((item, idx) => (
              <li class="bg-white p-3.5 rounded-2xl border border-slate-200/80 text-xs text-slate-700 leading-relaxed flex items-start gap-2">
                <span class="w-5 h-5 rounded-full bg-blue-600 text-white font-black text-[10px] flex items-center justify-center shrink-0 mt-0.5">
                  {idx + 1}
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 shrink-0">
          <button
            type="button"
            class="open-sample-audit-btn px-5 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-sm transition-all cursor-pointer whitespace-nowrap"
          >
            See Sample $99 Audit Report &rarr;
          </button>
          <a
            href="/sourcing-guide#freight-calculator"
            class="px-5 py-3 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold text-xs text-center transition-all whitespace-nowrap"
          >
            Calculate CBM & Landed Freight &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Stalls Grid -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            Verified {category.shortName} Stalls & Direct Factories
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Showing top verified booths in {category.districtLabel} ({category.floor}). Click any stall to unlock direct +86 mobile & WeChat.
          </p>
        </div>

        <a
          href={`/directory?district=${category.district}&q=${encodeURIComponent(category.searchQuery)}`}
          class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-sm transition-colors self-start sm:self-auto"
        >
          Search All {result.total.toLocaleString()} Stalls in Live Directory &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {result.suppliers.map(s => (
          <SupplierCard supplier={s} />
        ))}
      </div>

      <!-- Explore All 24 Yiwu Wholesale Category Hubs (Internal SEO Link Mesh) -->
      <div class="mt-16 pt-12 border-t border-slate-200">
        <div class="mb-6">
          <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 block mb-1">
            Yiwu Market Category Index
          </span>
          <h2 class="text-xl font-black text-slate-900">
            Explore All 24 Yiwu Wholesale Category Hubs
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {CATEGORY_HUBS.map(hub => (
            <a
              href={`/category/${hub.slug}`}
              class={`p-3.5 rounded-2xl border text-xs transition-all flex flex-col justify-between ${
                hub.slug === category.slug
                  ? 'bg-blue-600 text-white border-blue-600 font-bold shadow-sm'
                  : 'bg-white hover:bg-blue-50/60 text-slate-800 border-slate-200 hover:border-blue-300'
              }`}
            >
              <span class="font-bold line-clamp-1">{hub.shortName}</span>
              <span class={`text-[10px] mt-1 ${hub.slug === category.slug ? 'text-blue-100' : 'text-slate-400'}`}>
                {hub.districtLabel} &bull; {hub.floor}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ContactUnlockModal />
</Layout>
