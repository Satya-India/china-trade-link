---
import Layout from '../layouts/Layout.astro';
import AlibabaDropshipBox from '../components/AlibabaDropshipBox.astro';
import { t } from '../lib/i18n';

const ui = t('en');
const canonicalUrl = 'https://sinotradelink.com/dropshipping';

const whatsappQuoteUrl = `https://wa.me/8613482725985?text=${encodeURIComponent(
  'Hi SinoTradeLink Yiwu Desk, I want to start dropshipping / factory-direct sourcing from Alibaba.com product links. Can you help quote my product?'
)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: 'Alibaba.com Dropshipping & Direct China Factory Fulfillment',
      provider: {
        '@type': 'Organization',
        name: 'Sino Trade Link',
        url: 'https://sinotradelink.com'
      },
      description: ui.seo.packsDesc,
      areaServed: 'Worldwide',
      serviceType: 'China Dropshipping Fulfillment & Direct Factory Sourcing',
      offers: {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'USD',
        description: 'Zero monthly platform fee — pay only per approved order or quote'
      }
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Can I paste any Alibaba.com product link even if I only want 1 piece dropshipped?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Paste any Alibaba.com product link or send an Alibaba app screenshot on WhatsApp. Even when a listing specifies a 100 or 500 piece MOQ, our on-ground Yiwu team contacts the physical factory stall to fulfill 1-piece private dropshipping or a low-MOQ test batch.'
          }
        },
        {
          '@type': 'Question',
          name: 'Are there any monthly subscription fees or paid directory packages?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Sino Trade Link charges $0 for platform subscriptions and $0 for directory access. You only pay after approving your itemized factory quote, warehouse photos, and shipping rate.'
          }
        },
        {
          '@type': 'Question',
          name: 'Do you remove Chinese invoices and supplier branding from parcels?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Every parcel processed through our Yiwu fulfillment warehouse undergoes blind white-label repacking — all third-party brochures, price slips, and Chinese marketplace stickers are removed, and we can include your custom logo card or branded mailer.'
          }
        },
        {
          '@type': 'Question',
          name: 'How fast is worldwide delivery from Yiwu?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We dispatch within 24–48 hours for stocked SKUs using priority e-commerce air lines (YunExpress, 4PX, DHL, FedEx) delivering to USA, UK, Europe, UAE, Australia, and Latin America in 5–9 business days.'
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={ui.seo.packsTitle}
  description={ui.seo.packsDesc}
  keywords={ui.seo.homeKeywords}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  activePage="dropshipping"
  locale="en"
>
  <!-- Hero Section -->
  <section class="relative bg-slate-950 text-white pt-12 pb-6 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-amber-500/15 via-slate-950 to-slate-950 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold mb-5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
        <span>Browse Free · No Subscriptions · Pay Only When You Ship</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight">
        Alibaba.com Dropshipping &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-orange-400 to-emerald-400">China-Wide Direct Factory Agent</span>
      </h1>

      <p class="mt-4 text-sm sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Found a winning product on <strong class="text-white">Alibaba.com</strong>? Don’t get stuck with 500-piece minimums or middleman markups. Send us the product link or screenshot — our China-wide team procures straight from factories in <strong class="text-white">Yiwu, Shenzhen, Guangzhou, Ningbo &amp; nationwide</strong>, inspects quality, and blind-ships globally from <strong class="text-emerald-400">1 piece</strong>.
      </p>
    </div>

    <!-- Primary Interactive Quote Box -->
    <AlibabaDropshipBox locale="en" headingId="dropship-page-box-heading" />
  </section>

  <!-- 4-Step Execution Workflow -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">Zero Inventory Risk</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">How Alibaba Link Fulfillment Works in 4 Simple Steps</h2>
        <p class="text-sm text-slate-600 mt-2">Turn any public Alibaba catalog item into a fast, private-label dropshipping or low-MOQ supply chain.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200 relative">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-amber-500 text-slate-950 font-black text-sm mb-4">01</span>
          <h3 class="text-base font-black text-slate-900 mb-2">Browse Alibaba.com</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Find any product on Alibaba.com or search directly from our helper tab. Even if it shows high MOQs, copy the product link or screenshot.</p>
        </div>

        <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200 relative">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-blue-600 text-white font-black text-sm mb-4">02</span>
          <h3 class="text-base font-black text-slate-900 mb-2">Send Link on WhatsApp</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Submit the link above with your destination country. Within 2–6 working hours, our China sourcing buyers send your direct factory unit cost + tracked air rate.</p>
        </div>

        <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200 relative">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-indigo-600 text-white font-black text-sm mb-4">03</span>
          <h3 class="text-base font-black text-slate-900 mb-2">China Hub QC &amp; Repacking</h3>
          <p class="text-xs text-slate-600 leading-relaxed">We collect stock from Yiwu booths or partner factories across China (Shenzhen, Guangzhou, Ningbo &amp; more), inspect every batch in our fulfillment hub, remove supplier invoices, and add optional custom inserts.</p>
        </div>

        <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200 relative">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-emerald-600 text-white font-black text-sm mb-4">04</span>
          <h3 class="text-base font-black text-slate-900 mb-2">5–9 Day Global Delivery</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Orders ship daily via YunExpress, 4PX, DHL, and DDP sea/air lanes with live tracking uploaded directly for your Shopify, WooCommerce, or Amazon store.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Direct Alibaba Trader vs SinoTradeLink Private Fulfillment Comparison -->
  <section class="py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 block mb-1">Side-by-Side Comparison</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Buying Blind on Alibaba vs. Sino Trade Link On-Ground Execution</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-3xl border border-rose-200 bg-rose-50/70 p-7">
          <h3 class="text-base font-black text-rose-950 mb-4">&#10060; Buying Blind Direct on Alibaba.com</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-rose-900 leading-relaxed">
            <li class="flex items-start gap-2.5"><span class="text-rose-500 font-bold shrink-0">&#10007;</span> Locked behind 100–500 piece MOQs or inflated single-sample air fees</li>
            <li class="flex items-start gap-2.5"><span class="text-rose-500 font-bold shrink-0">&#10007;</span> Many listings belong to export traders adding 15–35% margin on factory rates</li>
            <li class="flex items-start gap-2.5"><span class="text-rose-500 font-bold shrink-0">&#10007;</span> Can’t easily combine 5 different suppliers into one blind customer parcel</li>
            <li class="flex items-start gap-2.5"><span class="text-rose-500 font-bold shrink-0">&#10007;</span> Risk of receiving wrong variants, damaged outer boxes, or Chinese factory flyers</li>
          </ul>
        </div>

        <div class="rounded-3xl border border-emerald-300 bg-emerald-50/70 p-7">
          <h3 class="text-base font-black text-emerald-950 mb-4">&#9989; Sino Trade Link China-Wide Direct Agent</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-emerald-900 leading-relaxed">
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> Fulfill winning Alibaba items starting from <strong>1 piece</strong> or low-MOQ test batches</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> Direct negotiation across China — Yiwu Futian Market, Shenzhen, Guangzhou, Ningbo &amp; factory belts nationwide (original RMB pricing)</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> Combine items from multiple Alibaba links &amp; Chinese factories into one custom parcel</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> Real photo verification in our China warehouse before shipping + $0 monthly fees</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Private Label, Blind Shipping & Kitting (#branding) -->
  <section id="branding" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 block">Build Your Own Brand</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Blind Dropshipping, Custom Packaging &amp; Multi-Item Bundles</h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Whether you are testing a single trending product from Alibaba or scaling 50+ daily Shopify/TikTok Shop orders, our Yiwu fulfillment team protects your brand identity on every dispatch:
          </p>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 pt-1">
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold">&#10003;</span> <strong>100% Blind Fulfillment:</strong> Zero Chinese marketplace labels, price receipts, or factory business cards inside your parcels.</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold">&#10003;</span> <strong>Custom Brand Inserts &amp; Stickers:</strong> Print your thank-you cards, QR codes, logo mailers, or FNSKU barcodes right in Yiwu.</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold">&#10003;</span> <strong>Multi-Supplier Kitting:</strong> Combine accessories from 3 different Alibaba links into one retail gift box to boost AOV.</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold">&#10003;</span> <strong>Scale Smoothly to Bulk:</strong> Once an item hits 20+ orders/day, pre-stock inventory in our Yiwu warehouse at zero storage cost for faster 24-hour dispatch.</li>
          </ul>
        </div>

        <div class="lg:col-span-6 bg-slate-900 text-white rounded-3xl p-8 border border-slate-800 shadow-xl space-y-5">
          <span class="inline-block px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-bold">Fastest Shipping Corridors From Yiwu</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
              <strong class="block text-white text-sm mb-1">US / UK / EU Express</strong>
              <span class="text-emerald-400 font-bold">5–9 Business Days</span>
              <p class="text-slate-400 mt-1">DDP YunExpress / 4PX / DHL air lines — duties cleared smoothly.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
              <strong class="block text-white text-sm mb-1">UAE / Saudi / GCC</strong>
              <span class="text-emerald-400 font-bold">6–10 Business Days</span>
              <p class="text-slate-400 mt-1">Dedicated Dubai &amp; Riyadh air/sea consolidation lines.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
              <strong class="block text-white text-sm mb-1">Australia / Canada</strong>
              <span class="text-emerald-400 font-bold">6–10 Business Days</span>
              <p class="text-slate-400 mt-1">Tracked e-commerce courier with live last-mile updates.</p>
            </div>
            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700">
              <strong class="block text-white text-sm mb-1">Bulk Sea LCL / FCL</strong>
              <span class="text-amber-300 font-bold">Ningbo Port Direct</span>
              <p class="text-slate-400 mt-1">Open-book 6% commission once your dropship SKU scales to bulk.</p>
            </div>
          </div>

          <a
            href={whatsappQuoteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-5 rounded-2xl bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs sm:text-sm text-center block shadow-lg shadow-emerald-500/20 transition-all"
          >
            Chat With China Dropshipping Desk &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">Common Questions</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">Alibaba.com Dropshipping &amp; Direct Sourcing FAQ</h2>
      </div>

      <div class="space-y-4">
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
          <h3 class="text-sm font-black text-slate-900 mb-2">Can I send an Alibaba link even if the supplier requires 100 or 500 pieces?</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Yes. Wholesale marketplaces often display container MOQs, while the exact same factories across China (Yiwu, Shenzhen, Guangzhou, Ningbo, Foshan &amp; beyond) fulfill single units or small cartons locally. Send the link on WhatsApp and we check 1-piece &amp; low-MOQ availability directly at the source.</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
          <h3 class="text-sm font-black text-slate-900 mb-2">Are there any platform fees, monthly subscriptions, or paid CSV downloads?</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Zero. Browsing our 27,706+ verified stalls and requesting direct Alibaba link quotes on WhatsApp are 100% free. You only pay after approving your itemized landed price quote.</p>
        </div>
        <div class="bg-white rounded-2xl border border-slate-200 p-6">
          <h3 class="text-sm font-black text-slate-900 mb-2">Can I browse verified factory stalls myself as well?</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">Absolutely. <a href="/directory" class="text-blue-600 font-bold underline">Search all 27,706+ verified stalls free in our directory</a>, shortlist booths, or ask our China-wide sourcing team on WhatsApp to quote and inspect products from Yiwu or any industrial hub across China on your behalf.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
