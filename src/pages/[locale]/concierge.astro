---
import Layout from '../../layouts/Layout.astro';
import { CONCIERGE_SERVICES } from '../../lib/markets';
import { isValidLocale, t } from '../../lib/i18n';

const { locale } = Astro.params;
if (!isValidLocale(locale) || locale === 'en') {
  return Astro.redirect('/concierge');
}

const ui = t(locale);
const { searchParams } = Astro.url;
const prefillBooth = searchParams.get('booth') || '';
const prefillName = searchParams.get('name') || '';
const prefillService = searchParams.get('service') || 'audit';
const defaultDetails = prefillBooth || prefillName ? `Booth: ${prefillBooth} (${prefillName})` : '';
const canonicalUrl = `https://sinotradelink.com/${locale}/concierge`;
---

<Layout
  title={ui.seo.conciergeTitle}
  description={ui.seo.conciergeDesc}
  keywords={ui.seo.homeKeywords}
  canonicalUrl={canonicalUrl}
  activePage="concierge"
  locale={locale}
>
  <!-- Header Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-slate-950 text-white py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 mb-4">
        <span>{ui.hero.trustLocation}</span>
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        {ui.seo.conciergeTitle}
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed">
        {ui.seo.conciergeDesc}
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          class="open-sample-audit-btn px-5 py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer flex items-center gap-2"
        >
          <span>📄 #STL-YW-0842 ($99 Report)</span>
        </button>
        <a
          href="#booking-form"
          class="px-5 py-3 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-bold text-xs transition-all"
        >
          {ui.supplier.auditBtn}
        </a>
      </div>
    </div>
  </section>

  <!-- Service Packages -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {CONCIERGE_SERVICES.map(svc => (
          <div class={`rounded-3xl border p-8 flex flex-col justify-between transition-all hover:shadow-xl ${svc.recommended ? 'bg-white border-blue-500 ring-2 ring-blue-500/20 shadow-lg' : 'bg-white border-slate-200'}`}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-lg border border-blue-100">
                  {svc.turnaround}
                </span>
                {svc.recommended && (
                  <span class="bg-blue-600 text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full">
                    {ui.membership.proBadge}
                  </span>
                )}
              </div>

              <h2 class="text-xl font-bold text-slate-900 mb-2">{svc.title}</h2>
              <p class="text-xs text-slate-600 leading-relaxed mb-6">{svc.description}</p>

              <div class="mb-6 pb-6 border-b border-slate-100">
                <span class="text-4xl font-black text-slate-900">${svc.price}</span>
              </div>

              <div class="space-y-3 text-xs text-slate-700 mb-8">
                {svc.deliverables.map(d => (
                  <div class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{d}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="space-y-2">
              <a 
                href="#booking-form"
                class={`w-full py-3 rounded-2xl font-bold text-xs text-center transition-all block ${svc.recommended ? 'bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-600/20' : 'bg-slate-900 hover:bg-slate-800 text-white'}`}
              >
                {ui.supplier.auditBtn}
              </a>
              <button
                type="button"
                data-item-id={svc.id}
                data-item-title={svc.title}
                data-item-price={svc.price}
                data-item-type="concierge"
                class="paypal-trigger-btn w-full py-2.5 rounded-2xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold text-xs flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
              >
                <span>⚡ PayPal (${svc.price})</span>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Open-Book vs Traditional Agent Comparison -->
      <div class="mb-16 bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <div class="text-center mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 block mb-1">{ui.openBook.badge}</span>
          <h3 class="text-2xl font-black text-slate-900">{ui.openBook.title}</h3>
          <p class="text-sm text-slate-500 mt-2 max-w-2xl mx-auto">{ui.openBook.subtitle}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-red-200 bg-red-50/60 p-6">
            <h4 class="text-base font-black text-red-900 mb-4">{ui.openBook.tradTitle}</h4>
            <ul class="space-y-3 text-sm text-red-800">
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">&#10007;</span> {ui.openBook.trad1}</li>
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">&#10007;</span> {ui.openBook.trad2}</li>
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">&#10007;</span> {ui.openBook.trad3}</li>
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">&#10007;</span> {ui.openBook.trad4}</li>
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">&#10007;</span> {ui.openBook.trad5}</li>
            </ul>
          </div>
          <div class="rounded-2xl border border-emerald-300 bg-emerald-50/60 p-6">
            <h4 class="text-base font-black text-emerald-900 mb-4">{ui.openBook.stlTitle}</h4>
            <ul class="space-y-3 text-sm text-emerald-800">
              <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> {ui.openBook.stl1}</li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> {ui.openBook.stl2}</li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> {ui.openBook.stl3}</li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> {ui.openBook.stl4}</li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">&#10003;</span> {ui.openBook.stl5}</li>
            </ul>
          </div>
        </div>
        <div class="mt-6 text-center">
          <a
            href="https://wa.me/8613482725985?text=Hi%20SinoTradeLink%2C%20I%20want%20to%20start%20open-book%20sourcing%20with%20the%20Business%20Tier.%20How%20does%20it%20work%3F"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-colors shadow-md shadow-emerald-600/20"
          >{ui.openBook.cta}</a>
        </div>
      </div>

      <!-- Booking Form -->
      <div id="booking-form" class="max-w-2xl mx-auto bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-black text-slate-900">{ui.nav.concierge}</h3>
          <p class="text-xs text-slate-500 mt-1">{ui.openBook.responseNote}</p>
        </div>

        <form id="concierge-form" class="space-y-4">
          <input type="hidden" name="shop_id" value="CONCIERGE_INSPECTION" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Name *</label>
              <input type="text" name="buyer_name" required placeholder="John Smith" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-blue-500" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Email *</label>
              <input type="email" name="buyer_email" required placeholder="john@company.com" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-blue-500" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">WhatsApp / Phone</label>
              <input type="text" name="phone" placeholder="+1 (555) 000-0000" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-blue-500" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Service</label>
              <select name="service_type" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-blue-500">
                <option value="Physical Stall Audit ($99)" selected={prefillService === 'audit'}>Physical Stall Audit ($99)</option>
                <option value="Booth Sample Pickup & Consolidation ($149)" selected={prefillService === 'sample'}>Booth Sample Pickup &amp; Consolidation ($149)</option>
                <option value="Comprehensive Factory & License Audit ($299)" selected={prefillService === 'factory'}>Comprehensive Factory &amp; License Audit ($299)</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">{ui.supplier.boothLabel} *</label>
            <input type="text" name="target_booth" value={defaultDetails} required placeholder="District 5, Floor 2, Booth 62159" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-blue-500" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Instructions *</label>
            <textarea name="message" rows="3" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-blue-500"></textarea>
          </div>

          <button 
            type="submit" 
            id="concierge-submit-btn"
            class="w-full py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-md transition-colors cursor-pointer"
          >
            {ui.supplier.auditBtn}
          </button>
        </form>

        <div id="booking-feedback" class="hidden mt-6 p-5 rounded-2xl text-xs"></div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var form = document.getElementById('concierge-form');
    var submitBtn = document.getElementById('concierge-submit-btn');
    var feedback = document.getElementById('booking-feedback');

    if (!form || !submitBtn || !feedback) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var origBtnText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>...</span>';
      feedback.className = 'hidden';

      var formData = new FormData(form);
      var payload = {
        shop_id: 'CONCIERGE_INSPECTION',
        buyer_name: formData.get('buyer_name'),
        buyer_email: formData.get('buyer_email'),
        phone: formData.get('phone'),
        target_booth: formData.get('target_booth'),
        service_type: formData.get('service_type'),
        message: formData.get('message')
      };

      fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (res) {
          return res.json().then(function (data) {
            return { ok: res.ok, data: data };
          });
        })
        .then(function (result) {
          if (result.ok && result.data.success) {
            var inquiryId = result.data.inquiryId ? String(result.data.inquiryId).slice(0, 8) : 'CONFIRMED';
            feedback.className = 'mt-6 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900';
            feedback.innerHTML =
              '<div class="font-black text-sm text-emerald-950 mb-2">✅ #' +
              inquiryId +
              '</div><a href="https://wa.me/8613482725985?text=Inquiry%20ID%3A%20' +
              inquiryId +
              '" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 text-white font-bold text-xs">WhatsApp (+86 134 8272 5985) &rarr;</a>';
            form.reset();
          } else {
            feedback.className = 'mt-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium';
            feedback.textContent = (result.data && result.data.error) || 'Error';
          }
        })
        .catch(function () {
          feedback.className = 'mt-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium';
          feedback.textContent = 'Network error.';
        })
        .finally(function () {
          submitBtn.disabled = false;
          submitBtn.innerHTML = origBtnText;
        });
    });
  })();
</script>
