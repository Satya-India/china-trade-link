---
import Layout from '../../../layouts/Layout.astro';
import SupplierCard from '../../../components/SupplierCard.astro';
import ContactUnlockModal from '../../../components/ContactUnlockModal.astro';
import { CATEGORY_HUBS } from '../../../lib/categories';
import { CATEGORY_PACKS } from '../../../lib/markets';
import { COUNTRIES, COUNTRY_REGIONS, resolveCountryCorridorRoute, getSmartCountrySeoMeta } from '../../../lib/countries';
import { getSuppliersPaginated } from '../../../lib/data';
import { isValidLocale, getLocaleConfig, t } from '../../../lib/i18n';

const { locale, slug } = Astro.params;
if (!isValidLocale(locale) || locale === 'en') {
  return Astro.redirect(slug ? `/country/${slug}` : '/countries');
}

const route = slug ? resolveCountryCorridorRoute(slug) : null;
if (!route) {
  return Astro.redirect(`/${locale}/countries`);
}

const localeConfig = getLocaleConfig(locale);
const ui = t(locale);
const { country, category } = route;
const isCategoryMode = route.type === 'country-category' && category !== null;

let result;
if (isCategoryMode && category) {
  result = await getSuppliersPaginated({
    district: category.district,
    query: category.searchQuery,
    page: 1,
    pageSize: 20
  });

  if (result.suppliers.length < 6) {
    const districtFallback = await getSuppliersPaginated({
      district: category.district,
      isFactory: true,
      page: 1,
      pageSize: 20
    });
    const existingIds = new Set(result.suppliers.map(s => s.shop_id));
    for (const s of districtFallback.suppliers) {
      if (!existingIds.has(s.shop_id) && result.suppliers.length < 20) {
        result.suppliers.push(s);
        existingIds.add(s.shop_id);
      }
    }
    result.total = Math.max(result.total, districtFallback.total);
  }
} else {
  result = await getSuppliersPaginated({
    isFactory: true,
    page: 1,
    pageSize: 16
  });
}

const matchingPack = isCategoryMode && category
  ? (CATEGORY_PACKS.find(p => p.id === category.packId) || CATEGORY_PACKS[0])
  : null;

const canonicalUrl = `https://sinotradelink.com/${locale}/country/${route.slug}`;
const smartSeo = getSmartCountrySeoMeta(country, category);

const seoTitle = isCategoryMode && category
  ? `Yiwu → ${country.name} (${country.flag}): ${category.shortName} | ${ui.seo.directoryTitle}`
  : `Yiwu → ${country.name} (${country.flag}) — ${ui.seo.countriesTitle}`;
const seoDescription = `${ui.seo.homeDesc} (${country.name} · ${country.ports} · ${country.seaTransitDays} · ${country.customsCompliance})`;
const seoKeywords = `${ui.seo.homeKeywords}, ${smartSeo.seoKeywords}`;

const whatsappText = isCategoryMode && category
  ? `Hi SinoTradeLink (${localeConfig.nativeName}), I am an importer in ${country.name} (${country.code}) sourcing "${category.shortName}" from Yiwu (${category.districtLabel}, ${category.floor}). Can your team help with stall contacts, $99 audit, or shipping to ${country.ports}?`
  : `Hi SinoTradeLink (${localeConfig.nativeName}), I am an importer in ${country.name} (${country.code}) looking to source directly from Yiwu Market stalls and ship to ${country.ports}. Can your Yiwu desk assist?`;

const whatsappUrl = `https://wa.me/8613482725985?text=${encodeURIComponent(whatsappText)}`;

const regionInfo = COUNTRY_REGIONS.find(r => r.id === country.region);
const regionalPeers = COUNTRIES.filter(c => c.region === country.region && c.slug !== country.slug);
const globalFlagships = COUNTRIES.filter(c =>
  ['usa', 'canada', 'brazil', 'mexico', 'colombia', 'argentina', 'chile', 'uk', 'germany', 'france', 'spain', 'italy', 'netherlands', 'poland', 'uae', 'india'].includes(c.slug) &&
  c.slug !== country.slug &&
  c.region !== country.region
).slice(0, 10);

const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Sino Trade Link",
    "item": `https://sinotradelink.com/${locale}`
  },
  {
    "@type": "ListItem",
    "position": 2,
    "name": ui.nav.countries,
    "item": `https://sinotradelink.com/${locale}/countries`
  },
  {
    "@type": "ListItem",
    "position": 3,
    "name": `${country.flag} ${country.name}`,
    "item": `https://sinotradelink.com/${locale}/country/${country.slug}`
  }
];

if (isCategoryMode && category) {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 4,
    "name": category.shortName,
    "item": canonicalUrl
  });
}

const faqQuestions = [
  { "@type": "Question", "name": ui.faq.q1, "acceptedAnswer": { "@type": "Answer", "text": ui.faq.a1 } },
  { "@type": "Question", "name": ui.faq.q2, "acceptedAnswer": { "@type": "Answer", "text": ui.faq.a2 } },
  { "@type": "Question", "name": ui.faq.q3, "acceptedAnswer": { "@type": "Answer", "text": ui.faq.a3 } },
  { "@type": "Question", "name": ui.faq.q4, "acceptedAnswer": { "@type": "Answer", "text": ui.faq.a4 } },
  { "@type": "Question", "name": ui.faq.q5, "acceptedAnswer": { "@type": "Answer", "text": `${ui.faq.a5} (${country.name}: ${country.customsCompliance} · ${country.ports})` } }
];

const pageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#collection`,
      "name": seoTitle,
      "description": seoDescription,
      "inLanguage": localeConfig.hreflang,
      "url": canonicalUrl,
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": result.total,
        "itemListElement": result.suppliers.slice(0, 12).map((s, idx) => ({
          "@type": "ListItem",
          "position": idx + 1,
          "url": `https://sinotradelink.com/supplier/${s.shop_id}`,
          "name": `${s.clean_name || s.name} (${ui.supplier.boothLabel} ${s.booth_no || 'N/A'})`
        }))
      }
    },
    {
      "@type": "Service",
      "@id": `${canonicalUrl}#service`,
      "name": seoTitle,
      "serviceType": "B2B Wholesale Sourcing, Factory Verification & Freight Consolidation",
      "provider": {
        "@type": "Organization",
        "name": "Sino Trade Link",
        "url": "https://sinotradelink.com",
        "telephone": "+86-134-8272-5985"
      },
      "areaServed": {
        "@type": "Country",
        "name": country.name,
        "identifier": country.code
      },
      "offers": [
        { "@type": "Offer", "name": ui.nav.categoryPacks, "price": "29.00", "priceCurrency": "USD" },
        { "@type": "Offer", "name": ui.nav.concierge, "price": "99.00", "priceCurrency": "USD" },
        { "@type": "Offer", "name": ui.membership.proLabel, "price": "149.00", "priceCurrency": "USD" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "inLanguage": localeConfig.hreflang,
      "mainEntity": faqQuestions
    }
  ]
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonicalUrl={canonicalUrl}
  jsonLd={pageJsonLd}
  activePage="countries"
  locale={locale}
>
  <Fragment slot="head">
    <meta name="geo.region" content={smartSeo.geoRegionCode} />
    <meta name="geo.placename" content={country.name} />
  </Fragment>

  <!-- Regional & Multilingual Search Intent Strip -->
  <div class="bg-slate-950 border-b border-slate-800 py-2.5 px-4 sm:px-6 lg:px-8 text-[11px] text-slate-300">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <span class="font-medium text-emerald-400">{smartSeo.nativeSearchBanner}</span>
      <span class="text-slate-400 shrink-0 font-mono">ISO: {country.code} · {country.currency} · {localeConfig.flag} {localeConfig.nativeName}</span>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="flex items-center flex-wrap gap-2 text-xs text-slate-400 mb-5">
        <a href={`/${locale}`} class="hover:text-white transition-colors">Sino Trade Link</a>
        <span>/</span>
        <a href={`/${locale}/countries`} class="hover:text-white transition-colors">{ui.nav.countries}</a>
        <span>/</span>
        {isCategoryMode && category ? (
          <>
            <a href={`/${locale}/country/${country.slug}`} class="hover:text-white transition-colors">
              {country.flag} {country.name}
            </a>
            <span>/</span>
            <span class="text-slate-200 font-semibold">{category.shortName}</span>
          </>
        ) : (
          <span class="text-slate-200 font-semibold">{country.flag} {country.name}</span>
        )}
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 text-xs font-bold">
              {country.flag} Yiwu &rarr; {country.name} ({country.code} &bull; {country.currency})
            </span>
            {isCategoryMode && category ? (
              <span class="px-3 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 text-xs font-bold">
                {category.districtLabel} &bull; {category.floor}
              </span>
            ) : (
              <span class="px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-xs font-bold">
                {ui.hero.badge}
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
            {isCategoryMode && category
              ? `Yiwu → ${country.name} (${country.flag}): ${category.shortName}`
              : `${ui.hero.title} — Yiwu → ${country.name} (${country.flag})`}
          </h1>

          <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl">
            {ui.hero.subtitle}
          </p>

          <!-- 4-Column Corridor Intelligence Strip -->
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">1. {ui.countriesSection.portsLabel}</span>
              <span class="text-xs font-bold text-white mt-1 block">{country.ports}</span>
              <span class="text-[10px] text-slate-400 mt-0.5 block">FCL &amp; LCL</span>
            </div>

            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">2. {ui.countriesSection.seaTransitLabel}</span>
              <span class="text-xs font-bold text-blue-300 mt-1 block">{country.seaTransitDays}</span>
              <span class="text-[10px] text-slate-400 mt-0.5 block">Ningbo-Zhoushan</span>
            </div>

            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">3. {ui.countriesSection.airTransitLabel}</span>
              <span class="text-xs font-bold text-emerald-300 mt-1 block">{country.airTransitDays}</span>
              <span class="text-[10px] text-slate-400 mt-0.5 block">$149 Sample Box</span>
            </div>

            <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-3.5">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">4. {ui.countriesSection.complianceLabel}</span>
              <span class="text-xs font-bold text-amber-300 mt-1 block">{country.customsCompliance}</span>
              <span class="text-[10px] text-slate-400 mt-0.5 block">{ui.nav.concierge}</span>
            </div>
          </div>
        </div>

        <!-- Right Conversion Card (Hero CTAs) -->
        <div class="lg:col-span-4 bg-slate-950/90 border border-slate-800 rounded-3xl p-6 shadow-xl">
          {isCategoryMode && category && matchingPack ? (
            <>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-black uppercase tracking-wider text-amber-400">
                  {country.flag} {country.name}
                </span>
                <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                  {matchingPack.supplierCount}
                </span>
              </div>
              <h2 class="text-base font-black text-white mb-1">
                {matchingPack.title}
              </h2>
              <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                {ui.membership.singleDesc}
              </p>

              <div class="flex items-baseline gap-2 mb-4">
                <span class="text-3xl font-black text-white">${matchingPack.price}</span>
                <span class="text-sm text-slate-500 line-through">${matchingPack.originalPrice}</span>
                <span class="text-[11px] text-slate-400 ml-auto">CSV / Excel</span>
              </div>

              <div class="space-y-2.5">
                <button
                  type="button"
                  data-item-id={matchingPack.id}
                  data-item-title={matchingPack.title}
                  data-item-price={matchingPack.price}
                  data-item-type="pack"
                  class="paypal-trigger-btn w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-md transition-all cursor-pointer"
                >
                  {category.shortName} (${matchingPack.price}) &rarr;
                </button>

                <a
                  href={`/${locale}/concierge?service=audit`}
                  class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs transition-all flex items-center justify-center gap-1.5"
                >
                  <span>{ui.supplier.auditBtn}</span>
                </a>

                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 font-bold text-xs transition-all flex items-center justify-center gap-1.5"
                >
                  <span>{ui.supplier.whatsappBtn} ({country.name})</span>
                </a>
              </div>
            </>
          ) : (
            <>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-black uppercase tracking-wider text-amber-400">
                  {country.flag} {country.name} — {ui.membership.proBadge}
                </span>
                <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                  27,706+
                </span>
              </div>
              <h2 class="text-base font-black text-white mb-1">
                {ui.membership.proLabel}
              </h2>
              <p class="text-xs text-slate-400 mb-4 leading-relaxed">
                {ui.membership.proDesc}
              </p>

              <div class="flex items-baseline gap-2 mb-4">
                <span class="text-3xl font-black text-white">{ui.membership.proPrice}</span>
                <span class="text-sm text-slate-500 line-through">$234</span>
                <span class="text-[11px] text-slate-400 ml-auto">6 CSVs</span>
              </div>

              <div class="space-y-2.5">
                <button
                  type="button"
                  data-item-id="pro-annual"
                  data-item-title="Pro All-Access Annual Pass (All 27,706+ Verified Stalls)"
                  data-item-price="149"
                  data-item-type="pack"
                  class="paypal-trigger-btn w-full py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs shadow-md transition-all cursor-pointer"
                >
                  {ui.membership.proCta}
                </button>

                <a
                  href={`/${locale}/concierge?service=audit`}
                  class="w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs transition-all flex items-center justify-center gap-1.5"
                >
                  <span>{ui.supplier.auditBtn}</span>
                </a>

                <a
                  href={whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full py-2.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 font-bold text-xs transition-all flex items-center justify-center gap-1.5"
                >
                  <span>{ui.supplier.whatsappBtn} ({country.name})</span>
                </a>
              </div>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 24 Yiwu Product Category Corridors for Country Section -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 block mb-1">
            {country.flag} 24 Category Corridors
          </span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            Yiwu &rarr; {country.name} (24 Categories)
          </h2>
        </div>
        {isCategoryMode && (
          <a
            href={`/${locale}/country/${country.slug}`}
            class="text-xs font-bold text-blue-600 hover:text-blue-700 shrink-0"
          >
            &larr; {country.flag} {country.name}
          </a>
        )}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {CATEGORY_HUBS.map((cat) => {
          const isActive = isCategoryMode && category && category.slug === cat.slug;
          return (
            <a
              href={`/${locale}/country/${country.slug}-${cat.slug}`}
              class={`p-3.5 rounded-2xl border text-xs transition-all flex flex-col justify-between ${
                isActive
                  ? 'bg-blue-600 text-white border-blue-600 font-bold shadow-sm'
                  : 'bg-slate-50 hover:bg-blue-50/60 text-slate-800 border-slate-200 hover:border-blue-300'
              }`}
            >
              <div class="flex items-center justify-between gap-2">
                <span class="font-bold line-clamp-1">{cat.shortName}</span>
                <span class="text-xs shrink-0">{country.flag}</span>
              </div>
              <span class={`text-[10px] mt-1 ${isActive ? 'text-blue-100' : 'text-slate-400'}`}>
                {cat.districtLabel} &bull; {cat.floor}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Verified Yiwu Factory Stalls Exporting to Country -->
  <section class="py-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900">
            {ui.nav.browseStalls} — {country.name} ({country.flag})
          </h2>
        </div>

        <a
          href={isCategoryMode && category
            ? `/${locale}/directory?district=${category.district}&q=${encodeURIComponent(category.searchQuery)}`
            : `/${locale}/directory?factory=true`}
          class="px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-sm transition-colors self-start sm:self-auto"
        >
          {ui.nav.browseStalls} ({result.total.toLocaleString()}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {result.suppliers.map((s) => (
          <SupplierCard supplier={s} locale={locale} />
        ))}
      </div>
    </div>
  </section>

  <!-- Open-Book Comparison Section -->
  <section class="py-14 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 block mb-1">{ui.openBook.badge}</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{ui.openBook.title}</h2>
        <p class="text-sm text-slate-600 mt-2">{ui.openBook.subtitle}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="rounded-2xl border border-red-200 bg-red-50/60 p-6">
          <h3 class="text-base font-black text-red-900 mb-4">{ui.openBook.tradTitle}</h3>
          <ul class="space-y-3 text-sm text-red-800">
            <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">✗</span> {ui.openBook.trad1}</li>
            <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">✗</span> {ui.openBook.trad2}</li>
            <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">✗</span> {ui.openBook.trad3}</li>
            <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">✗</span> {ui.openBook.trad4}</li>
            <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0">✗</span> {ui.openBook.trad5}</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-emerald-300 bg-emerald-50/60 p-6">
          <h3 class="text-base font-black text-emerald-900 mb-4">{ui.openBook.stlTitle}</h3>
          <ul class="space-y-3 text-sm text-emerald-800">
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">✓</span> {ui.openBook.stl1}</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">✓</span> {ui.openBook.stl2}</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">✓</span> {ui.openBook.stl3}</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">✓</span> {ui.openBook.stl4}</li>
            <li class="flex items-start gap-2.5"><span class="text-emerald-600 font-bold shrink-0">✓</span> {ui.openBook.stl5}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block mb-1">
          {ui.faq.badge}
        </span>
        <h2 class="text-xl sm:text-2xl font-black text-slate-900">
          {ui.faq.title} — {country.name} ({country.flag})
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {faqQuestions.map((q) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-5">
            <h3 class="text-sm font-black text-slate-900 mb-2">{q.name}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{q.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Internal Link Mesh: Regional Peers & Global Flagships -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-black text-slate-900">
            {regionInfo ? `${regionInfo.flag} ${regionInfo.name}` : country.region}
          </h2>
          <a href={`/${locale}/countries`} class="text-xs font-bold text-blue-600 hover:underline">
            {ui.countriesSection.viewAllCta}
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {regionalPeers.map((peer) => (
            <a
              href={isCategoryMode && category ? `/${locale}/country/${peer.slug}-${category.slug}` : `/${locale}/country/${peer.slug}`}
              class="px-3 py-2 rounded-xl bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-blue-300 text-xs font-semibold text-slate-800 hover:text-blue-700 transition-colors inline-flex items-center gap-1.5"
            >
              <span>{peer.flag}</span>
              <span>{peer.name}</span>
            </a>
          ))}
        </div>
      </div>

      {globalFlagships.length > 0 && (
        <div class="pt-6 border-t border-slate-200">
          <div class="flex flex-wrap gap-2">
            {globalFlagships.map((hub) => (
              <a
                href={`/${locale}/country/${hub.slug}`}
                class="px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-xs font-medium text-slate-600 hover:text-slate-900 transition-colors inline-flex items-center gap-1.5"
              >
                <span>{hub.flag}</span>
                <span>Yiwu &rarr; {hub.name}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <ContactUnlockModal />
</Layout>
