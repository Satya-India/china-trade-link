---
import Layout from '../layouts/Layout.astro';
import { WHOLESALE_MARKETS, NICHE_MARKETS, SPECIALIZED_STREETS } from '../lib/markets';
import { getFloorStats } from '../lib/data';

const floorStats = await getFloorStats();

const tipsByDistrict: Record<string, string[]> = {
  'district-1': [
    "Enter through Gate 1 or Gate 2 for immediate access to plush toys and seasonal items.",
    "Floor 4 consists of expansive manufacturer showrooms with low sample MOQs and catalog viewing.",
    "Most stalls close promptly at 16:30–17:00 — plan for morning visits (09:00 - 12:00) for unhurried factory boss meetings."
  ],
  'district-2': [
    "Gate 21 & 22 are the closest to the Central Square and subway shuttle connection.",
    "Hardware tools on Floor 2 have heavy OEM export experience for European and US ISO standards.",
    "Floor 5 houses freight forwarders, translation counters, and export consolidation centers."
  ],
  'district-3': [
    "Pen & stationery manufacturers on Floor 1 offer customized logo engraving starting from 1,000 pcs.",
    "Cosmetics & beauty tools on Floor 3 cater heavily to Amazon FBA private label sellers.",
    "Look for 'Direct Factory' badges for tier-1 factory pricing directly from Ningbo and Wenzhou plants."
  ],
  'district-4': [
    "The single largest building in Futian: spans over 1,000,000 m² with over 16,000 booths.",
    "Floor 1 socks & hosiery is supplied by Datang, Zhuji (the sock capital of the world).",
    "Bring comfortable walking shoes: walking end-to-end on a single floor is over 1.2 kilometers."
  ],
  'district-5': [
    "Floor 2 and 3 home textiles and bedding come directly from Nantong and Shaoxing weaving mills.",
    "Auto accessories and motorcycle parts on Floor 4 feature direct tooling workshops.",
    "Wide aisles make sample transport and wheeled luggage navigation much easier than older districts."
  ],
  'huangyuan': [
    "Dedicated 8-story clothing complex located at No. 180 Jiangbin Middle Rd in downtown Xiu Hu (separate from Futian Trade City).",
    "Floor 1 Denim & Jeans has direct manufacturing links to Guangzhou and Xintang denim factories; Floor 6 features Korean imported styles.",
    "Stalls have fitting mannequins and high-speed local tailors for immediate sample modification."
  ]
};
---

<Layout 
  title="Yiwu Market Map, 5 Niche Markets & 14 Stock Streets | Sino Trade Link"
  description="Complete floor-by-floor navigation guide for Yiwu Futian International Trade City (Districts 1–5), 5 Niche Wholesale Markets, and 14 Specialized Stock-Lot Streets with Chinese taxi addresses."
  activePage="map"
>
  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-14 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-xs font-bold mb-4">
        <span>Physical Market Navigation • 6.4M m² Total Trade Area</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white max-w-4xl mx-auto">
        Yiwu Wholesale Market <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-amber-300 bg-clip-text text-transparent">Floor Map & Street Directory</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Spanning 6.4 million square meters, 75,000+ booths, 5 specialized niche complexes, and 14 surrounding stock-lot & raw-material streets, spending 3 minutes per booth in Yiwu would take over 3 months. Use our verified coordinates and Chinese taxi cards to navigate directly to the source.
      </p>

      <!-- Quick Market Jump Pills -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        {WHOLESALE_MARKETS.map(m => (
          <a 
            href={`#${m.id}`}
            class="px-3.5 py-1.5 rounded-full bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 border border-slate-700 hover:border-slate-500 transition-all shadow-sm"
          >
            {m.name}
          </a>
        ))}
        <a 
          href="#niche-markets"
          class="px-3.5 py-1.5 rounded-full bg-indigo-950/80 hover:bg-indigo-900 text-xs font-bold text-indigo-300 border border-indigo-700/60 transition-all shadow-sm"
        >
          + 4 Niche Markets (Machinery, Furniture, Timber)
        </a>
        <a 
          href="#specialized-streets"
          class="px-3.5 py-1.5 rounded-full bg-amber-950/80 hover:bg-amber-900 text-xs font-bold text-amber-300 border border-amber-700/60 transition-all shadow-sm"
        >
          + 14 Stock-Lot & Specialty Streets
        </a>
        <a 
          href="#field-mechanics"
          class="px-3.5 py-1.5 rounded-full bg-emerald-950/80 hover:bg-emerald-900 text-xs font-bold text-emerald-300 border border-emerald-700/60 transition-all shadow-sm"
        >
          Yiwu Buyer Field Rules
        </a>
      </div>
    </div>
  </section>

  <!-- Core Futian Market District Guides -->
  <section class="py-12 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 block">Primary Complex • Open Daily 09:00 – 16:30</span>
          <h2 class="text-lg sm:text-xl font-black text-slate-900">Yiwu International Trade City (Futian Market • 义乌国际商贸城)</h2>
          <p class="text-xs text-slate-600 mt-0.5">Main Taxi Address: <strong class="font-mono text-slate-900">No. 69, Chouzhou North Road, Yiwu (义乌市稠州北路69号)</strong></p>
        </div>
        <button 
          type="button"
          data-copy-text="义乌市稠州北路69号 (义乌国际商贸城)"
          class="copy-taxi-btn shrink-0 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition-colors cursor-pointer flex items-center gap-2"
        >
          <span>🚕 Copy Chinese Address for Taxi</span>
        </button>
      </div>

      {WHOLESALE_MARKETS.map(m => {
        const distNum = m.id.replace('district-', '').replace('huangyuan', '6');
        const tips = tipsByDistrict[m.id] || [];

        return (
          <div id={m.id} class="scroll-mt-24 bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
            <!-- Header Bar -->
            <div class={`bg-gradient-to-r ${m.accentColor} px-6 sm:px-8 py-6 text-white`}>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-white/80 mb-1">
                    <span>{m.chineseName}</span>
                    <span>•</span>
                    <span>{m.boothCount}</span>
                  </div>
                  <h2 class="text-2xl sm:text-3xl font-black text-white">{m.name}</h2>
                  <p class="text-xs sm:text-sm text-white/90 mt-1 max-w-2xl">{m.description}</p>
                </div>
                <div class="flex flex-wrap items-center gap-2 shrink-0">
                  <button
                    type="button"
                    data-copy-text={`义乌${m.chineseName}`}
                    class="copy-taxi-btn px-3.5 py-2 bg-black/25 hover:bg-black/40 text-white text-xs font-bold rounded-xl border border-white/20 transition-all cursor-pointer"
                  >
                    🚕 Taxi Card: {m.chineseName}
                  </button>
                  <a 
                    href={`/directory?district=${distNum}`} 
                    class="px-4 py-2 bg-white/20 hover:bg-white/30 backdrop-blur text-white text-xs font-bold rounded-xl border border-white/30 transition-all shadow-sm"
                  >
                    View All Stalls in {m.name} &rarr;
                  </a>
                </div>
              </div>
            </div>

            <!-- Floor-by-Floor Breakdown Cards -->
            <div class="p-6 sm:p-8 space-y-6">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">
                Floor Directory & Verified Categories
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                {m.floors.map(f => {
                  const count = floorStats[m.id]?.[f.floor] || 0;
                  return (
                    <div class="bg-slate-50 rounded-2xl border border-slate-200/80 p-5 hover:border-blue-400 transition-all hover:shadow-md flex flex-col justify-between">
                      <div>
                        <div class="flex items-center justify-between mb-3">
                          <span class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-slate-900 text-white font-mono font-black text-sm">
                            {f.floor}F
                          </span>
                          <span class="text-[11px] font-bold text-slate-500 bg-white px-2 py-0.5 rounded-full border border-slate-200">
                            {count > 0 ? `${count} verified stalls` : 'Active Zones'}
                          </span>
                        </div>

                        <ul class="space-y-1.5 mb-4">
                          {f.categories.map(cat => (
                            <li>
                              <a 
                                href={`/directory?district=${distNum}&q=${encodeURIComponent(cat.split(' ')[0])}`}
                                class="text-xs text-slate-700 hover:text-blue-600 flex items-center gap-1.5 transition-colors group"
                              >
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500 group-hover:scale-125 transition-transform"></span>
                                <span class="group-hover:underline">{cat}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <a 
                        href={`/directory?district=${distNum}`} 
                        class="text-[11px] font-bold text-blue-600 hover:text-blue-700 flex items-center gap-1 pt-2 border-t border-slate-200"
                      >
                        <span>Browse {f.floor}F Suppliers</span>
                        <span>&rarr;</span>
                      </a>
                    </div>
                  );
                })}
              </div>

              <!-- Buyer Ground Tips -->
              {tips.length > 0 && (
                <div class="mt-6 bg-blue-50/60 rounded-2xl border border-blue-100 p-5">
                  <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-800 mb-2">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>On-the-Ground Sourcing Tips for {m.name}</span>
                  </div>
                  <ul class="space-y-1 text-xs text-slate-700">
                    {tips.map(tip => (
                      <li class="flex items-start gap-2">
                        <span class="text-blue-500 font-bold">•</span>
                        <span>{tip}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Stall Inspection CTA for this District -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-slate-900 text-white mt-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-blue-600/30 border border-blue-500/40 flex items-center justify-center shrink-0 text-blue-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-xs sm:text-sm font-bold text-white">Need a physical stall verified in {m.name}?</h4>
                    <p class="text-xs text-slate-400">Our local Yiwu team walks directly to any booth, checks business licenses, and collects samples.</p>
                  </div>
                </div>
                <a 
                  href="/concierge" 
                  class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-sm transition-colors text-center shrink-0"
                >
                  Book Stall Audit ($99)
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 4 Additional Specialized Niche Wholesale Markets in Yiwu -->
  <section id="niche-markets" class="py-16 bg-white border-b border-slate-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 block mb-1">
          Beyond Futian & Huangyuan • Specialized Industrial Complexes
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          4 Specialized Niche Wholesale Markets in Yiwu
        </h2>
        <p class="text-sm text-slate-600 mt-2 leading-relaxed">
          While Futian Districts 1–5 cover small commodities and Huangyuan covers garments, Yiwu operates four additional government-backed wholesale complexes dedicated to industrial machinery, commercial furniture, building materials, and raw timber. All are within a 15–20 minute drive of Futian.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {NICHE_MARKETS.map(nm => (
          <div class="rounded-3xl border border-slate-200 bg-slate-50/70 p-6 sm:p-7 flex flex-col justify-between hover:border-indigo-400 transition-all shadow-sm">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="text-[11px] font-bold px-2.5 py-1 rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200">
                  {nm.scale}
                </span>
                <span class="text-xs font-mono font-bold text-slate-500">{nm.chineseName}</span>
              </div>

              <h3 class="text-xl font-black text-slate-900 mb-2">{nm.name}</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">{nm.focus}</p>

              <!-- Taxi Address Box -->
              <div class="bg-white rounded-2xl border border-slate-200 p-3.5 mb-5 flex items-center justify-between gap-3">
                <div class="text-xs">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Taxi Destination Card</span>
                  <span class="font-bold text-slate-900 block">{nm.chineseAddress}</span>
                  <span class="text-[11px] text-slate-500">{nm.address}</span>
                </div>
                <button
                  type="button"
                  data-copy-text={`${nm.chineseName} (${nm.chineseAddress})`}
                  class="copy-taxi-btn shrink-0 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-[11px] cursor-pointer transition-colors"
                >
                  Copy Chinese
                </button>
              </div>

              <!-- Floor / Zone Breakdown -->
              <div class="space-y-2 mb-6">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Floor & Zone Directory</span>
                {nm.floors.map(fl => (
                  <div class="flex items-start gap-2.5 text-xs bg-white rounded-xl p-2.5 border border-slate-200/70">
                    <span class="px-2 py-0.5 rounded-md bg-slate-900 text-white font-mono font-bold text-[11px] shrink-0">
                      {fl.level}
                    </span>
                    <span class="text-slate-700 leading-snug">{fl.items}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 pt-4 border-t border-slate-200/80">
              <a
                href={`/concierge?service=audit&name=${encodeURIComponent(nm.name)}`}
                class="text-xs font-bold text-indigo-600 hover:text-indigo-700"
              >
                Dispatch Agent to {nm.name} ($99) &rarr;
              </a>
              <a
                href="/directory?district=7"
                class="text-xs font-bold text-slate-600 hover:text-slate-900"
              >
                Search Directory &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 14 Specialized Wholesale & Stock-Lot Streets -->
  <section id="specialized-streets" class="py-16 bg-slate-900 text-white border-b border-slate-800 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10">
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-bold mb-3">
            <span>Insider Street-Level Clusters • Up to 80% Off Factory Overruns</span>
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
            14 Specialized Wholesale & Stock-Lot Streets in Yiwu
          </h2>
          <p class="text-sm text-slate-300 mt-2 leading-relaxed">
            Thousands of Yiwu's lowest-priced suppliers operate from street-level storefronts outside the main market complexes. These 14 specialized streets cluster <strong class="text-white">stock-lot liquidators</strong> (selling cancelled export runs and overproduction at up to 80% off factory cost), raw jewelry findings, and custom gift packaging mills.
          </p>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap gap-1.5" id="street-filter-bar">
          <button type="button" data-street-filter="all" class="street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 cursor-pointer transition-colors">
            All 14 Streets
          </button>
          <button type="button" data-street-filter="Stock Lots (80% Off)" class="street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer transition-colors">
            Stock Lots (80% Off)
          </button>
          <button type="button" data-street-filter="Raw Materials & Findings" class="street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer transition-colors">
            Jewelry Findings
          </button>
          <button type="button" data-street-filter="Packaging & Gifts" class="street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer transition-colors">
            Packaging & Gifts
          </button>
          <button type="button" data-street-filter="Apparel & Accessories" class="street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer transition-colors">
            Apparel & Wigs
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="streets-grid">
        {SPECIALIZED_STREETS.map(st => (
          <div 
            data-street-tag={st.tag}
            class="street-card rounded-2xl border border-slate-800 bg-slate-800/60 p-5 flex flex-col justify-between hover:border-amber-500/50 transition-all"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-lg bg-slate-950 text-amber-400 font-mono font-black text-xs border border-slate-700">
                  #{st.num}
                </span>
                <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${
                  st.tag === 'Stock Lots (80% Off)' 
                    ? 'bg-rose-500/20 text-rose-300 border-rose-500/30' 
                    : st.tag === 'Packaging & Gifts'
                    ? 'bg-amber-500/20 text-amber-300 border-amber-500/30'
                    : 'bg-blue-500/20 text-blue-300 border-blue-500/30'
                }`}>
                  {st.tag}
                </span>
              </div>

              <h3 class="text-base font-bold text-white mb-0.5">{st.name}</h3>
              <p class="text-xs font-mono text-amber-300/90 mb-3">{st.chineseName}</p>

              <p class="text-xs text-slate-300 leading-relaxed mb-3">
                <strong class="text-white">Core Products:</strong> {st.products}
              </p>

              <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-700/70 text-[11px] text-slate-400 leading-relaxed mb-4">
                <strong class="text-emerald-400">Field Tip:</strong> {st.insiderTip}
              </div>
            </div>

            <div class="pt-3 border-t border-slate-700/60 flex items-center justify-between gap-2">
              <div class="text-[11px] text-slate-400 truncate" title={st.address}>
                📍 {st.chineseAddress}
              </div>
              <button
                type="button"
                data-copy-text={`${st.chineseName} — ${st.chineseAddress}`}
                class="copy-taxi-btn shrink-0 px-2.5 py-1.5 rounded-lg bg-slate-700 hover:bg-amber-500 hover:text-slate-950 text-white font-bold text-[11px] transition-colors cursor-pointer"
              >
                🚕 Copy Taxi
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- On-the-Ground Yiwu Buyer Mechanics & Field Rules -->
  <section id="field-mechanics" class="py-16 bg-slate-50 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">
          Practical Local Insights
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          How Business Actually Works Inside Yiwu Market
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Over 600,000 international buyers visit Yiwu annually and 21,000+ resident foreign merchants live in the city. Know these 4 ground rules before you negotiate, pay, or ship.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Card 1: Price Comparison & Language -->
        <div class="bg-white rounded-3xl border border-slate-200 p-7 shadow-sm">
          <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-700 font-black flex items-center justify-center mb-4">
            01
          </div>
          <h3 class="text-lg font-black text-slate-900 mb-2">
            The "10-Booth Cluster" Rule & Translator Reality
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            In Yiwu, identical product categories are clustered side-by-side on the same floor. Walking into 10–15 adjacent booths gives you the exact market floor price in under 30 minutes. Always photograph the booth doorplate (<strong class="text-slate-900">District + Gate + Floor + 5-digit Booth No.</strong>) or you will never find the stall again.
          </p>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 space-y-1.5">
            <div><strong class="text-slate-900">Ready-Stock Buying:</strong> Stall keepers know basic English numbers and tap RMB prices into a hand calculator.</div>
            <div><strong class="text-slate-900">OEM & Private Label:</strong> Casual day translators (~$45/day) only interpret conversation in the aisle—they take zero responsibility for business license checks, defects, or sample consolidation. For a flat <a href="/concierge" class="text-blue-600 font-bold underline">$99 Stall Audit</a>, our bilingual field engineers inspect the booth, verify licenses, and film a 4K walkthrough.</div>
          </div>
        </div>

        <!-- Card 2: MOQs & Stock vs Custom -->
        <div class="bg-white rounded-3xl border border-slate-200 p-7 shadow-sm">
          <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 font-black flex items-center justify-center mb-4">
            02
          </div>
          <h3 class="text-lg font-black text-slate-900 mb-2">
            Buying Ready-Stock Cartons vs. Custom Packaging
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
