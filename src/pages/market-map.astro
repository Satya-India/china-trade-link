<script is:inline>
  (function () {
    // Copy Chinese Taxi Address Handler
    var copyBtns = document.querySelectorAll('.copy-taxi-btn');
    for (var i = 0; i < copyBtns.length; i++) {
      copyBtns[i].addEventListener('click', function () {
        var btn = this;
        var text = btn.getAttribute('data-copy-text') || '';
        var orig = btn.innerHTML;
        if (navigator.clipboard && text) {
          navigator.clipboard.writeText(text).then(function () {
            btn.innerHTML = '✅ Copied Chinese Address!';
            setTimeout(function () {
              btn.innerHTML = orig;
            }, 2000);
          });
        }
      });
    }

    // Specialized Street Filter Handler
    var filterBtns = document.querySelectorAll('.street-filter-btn');
    var streetCards = document.querySelectorAll('.street-card');
    for (var j = 0; j < filterBtns.length; j++) {
      filterBtns[j].addEventListener('click', function () {
        var activeTag = this.getAttribute('data-street-filter') || 'all';
        for (var k = 0; k < filterBtns.length; k++) {
          filterBtns[k].className = 'street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 cursor-pointer transition-colors';
        }
        this.className = 'street-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 cursor-pointer transition-colors';

        for (var m = 0; m < streetCards.length; m++) {
          var card = streetCards[m];
          var cardTag = card.getAttribute('data-street-tag');
          if (activeTag === 'all' || cardTag === activeTag) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        }
      });
    }
  })();
</script>

