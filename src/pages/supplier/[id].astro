---
import Layout from '../../layouts/Layout.astro';
import ContactUnlockModal from '../../components/ContactUnlockModal.astro';
import { getAllSuppliers, getSupplierById, type Supplier } from '../../lib/data';


interface Props {
  supplier?: Supplier;
}

const { id } = Astro.params;
const propSupplier = Astro.props.supplier;
const supplier = propSupplier || (id ? await getSupplierById(id) : undefined);

if (!supplier) {
  return Astro.redirect('/directory');
}

const rawPhone = supplier.unmasked_direct_phone || '';
let maskedPhone = '+86-***-****-****';
if (rawPhone.length >= 11) {
  const digits = rawPhone.replace(/\D/g, '');
  if (digits.length >= 11) {
    maskedPhone = `+86-${digits.slice(0, 3)}-***-${digits.slice(-4)}`;
  }
}

const sampleProducts = supplier.sample_products ? supplier.sample_products.split(' | ') : [];

const districtNameMap: Record<string, string> = {
  '1': 'District 1 (Toys, Plush, Jewelry & Crafts)',
  '2': 'District 2 (Hardware, Tools & Kitchenware)',
  '3': 'District 3 (Stationery, Office & Sports)',
  '4': 'District 4 (Footwear, Socks & Daily Necessities)',
  '5': 'District 5 (Home Textiles, Bedding & Auto Parts)',
  '6': 'Huangyuan Garment Market (Apparel & Jeans)'
};

const districtName = districtNameMap[supplier.district] || `District ${supplier.district || '1'}`;

const supplierName = supplier.clean_name || supplier.name;
const whatsappPrefillMsg = encodeURIComponent(
  `Hi SinoTradeLink, I am reviewing supplier "${supplierName}" (Booth ${supplier.booth_no || 'N/A'}, ${districtName}). Can your on-ground team visit this stall for inspection/pricing?`
);
const whatsappSupplierUrl = `https://wa.me/8613482725985?text=${whatsappPrefillMsg}`;
---

<Layout 
  title={`${supplier.clean_name || supplier.name} - Yiwu Market Booth ${supplier.booth_no || ''} | Sino Trade Link`}
  description={`Direct contact number, WeChat ID, and physical stall coordinates for ${supplier.clean_name || supplier.name} in Yiwu Futian Wholesale Market. Verified offline supplier.`}
  activePage="directory"
>
  <!-- Breadcrumbs & Header -->
  <section class="bg-slate-900 text-white py-8 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-3">
        <a href="/" class="hover:text-white">Home</a>
        <span>/</span>
        <a href="/directory" class="hover:text-white">Directory</a>
        <span>/</span>
        <a href={`/directory?district=${supplier.district}`} class="hover:text-white">{districtName}</a>
        <span>/</span>
        <span class="text-slate-200 truncate">{supplier.clean_name || supplier.name}</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="bg-blue-600/30 text-blue-300 text-xs font-bold px-2.5 py-1 rounded-md border border-blue-500/40">
              {districtName}
            </span>
            {supplier.booth_no && (
              <span class="bg-slate-800 text-slate-200 text-xs font-mono font-bold px-2.5 py-1 rounded-md border border-slate-700">
                Booth {supplier.booth_no}
              </span>
            )}
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white">
            {supplier.clean_name || supplier.name}
          </h1>
          {supplier.company_name && supplier.company_name !== supplier.clean_name && (
            <p class="text-xs sm:text-sm text-slate-400 mt-0.5">
              Official Registered Name: {supplier.company_name}
            </p>
          )}
        </div>

        <!-- Quick Unlock & Ground Liaison Triggers -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a 
            href={whatsappSupplierUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>WhatsApp Ground Desk</span>
          </a>

          <button 
            type="button"
            data-unlock-id={supplier.shop_id}
            data-supplier-name={supplier.clean_name || supplier.name}
            data-contact-person={supplier.contact_person || 'Stall Manager'}
            data-masked-phone={maskedPhone}
            data-district={districtName}
            data-booth={supplier.booth_no}
            class="unlock-contact-btn px-5 py-3 rounded-2xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
            </svg>
            <span>Reveal Mobile & WhatsApp</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Detail Content Section -->
  <section class="py-12 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Info (Left 2 cols) -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Physical Stall Location Card -->
          <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
            <h2 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Physical Market Location & Navigation Coordinates
            </h2>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs mb-4">
              <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                <span class="text-[10px] uppercase font-bold text-slate-400 block">District:</span>
                <span class="font-bold text-slate-800">District {supplier.district}</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                <span class="text-[10px] uppercase font-bold text-slate-400 block">Floor:</span>
                <span class="font-bold text-slate-800">Floor {supplier.floor || '1'}</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                <span class="text-[10px] uppercase font-bold text-slate-400 block">Gate Entrance:</span>
                <span class="font-bold text-slate-800">Gate {supplier.gate || 'Direct'}</span>
              </div>
              <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100">
                <span class="text-[10px] uppercase font-bold text-slate-400 block">Booth Number:</span>
                <span class="font-mono font-bold text-blue-600 text-sm">#{supplier.booth_no || 'Pending'}</span>
              </div>
            </div>

            {supplier.full_location && (
              <div class="text-xs text-slate-600 bg-slate-50 p-3 rounded-xl border border-slate-100">
                <strong class="text-slate-700">Full Stall Address:</strong> {supplier.full_location}
              </div>
            )}
          </div>

          <!-- Product Samples -->
          {sampleProducts.length > 0 && (
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
              <h2 class="text-base font-bold text-slate-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                Wholesale Product Catalog Samples
              </h2>
              <div class="space-y-2">
                {sampleProducts.map(p => (
                  <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs font-medium text-slate-800 flex items-center justify-between">
                    <span>{p}</span>
                    <span class="text-[10px] uppercase font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                      Wholesale Tier
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Category Classification -->
          {supplier.chinese_official_category && (
            <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
              <h3 class="text-xs uppercase font-bold text-slate-400 mb-2">Market Industry Classification:</h3>
              <p class="text-sm font-semibold text-slate-800 font-mono">
                {supplier.chinese_official_category}
              </p>
            </div>
          )}
        </div>

        <!-- Sidebar / Contact Unlock & Inspection Box (Right col) -->
        <div class="space-y-6">
          <!-- Contact Card -->
          <div class="bg-white rounded-3xl border border-blue-200 p-6 shadow-md">
            <span class="text-[10px] uppercase font-bold text-blue-600 tracking-wider block mb-1">
              Verified Direct Contact
            </span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">
              {supplier.contact_person || 'Stall Manager'}
            </h3>

            <div class="space-y-3 mb-6">
              <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200">
                <span class="text-[10px] uppercase font-bold text-slate-400 block">Direct Mobile Line:</span>
                <span class="font-mono text-base font-bold text-slate-600 block mt-0.5">
                  {maskedPhone}
                </span>
              </div>
            </div>

            <button 
              type="button"
              data-unlock-id={supplier.shop_id}
              data-supplier-name={supplier.clean_name || supplier.name}
              data-contact-person={supplier.contact_person || 'Stall Manager'}
              data-masked-phone={maskedPhone}
              data-district={districtName}
              data-booth={supplier.booth_no}
              class="unlock-contact-btn w-full py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Click to Reveal Contact & WeChat</span>
            </button>

            <a
              href={whatsappSupplierUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full mt-2.5 py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-300 font-bold text-xs rounded-xl shadow-sm transition-all flex items-center justify-center gap-2 text-center"
            >
              <svg class="w-4 h-4 text-emerald-600 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              <span>Instant WhatsApp Inquiry</span>
            </a>
          </div>

          <!-- Direct Wholesale RFQ Card -->
          <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-3xl border border-emerald-200 p-6 shadow-sm">
            <span class="text-[10px] uppercase font-bold text-emerald-700 tracking-wider block mb-1">
              Direct Wholesale RFQ
            </span>
            <h3 class="text-base font-bold text-slate-900 mb-2">
              Request MOQ & FOB Price Quote
            </h3>
            <p class="text-xs text-slate-600 mb-4 leading-relaxed">
              Submit volume inquiries directly to Booth {supplier.booth_no || ''}. Our on-site Yiwu liaison team coordinates the quotation directly with the factory.
            </p>
            <button 
              type="button"
              data-unlock-id={supplier.shop_id}
              data-supplier-name={supplier.clean_name || supplier.name}
              data-contact-person={supplier.contact_person || 'Stall Manager'}
              data-masked-phone={maskedPhone}
              data-district={districtName}
              data-booth={supplier.booth_no}
              class="unlock-contact-btn w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl text-center shadow-sm transition-colors cursor-pointer"
            >
              Submit RFQ to Stall &rarr;
            </button>
          </div>

          <!-- On-Demand Stall Audit CTA -->
          <div class="bg-slate-900 text-white rounded-3xl p-6 border border-slate-800">
            <span class="text-[10px] uppercase font-bold text-emerald-400 block mb-1">
              Ground Service in Yiwu
            </span>
            <h3 class="text-base font-bold text-white mb-2">
              Have Us Visit This Stall For You ($99)
            </h3>
            <p class="text-xs text-slate-400 mb-4 leading-relaxed">
              Our bilingual field staff walks to Booth {supplier.booth_no || ''}, inspects their real samples, shoots 4K video, and verifies their wholesale pricing.
            </p>
            <div class="space-y-2">
              <a 
                href={`/concierge?booth=${encodeURIComponent(supplier.booth_no || '')}&name=${encodeURIComponent(supplier.clean_name || supplier.name)}`}
                class="block w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-xl text-center shadow transition-colors"
              >
                Book Stall Audit ($99) &rarr;
              </a>
              <a 
                href={whatsappSupplierUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl text-center border border-slate-700 transition-colors flex items-center justify-center gap-1.5"
              >
                <span>WhatsApp Ground Liaison</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Global Contact Unlock Modal Dialog -->
  <ContactUnlockModal />
</Layout>
