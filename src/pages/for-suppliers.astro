---
import Layout from '../layouts/Layout.astro';
---

<Layout title="List Your Factory or Export Business | SinoTradeLink Global Trade Directory" activePage="suppliers">
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-16 pb-20 border-b border-slate-800 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-bold mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
        <span>Global Supplier & Factory Onboarding</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white max-w-3xl mx-auto leading-tight">
        Showcase Your Factory to <span class="bg-gradient-to-r from-amber-400 via-amber-200 to-blue-400 bg-clip-text text-transparent">International Wholesale Buyers</span>.
      </h1>

      <p class="mt-5 text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Connect directly with verified importers, volume distributors, and procurement managers from the US, Europe, Middle East, and Latin America. Apply for a verified listing on SinoTradeLink.
      </p>

      <!-- Trust Metrics -->
      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto text-center">
        <div class="p-3.5 rounded-xl bg-slate-800/50 border border-slate-800">
          <div class="text-xl sm:text-2xl font-black text-white">50,000+</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Global Buyer Searches</div>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-800/50 border border-slate-800">
          <div class="text-xl sm:text-2xl font-black text-amber-400">0%</div>
          <div class="text-[11px] text-slate-400 mt-0.5">Middleman Markups</div>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-800/50 border border-slate-800">
          <div class="text-xl sm:text-2xl font-black text-emerald-400">Direct</div>
          <div class="text-[11px] text-slate-400 mt-0.5">WhatsApp & RFQ Leads</div>
        </div>
        <div class="p-3.5 rounded-xl bg-slate-800/50 border border-slate-800">
          <div class="text-xl sm:text-2xl font-black text-blue-400">AI-Indexed</div>
          <div class="text-[11px] text-slate-400 mt-0.5">LLM & Search Visibility</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Form Section -->
  <section class="py-16 bg-slate-950 text-slate-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-32 -right-32 w-64 h-64 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="border-b border-slate-800 pb-6 mb-8">
          <h2 class="text-xl sm:text-2xl font-bold text-white">Supplier Verification & Listing Application</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1.5 leading-relaxed">
            Fill in your business credentials. Our international trade team will review your product catalog and contact you within 24 hours on WhatsApp or email to confirm your verified profile.
          </p>
        </div>

        <form id="supplier-application-form" class="space-y-6">
          
          <!-- Company & Business Type -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Company / Factory Name *
              </label>
              <input 
                type="text" 
                name="company_name" 
                required 
                placeholder="e.g. Sterling Exports Ltd / 义乌市XX商行"
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Business Type *
              </label>
              <select 
                name="business_type" 
                required
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-amber-500 transition cursor-pointer"
              >
                <option value="Direct Manufacturer / Factory">Direct Manufacturer / Factory</option>
                <option value="Physical Wholesale Market Stall">Physical Wholesale Market Stall (Yiwu/Guangzhou)</option>
                <option value="Export House / Trading Company">Export House / Trading Company</option>
                <option value="Sourcing Agent / Ground Liaison">Sourcing Agent / Ground Liaison</option>
                <option value="Warehousing & Logistics Provider">Warehousing & Logistics Provider</option>
              </select>
            </div>
          </div>

          <!-- Region / Country & City -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Country / Region of Operation *
              </label>
              <select 
                name="country" 
                required
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-amber-500 transition cursor-pointer"
              >
                <option value="China">China (Yiwu / Zhejiang / Guangdong / Shenzhen)</option>
                <option value="India">India (Surat / Tirupur / Mumbai / Delhi / Other)</option>
                <option value="Vietnam">Vietnam</option>
                <option value="United Arab Emirates">United Arab Emirates (Dubai)</option>
                <option value="Turkey">Turkey</option>
                <option value="Other">Other Global Trade Hub</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                City & Physical Address / Booth No. *
              </label>
              <input 
                type="text" 
                name="city_address" 
                required 
                placeholder="e.g. Yiwu Futian District 2, Booth 10245 or Surat, Gujarat"
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-amber-500 transition"
              />
            </div>
          </div>

          <!-- Product Categories -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
              Primary Product Category *
            </label>
            <select 
              name="category" 
              required
              class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm focus:outline-none focus:border-amber-500 transition cursor-pointer"
            >
              <option value="Toys, Crafts & Festival Goods">Toys, Crafts & Festival Goods</option>
              <option value="Hardware, Tools & Kitchenware">Hardware, Tools & Kitchenware</option>
              <option value="Stationery, Office & Sports Supplies">Stationery, Office & Sports Supplies</option>
              <option value="Footwear, Socks & Daily Necessities">Footwear, Socks & Daily Necessities</option>
              <option value="Home Textiles, Bedding & Fabrics">Home Textiles, Bedding & Fabrics</option>
              <option value="Apparel, Garments & Accessories">Apparel, Garments & Accessories</option>
              <option value="Electronics, Mobile & Small Appliances">Electronics, Mobile & Small Appliances</option>
              <option value="Jewelry, Fashion & Hair Accessories">Jewelry, Fashion & Hair Accessories</option>
              <option value="Production Materials & Packaging">Production Materials & Packaging</option>
              <option value="Other Wholesale Products">Other Wholesale Products</option>
            </select>
          </div>

          <!-- Contact Person & Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Contact Person Name *
              </label>
              <input 
                type="text" 
                name="contact_person" 
                required 
                placeholder="Full Name"
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-amber-500 transition"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Business Email *
              </label>
              <input 
                type="email" 
                name="email" 
                required 
                placeholder="export@yourcompany.com"
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-amber-500 transition"
              />
            </div>
          </div>

          <!-- WhatsApp & WeChat -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                WhatsApp Number (with Country Code) *
              </label>
              <input 
                type="text" 
                name="phone" 
                required 
                placeholder="+91 98765 43210 or +86 138..."
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm font-mono placeholder-slate-500 focus:outline-none focus:border-amber-500 transition"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
                WeChat ID or Website URL (Optional)
              </label>
              <input 
                type="text" 
                name="wechat_or_website" 
                placeholder="WeChat ID or https://..."
                class="w-full px-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-amber-500 transition"
              />
            </div>
          </div>

          <!-- Product Description / Catalog Link -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">
              Product Overview & Key Export Capabilities *
            </label>
            <textarea 
              name="description" 
              rows="4" 
              required
              placeholder="Describe your main products, export markets, monthly capacity, minimum order quantities (MOQ), and certifications..."
              class="w-full px-4 py-3 bg-slate-950 border border-slate-700 rounded-xl text-white text-sm placeholder-slate-500 focus:outline-none focus:border-amber-500 transition resize-none"
            ></textarea>
          </div>

          <!-- Status Message -->
          <div id="form-feedback" class="hidden p-4 rounded-xl text-xs font-medium"></div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            id="submit-btn"
            class="w-full py-3.5 px-6 bg-gradient-to-r from-amber-500 via-amber-600 to-amber-700 hover:from-amber-400 hover:to-amber-600 text-slate-950 font-black text-sm rounded-xl shadow-lg shadow-amber-500/25 transition-all flex items-center justify-center space-x-2 cursor-pointer"
          >
            <span>Submit Supplier Listing Application</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <p class="text-[11px] text-center text-slate-500">
            🔒 Applications are strictly reviewed to prevent spam and safeguard buyer trust.
          </p>

        </form>

      </div>

    </div>
  </section>

  <!-- How It Works Section -->
  <section class="py-16 bg-slate-900 border-t border-slate-800 text-slate-300">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-xl font-bold text-white text-center mb-10">How Verification & Listing Works</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-slate-950 border border-slate-800 p-6 rounded-xl">
          <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 font-bold flex items-center justify-center text-sm mb-4">1</div>
          <h4 class="text-white font-bold text-sm mb-2">Submit Business Details</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Provide your factory location, business license or export credentials, and key product catalogs.
          </p>
        </div>

        <div class="bg-slate-950 border border-slate-800 p-6 rounded-xl">
          <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 font-bold flex items-center justify-center text-sm mb-4">2</div>
          <h4 class="text-white font-bold text-sm mb-2">Ground & Catalog Review</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Our trade desk verifies your physical booth or factory credentials and indexes your products for search and AI discovery.
          </p>
        </div>

        <div class="bg-slate-950 border border-slate-800 p-6 rounded-xl">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 font-bold flex items-center justify-center text-sm mb-4">3</div>
          <h4 class="text-white font-bold text-sm mb-2">Direct Buyer Leads</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            International importers contact you directly via your verified WhatsApp number and RFQ inbox. Zero middleman fees.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  const form = document.getElementById('supplier-application-form');
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Submitting Application...</span>';
      feedback.classList.add('hidden');

      const formData = new FormData(form);
      const company = formData.get('company_name');
      const businessType = formData.get('business_type');
      const country = formData.get('country');
      const cityAddress = formData.get('city_address');
      const category = formData.get('category');
      const contactPerson = formData.get('contact_person');
      const email = formData.get('email');
      const phone = formData.get('phone');
      const wechat = formData.get('wechat_or_website');
      const description = formData.get('description');

      const combinedMessage = `[SUPPLIER APPLICATION]
Company: ${company}
Type: ${businessType}
Location: ${cityAddress}, ${country}
Category: ${category}
Contact: ${contactPerson}
WhatsApp: ${phone}
WeChat/Web: ${wechat || 'None'}

Overview:
${description}`;

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shop_id: 'SUPPLIER_APPLICATION',
            buyer_name: String(contactPerson || company),
            buyer_email: String(email),
            buyer_country: String(country),
            phone: String(phone),
            service_type: 'Supplier Listing Application',
            target_booth: String(cityAddress).slice(0, 50),
            message: combinedMessage
          })
        });

        const data = await res.json();
        if (data.success) {
          feedback.className = 'p-5 rounded-xl bg-emerald-950/60 border border-emerald-800 text-emerald-200 text-xs leading-relaxed';
          feedback.innerHTML = `
            <div class="font-bold text-sm text-emerald-300 mb-1">✅ Application Received!</div>
            <p>Thank you, <strong>${contactPerson}</strong>. Your listing request for <strong>${company}</strong> has been registered (Ref: <code class="font-mono text-amber-300">${data.inquiryId ? data.inquiryId.slice(0, 8) : 'SUBMITTED'}</code>).</p>
            <p class="mt-2">Our trade onboarding desk will reach out to your WhatsApp (<strong class="font-mono">${phone}</strong>) within 24 hours.</p>
          `;
          feedback.classList.remove('hidden');
          form.reset();
        } else {
          feedback.className = 'p-4 rounded-xl bg-rose-950/60 border border-rose-800 text-rose-300 text-xs';
          feedback.innerText = data.error || 'Failed to submit application. Please check fields and try again.';
          feedback.classList.remove('hidden');
        }
      } catch (err) {
        feedback.className = 'p-4 rounded-xl bg-rose-950/60 border border-rose-800 text-rose-300 text-xs';
        feedback.innerText = 'Network error occurred. Please contact us directly on WhatsApp.';
        feedback.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Submit Supplier Listing Application</span><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>';
      }
    });
  }
</script>
